<script>
  $(document).ready(function () {
    if (typeof jQuery !== 'undefined' && typeof $.fn.dropdown !== 'undefined') {
      $(document).off('click.dropdown-fix', '.dropdown-toggle').on('click.dropdown-fix', '.dropdown-toggle', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var $parent = $(this).parent('.dropdown');
        $parent.toggleClass('open');
        $('.dropdown').not($parent).removeClass('open');
        return false;
      });

      $(document).off('click.dropdown-close').on('click.dropdown-close', function (e) {
        if (!$(e.target).closest('.dropdown').length) {
          $('.dropdown').removeClass('open');
        }
      });

      try {
        if (typeof $.fn.dropdown === 'function') {
          $('.dropdown-toggle').dropdown();
        }
      } catch (e) {
        console.log('Bootstrap dropdown function not available, using manual handler');
      }
    } else {
      console.error('jQuery or Bootstrap dropdown plugin not loaded');
    }
  });
</script>
