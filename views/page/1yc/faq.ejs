<div>
  <div class="pjblock text-center">
    <table>
      <tr>
        <td>
          <br><br>
          <table width=90% class="text-center table table-sm">
            <tr>
              <td>
                <div class="text-start">
                  <table width=80% class="text-center table table-sm">
                    <tr>
                      <td>
                        <div id="yc-faq-body">
                          <p class="text-center">Loading FAQ...</p>
                        </div>
                      </td>
                    </tr>
                  </table>
                </div>
                <br><br>
              </td>
            </tr>
