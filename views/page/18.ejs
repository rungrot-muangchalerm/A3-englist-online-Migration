<style>
  .teoc-header {
    background-color: #f7941d;
    color: #ffffff;
    border-radius: 10px;
    padding: 25px;
    margin-bottom: 20px;
  }

  .round-panel {
    border: 2px solid #f7941d;
    border-radius: 10px;
    margin-bottom: 20px;
  }

  .round-panel>.panel-heading {
    background-color: #f7941d;
    color: #ffffff;
    text-align: center;
    border-radius: 8px 8px 0 0;
  }

  .badge-rank-1 {
    background-color: #ffd700 !important;
    color: #000000 !important;
  }

  .badge-rank-2 {
    background-color: #c0c0c0 !important;
    color: #000000 !important;
  }

  .badge-rank-3 {
    background-color: #cd7f32 !important;
    color: #ffffff !important;
  }

  .province-card {
    border: 1px solid #dddddd;
    border-radius: 6px;
    padding: 12px;
    text-align: center;
    margin-bottom: 15px;
    transition: transform 0.2s;
  }

  .province-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  }

  .province-unknown {
    border-color: #f0ad4e;
    background-color: #fcf8e3;
  }

  .province-count {
    font-size: 22px;
    font-weight: bold;
    color: #f7941d;
  }

  .stats-badge {
    background-color: #6c757d;
    color: #ffffff;
    padding: 6px 12px;
    border-radius: 12px;
    font-weight: bold;
  }

  .round-highlight {
    box-shadow: 0 0 0 4px rgba(247, 148, 29, 0.5);
  }
</style>

<div class="container" style="width:1150px !important; margin-top:15px; padding-bottom:20px;">

  <!-- Header -->
  <div class="row">
    <div class="col-xs-12 teoc-header text-center">
      <h2 class="kanit" style="margin-top:0;">
        <i class="fa fa-trophy"></i>
        ผู้ผ่านขั้นกลางของระบบ EOL System (Intermediate) หรือผ่าน 18 อรหันต์
      </h2>
      <p class="lead mb-0" style="margin-bottom:0;">Thailand English Online Contest 2025</p>
    </div>
  </div>

  <!-- App container -->
  <div id="teoc-app" class="kanit">กำลังโหลด...</div>

  <!-- Info box -->
  <div class="alert alert-warning" style="margin-top:20px;">
    <h4><i class="fa fa-info-circle"></i> ข้อมูลและเกณฑ์การแข่งขัน</h4>
    <hr style="border-top-color:#f0ad4e;">
    <ul class="mb-0">
      <li>รายชื่อผู้ผ่านด่านระดับ <strong>Intermediate</strong> (Level 3 ขึ้นไป)</li>
      <li>คะแนนผ่านเกณฑ์: <strong>50%</strong> ขึ้นไป</li>
      <li>แสดงคะแนนสูงสุดของแต่ละบุคคลในแต่ละรอบการแข่งขัน</li>
      <li>เรียงลำดับตามคะแนนจากมากไปน้อย และวันที่สอบจากเร็วไปช้า</li>
      <li>อันดับ 1-3 จะถูกไฮไลท์ด้วยเหรียญทอง เงิน ทองแดง ตามลำดับ</li>
      <li>หากผู้สอบหลายคนได้คะแนนเท่ากัน จะนับเป็น<strong>อันดับร่วม</strong> และแสดงเครื่องหมาย <strong>*</strong></li>
      <li>ตรวจสอบจังหวัดจาก 77 จังหวัดทั่วประเทศ หากไม่พบจะแสดงเป็น <strong>"ไม่ทราบจังหวัด"</strong></li>
      <li>มีตารางสรุปจำนวนผู้ผ่านด่าน<strong>แยกตามจังหวัด</strong>และ<strong>สรุปจำนวนผู้ผ่านทั้งหมด</strong>แสดงไว้ด้านบนของแต่ละรอบ</li>
      <li>มี<strong>ช่องค้นหา</strong>สำหรับค้นหาชื่อ-นามสกุล หรือ รหัสสมาชิกของตัวเอง</li>
    </ul>
  </div>

</div>

<template id="teoc-round-template">
  <div class="panel panel-warning round-panel" id="">
    <div class="panel-heading">
      <h3 class="panel-title" style="margin:0;">
        <i class="round-icon fa"></i> <span class="round-name"></span>
      </h3>
      <small class="round-subtitle"></small>
    </div>
    <div class="panel-body round-body"></div>
  </div>
</template>

<template id="teoc-empty-template">
  <div class="alert alert-secondary text-center" style="padding:30px;">
    <i class="fa fa-inbox fa-4x" style="opacity:0.5;"></i>
    <h5>ยังไม่มีผู้ผ่านด่านในรอบนี้</h5>
    <p class="mb-0">รอติดตามผลการแข่งขันในรอบนี้</p>
  </div>
</template>

<template id="teoc-content-template">
  <div class="text-center mb-4">
    <span class="badge" style="background-color:#337ab7; font-size:18px; padding:10px 16px;">
      <i class="fa fa-users"></i>
      ผู้ผ่านด่านทั้งหมด: <strong style="font-size:24px;" class="round-total"></strong> คน
    </span>
  </div>

  <div class="panel panel-default" style="border-color:#f0ad4e;">
    <div class="panel-body">
      <form method="GET" action="/18" class="round-search-form">
        <div class="row">
          <div class="col-md-8 col-md-offset-2">
            <div class="input-group input-group-lg">
              <span class="input-group-addon" style="background-color:#337ab7; color:#ffffff;">
                <i class="fa fa-search"></i>
              </span>
              <input type="text" name="search" class="form-control search-input" placeholder="ค้นหาชื่อ-นามสกุล หรือ รหัสสมาชิก..." value="">
              <input type="hidden" name="round" class="round-index-input" value="">
              <span class="input-group-btn">
                <button class="btn btn-primary" type="submit">
                  <i class="fa fa-search"></i> ค้นหา
                </button>
                <span class="clear-button-container"></span>
              </span>
            </div>
            <div class="mt-2 text-center text-muted" style="margin-top:8px;">
              <small><i class="fa fa-info-circle"></i> พิมพ์แล้วกด Enter หรือกดปุ่ม "ค้นหา" เพื่อค้นหาในรอบนี้</small>
            </div>
            <div class="search-alert-container"></div>
          </div>
        </div>
      </form>
    </div>
  </div>

  <div class="province-summary-container">
    <h5 class="text-center fw-bold mb-3 province-summary-title" style="display:none;">
      <i class="fa fa-bar-chart"></i> สรุปจำนวนผู้ผ่านด่านแยกตามจังหวัด
    </h5>
    <div class="row province-summary-row" style="display:none;"></div>
  </div>

  <h5 class="text-center fw-bold mb-3 mt-4">
    <i class="fa fa-list-ul"></i> รายชื่อผู้ผ่านด่านทั้งหมด
  </h5>
  <div class="table-responsive">
    <table class="table table-striped table-hover table-bordered round-results-table">
      <thead class="thead-inverse">
        <tr class="text-center">
          <th style="width:10%;">อันดับ</th>
          <th style="width:15%;">รหัสสมาชิก</th>
          <th style="width:25%;">ชื่อ-นามสกุล</th>
          <th style="width:15%;">จังหวัด</th>
          <th style="width:15%;">คะแนน</th>
          <th style="width:20%;">วันที่สอบ</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
    <p class="text-muted mt-2 tie-note" style="font-size:12px; display:none;">
      <i class="fa fa-info-circle"></i> * หมายถึง อันดับร่วม (คะแนนเท่ากัน)
    </p>
  </div>

  <div class="text-end" style="margin-top:15px; text-align:right;">
    <span class="stats-badge">
      <i class="fa fa-users"></i>
      จำนวนผู้ผ่านด่าน: <span class="round-total-bottom"></span> คน
    </span>
  </div>
</template>

<template id="teoc-province-card-template">
  <div class="col-md-3 col-sm-6">
    <div class="province-card">
      <h6 class="province-title" style="margin-top:0;">
        <i class="fa province-icon"></i> <span class="province-name"></span>
      </h6>
      <p style="margin-bottom:0;">
        <span class="province-count-value"></span> <small>คน</small>
      </p>
    </div>
  </div>
</template>

<template id="teoc-result-row-template">
  <tr>
    <td class="text-center align-middle">
      <span class="badge rank-badge" style="font-size:14px; padding:8px; border-radius:50%;"></span>
    </td>
    <td class="text-center align-middle">
      <span class="badge member-id-badge" style="background-color:#5bc0de; color:#000000;"></span>
    </td>
    <td class="align-middle"><strong class="member-name"></strong></td>
    <td class="text-center align-middle">
      <i class="fa fa-map-marker text-danger"></i> <span class="member-province"></span>
    </td>
    <td class="text-center align-middle">
      <span class="badge score-badge" style="background-color:#5cb85c; font-size:14px;"></span>
    </td>
    <td class="text-center align-middle text-muted">
      <i class="fa fa-calendar"></i> <span class="exam-date"></span>
    </td>
  </tr>
</template>

<template id="teoc-search-alert-success-template">
  <div class="alert alert-success mt-3" style="margin-bottom:0;">
    <h5 style="margin-top:0;">
      <i class="fa fa-check-circle"></i> พบผลการค้นหา:
      <strong style="font-size:24px;" class="found-count"></strong> คน
    </h5>
    <small>คำค้นหา: "<strong class="search-term"></strong>" (จากทั้งหมด <span class="total-count"></span> คน)</small>
  </div>
</template>

<template id="teoc-search-alert-warning-template">
  <div class="alert alert-warning mt-3" style="margin-bottom:0;">
    <h5 style="margin-top:0;">
      <i class="fa fa-exclamation-triangle"></i> ไม่พบผลการค้นหา
    </h5>
    <small>ไม่พบข้อมูลที่ตรงกับ "<strong class="search-term"></strong>" ในรอบนี้</small>
  </div>
</template>

<template id="teoc-clear-button-template">
  <a href="/18" class="btn btn-default"><i class="fa fa-times"></i> ล้าง</a>
</template>