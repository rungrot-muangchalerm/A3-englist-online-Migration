<div id="view-e-test" class="eol-view">
  <div id="etest-app">
    <template id="etest-list-template">
      <div class="etest-toolbar">
        <a href="#" class="etest-action" data-action="view_lesson"><button class="etest-btn etest-btn-lesson">o บทเรียนทั้งหมด</button></a>
        <a href="#" class="etest-action" data-action="create_lesson"><button class="etest-btn etest-btn-lesson">+ สร้างบทเรียนแบบกำหนดเอง</button></a>
        <a href="#" class="etest-action etest-action-right" data-action="create_customize"><button class="etest-btn">+ สร้างชุดข้อสอบแบบกำหนดเอง</button></a>
        <a href="#" class="etest-action etest-action-right" data-action="create"><button class="etest-btn">+ สร้างชุดข้อสอบจากระบบ</button></a>
      </div>
      <div>
        <div>
          <table class="etest-table table table-sm" width="100%">
            <thead>
              <tr>
                <th>รายละเอียดชุดข้อสอบ</th>
                <th>ดูชุดข้อสอบ</th>
                <th>จำนวนข้อ</th>
                <th>เวลาสอบ</th>
                <th>สถานะ</th>
              </tr>
            </thead>
            <tbody class="etest-list-body"></tbody>
          </table>
        </div>
        <div id="etest-detail-panel"></div>
      </div>
    </template>

    <template id="etest-row-template">
      <tr class="etest-row">
        <td><a href="#" class="etest-select"></a></td>
        <td><a href="#" class="etest-view">View</a></td>
        <td class="etest-amount"></td>
        <td class="etest-time"></td>
        <td class="etest-active"></td>
      </tr>
    </template>

    <template id="etest-detail-template">
      <div class="etest-detail-box">
        <form class="etest-detail-form" onsubmit="event.preventDefault();">
          <input type="hidden" name="exam_id" class="etest-exam-id">
          <table class="detailform table table-sm">
            <tr>
              <td>ชุดข้อสอบ</td>
              <td><input type="text" name="exam_name" class="etest-exam-name txtdetail"></td>
            </tr>
            <tr>
              <td>วันที่</td>
              <td class="etest-create-date"></td>
            </tr>
            <tr>
              <td>จำนวนข้อ</td>
              <td class="etest-amount"></td>
            </tr>
            <tr>
              <td>เวลาสอบ</td>
              <td><input type="text" name="testtime" class="etest-testtime txtdetail" maxlength="3"> นาที</td>
            </tr>
            <tr>
              <td>รูปแบบการทดสอบ</td>
              <td>
                <label><input type="radio" name="test_type" value="1"> สอบเก็บคะแนน</label><br>
                <label><input type="radio" name="test_type" value="2"> การแข่งขัน</label>
              </td>
            </tr>
            <tr>
              <td>เปิดใช้งาน</td>
              <td><input type="checkbox" name="active" value="1" class="etest-active-check"></td>
            </tr>
          </table>
          <div>เลือกกลุ่มที่สอบ</div>
          <div class="etest-groups"></div>
          <button type="button" class="etest-save-btn bnt-etest">บันทึก</button>
          <button type="button" class="etest-edit-btn bnt-etest">แก้ไขข้อสอบ</button>
          <button type="button" class="etest-delete-btn bnt-delete">ลบชุดข้อสอบ</button>
          <div class="etest-message"></div>
        </form>
      </div>
    </template>

    <template id="etest-group-checkbox-template">
      <label>
        <input type="checkbox" name="allowgroup[]" class="etest-group-check" value="">
        <span></span>
      </label>
    </template>

    <template id="etest-create-custom-template">
      <div class="etest-create-box">
        <a href="#" class="etest-back">[ Back ]</a>
        <h3>สร้างชุดข้อสอบแบบกำหนดเอง</h3>
        <p>ห้ามละเมิดลิขสิทธิ์ผู้อื่น มีความผิดตามกฎหมายและบริษัท อิงลิชออนไลน์ จำกัด จะไม่รับผิดชอบการกระทำใดๆทั้งสิ้น<br>และสงวนสิทธิ์ในการตรวจสอบพร้อมทั้งแก้ไขชุดข้อสอบแบบกำหนดเองโดยไม่ต้องแจ้งให้ทราบล่วงหน้า</p>
        <p>เลือกข้อสอบอย่างน้อย 10 ข้อขึ้นไปและสูงสุดไม่เกิน 30 ข้อ</p>
        <form class="etest-create-custom-form" onsubmit="event.preventDefault();">
          <table class="tbl_create_custom table table-sm">
            <tr>
              <td>ชุดข้อสอบ</td>
              <td><input type="text" name="exam_name" class="txtdetail" required></td>
            </tr>
            <tr>
              <td colspan="2" class="etest-question-area">
                <div>ข้อ <span class="etest-q-no">1</span></div>
                <textarea name="question" rows="4" required></textarea>
                <div class="etest-choices">
                  <div><label><input type="radio" name="correct" value="0" required> A</label> <textarea name="choice[]" rows="2" required></textarea></div>
                  <div><label><input type="radio" name="correct" value="1"> B</label> <textarea name="choice[]" rows="2" required></textarea></div>
                  <div><label><input type="radio" name="correct" value="2"> C</label> <textarea name="choice[]" rows="2" required></textarea></div>
                  <div><label><input type="radio" name="correct" value="3"> D</label> <textarea name="choice[]" rows="2" required></textarea></div>
                </div>
                <button type="button" class="etest-add-question-btn bnt-etest">บันทึกข้อนี้</button>
                <div class="etest-message"></div>
              </td>
            </tr>
            <tr>
              <td colspan="2">
                <button type="button" class="etest-finish-custom-btn bnt-etest" disabled>สิ้นสุดการสร้างชุดข้อสอบ</button>
              </td>
            </tr>
          </table>
        </form>
      </div>
    </template>

    <template id="etest-create-system-template">
      <div class="etest-create-box">
        <a href="#" class="etest-back">[ Back ]</a>
        <h3>สร้างชุดข้อสอบจากระบบ</h3>
        <p>เลือกข้อสอบอย่างน้อย 10 ข้อขึ้นไปและสูงสุดไม่เกิน 30 ข้อ</p>
        <form class="etest-create-system-form" onsubmit="event.preventDefault();">
          <table>
            <tr>
              <td>ชื่อชุดข้อสอบ</td>
              <td><input type="text" name="exam_name" class="txtdetail" required></td>
            </tr>
            <tr>
              <td>เวลาสอบ</td>
              <td><input type="text" name="testtime" class="txtdetail" maxlength="3" required> นาที</td>
            </tr>
          </table>
          <table class="etest-system-rows table table-sm" width="100%">
            <thead>
              <tr>
                <th>Skill</th>
                <th>Level</th>
                <th>Topic</th>
                <th>จำนวน</th>
                <th></th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
          <button type="button" class="etest-add-row-btn bnt-etest">+ เพิ่มแถว</button>
          <button type="button" class="etest-create-system-submit bnt-etest">สร้างชุดข้อสอบ</button>
          <div class="etest-message"></div>
        </form>
      </div>
    </template>

    <template id="etest-system-row-template">
      <tr>
        <td>
          <select name="skill_id[]" class="etest-skill-select selector">
            <option value="1">Reading Comprehension</option>
            <option value="2">Listening Comprehension</option>
            <option value="3">Semi - Speaking</option>
            <option value="4">Semi - Writing</option>
            <option value="7">Vocabulary</option>
            <option value="5">Grammar</option>
          </select>
        </td>
        <td>
          <select name="level[]" class="etest-level-select selector">
            <option value="1">Beginner</option>
            <option value="2">Lower Intermediate</option>
            <option value="3">Intermediate</option>
            <option value="4">Upper Intermediate</option>
            <option value="5">Advanced</option>
          </select>
        </td>
        <td><select name="topic[]" class="etest-topic-select selector"></select></td>
        <td><input type="text" name="num[]" class="txtdetail" maxlength="2" required></td>
        <td><button type="button" class="etest-remove-row-btn bnt-delete">ลบ</button></td>
      </tr>
    </template>

    <template id="etest-lesson-placeholder-template">
      <div>
        <p>บทเรียนยังไม่เปิดใช้งานใน Phase นี้</p>
        <a href="#" class="etest-back">[ Back ]</a>
      </div>
    </template>

    <div id="etest-content"></div>
  </div>
</div>