<div id="view-refill" class="eol-view d-none">
  <section class="bg-body-tertiary border rounded-3 shadow-sm p-3 p-lg-4 mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
      <div>
        <p class="text-danger fw-semibold mb-1">Welcome To EOL System Program</p>
        <h1 class="h3 fw-bold mb-0">Refill Form</h1>
      </div>
      <div class="d-flex flex-wrap gap-2 align-items-start">
        <a href="/info/refill_card" target="_blank" class="btn btn-outline-secondary"><i class="bi bi-question-circle"></i> วิธีการ refill</a>
        <a href="/shop/product-personal" target="_blank" class="btn btn-danger"><i class="bi bi-credit-card"></i> สั่งซื้อ Refill Card</a>
      </div>
    </div>

    <div id="refillMsg" class="alert alert-info d-none"></div>

    <form id="refillForm" onsubmit="event.preventDefault();">
      <input type="hidden" name="verifyToken" id="refill-verify-token" value="">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label fw-semibold">Code</label>
          <input type="text" class="form-control" name="code" placeholder="Please Enter Your Code" required>
        </div>
        <div class="col-md-6">
          <label class="form-label fw-semibold">PIN</label>
          <input type="text" class="form-control" name="pin" placeholder="Please Enter Your Pin" required>
        </div>
        <div class="col-md-6">
          <label class="form-label fw-semibold">Verify Code</label>
          <div class="input-group">
            <span id="refill-challenge-label" class="input-group-text"></span>
            <input type="text" class="form-control" name="verifly" maxlength="2" required placeholder="Result">
          </div>
        </div>
        <div class="col-md-6 d-flex align-items-end">
          <button type="button" class="btn btn-danger w-100" id="refill-account-btn"><i class="bi bi-arrow-clockwise"></i> Refill Account</button>
        </div>
      </div>
    </form>
  </section>

  <section class="bg-body-tertiary border rounded-3 shadow-sm p-3 p-lg-4">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
      <h2 class="h4 fw-bold mb-0">Refill History</h2>
      <button type="button" class="btn btn-outline-light" id="refill-history-show-btn"><i class="bi bi-clock-history"></i> Refill History</button>
    </div>
    <div id="refill_history" class="d-none"></div>
  </section>

  <template id="refill-history-table-template">
    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle">
        <tbody data-role="body"></tbody>
        <tr>
          <td colspan="4" class="text-center">
            <a href="#" class="btn btn-sm btn-outline-secondary refill-history-hide">Hide</a>
          </td>
        </tr>
      </table>
    </div>
  </template>

  <template id="refill-history-personal-header-template">
    <tr class="table-dark">
      <th>Refill Date</th>
      <th colspan="3">EOL Refill Card List</th>
    </tr>
  </template>

  <template id="refill-history-empty4-template">
    <tr>
      <td colspan="4" class="text-center text-danger">Didn't find any Refill History</td>
    </tr>
  </template>

  <template id="refill-history-card-row-template">
    <tr>
      <td class="text-warning" data-role="date"></td>
      <td colspan="3" class="text-primary" data-role="label"></td>
    </tr>
  </template>

  <template id="refill-history-main-header-template">
    <tr class="table-dark">
      <th>Refill Date</th>
      <th>Refill List</th>
    </tr>
  </template>

  <template id="refill-history-main-header-personal-template">
    <tr class="table-dark">
      <th rowspan="2">Refill Date</th>
      <th rowspan="2">Refill List</th>
      <th colspan="2" class="text-center">Available Time</th>
    </tr>
  </template>

  <template id="refill-history-main-subheader-template">
    <tr class="table-dark">
      <th class="text-success">From</th>
      <th class="text-danger">Until</th>
    </tr>
  </template>

  <template id="refill-history-main-row-corporate-template">
    <tr>
      <td class="text-warning" data-role="date"></td>
      <td class="text-primary" data-role="label"></td>
    </tr>
  </template>

  <template id="refill-history-main-row-personal-template">
    <tr>
      <td class="text-warning" data-role="date"></td>
      <td class="text-primary" data-role="label"></td>
      <td class="text-success" data-role="start"></td>
      <td class="text-danger" data-role="stop"></td>
    </tr>
  </template>

  <template id="refill-history-empty2-template">
    <tr>
      <td colspan="2" class="text-center text-danger">Didn't find any Refill History</td>
    </tr>
  </template>
</div>
