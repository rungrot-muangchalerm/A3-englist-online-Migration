<div id="view-refill" class="eol-view">
  <div class='welcome'>
    <p>Welcome To EOL System Program</p>
  </div>
  <br><br>
  <div class="text-center">
    <h1>Refill Form</h1>
  </div>

  <div id='refillMsg' class="text-center"></div>

  <form id='refillForm' onsubmit='event.preventDefault();'>
    <input type='hidden' name='verifyToken' id='refill-verify-token' value=''>
    <table id='refill_form' width=45% class="text-center table table-sm">
      <tr height=5 class="align-middle">
        <td colspan=2 class="text-start">
          <a href='/info/refill_card' target='_blank'>วิธีการ refill</a>
          <hr>
        </td>
        <td class="text-end">
          <a href='/shop/product-personal' target='_blank'>สั่งซื้อ Refill Card</a>
          <hr>
        </td>
      </tr>
      <tr height=15 class="align-middle">
        <td colspan=3></td>
      </tr>
      <tr>
        <td width=35%% class="text-center">
          <span class="text-dark"><b>Code</b></span>
        </td>
        <td width=5%% class="text-center">
          <span class="text-dark"><b>&nbsp;:&nbsp;</b></span>
        </td>
        <td width=60%% class="text-start"><input type=text size=22 name=code placeholder='Please Enter Your Code' required></td>
      </tr>
      <tr height=10 class="align-middle">
        <td colspan=3></td>
      </tr>
      <tr>
        <td class="text-center">
          <span class="text-dark"><b>PIN</b></span>
        </td>
        <td class="text-center">
          <span class="text-dark"><b>&nbsp;:&nbsp;</b></span>
        </td>
        <td class="text-start"><input type=text size=22 name=pin placeholder='Please Enter Your Pin' required></td>
      </tr>
      <tr height=15 class="align-middle">
        <td colspan=3></td>
      </tr>
      <tr>
        <td class="text-center">
          <span class="text-dark"><b>Verify Code</b></span>
        </td>
        <td class="text-center">
          <span class="text-dark"><b>&nbsp;:&nbsp;</b></span>
        </td>
        <td class="text-start">
          <span class="text-dark"><b>
              <span id='refill-challenge-label'></span>
              <input type=text size=7 name=verifly maxlength=2 required placeholder='Result'>
            </b></span>
        </td>
      </tr>
      <tr height=20 class="align-middle">
        <td colspan=3></td>
      </tr>
      <tr>
        <td class="text-center"></td>
        <td class="text-center"></td>
        <td class="text-start"><button type='button' class='refill_account' id='refill-account-btn'>&nbsp; Refill Account &nbsp;</button></td>
      </tr>
      <tr height=20 class="align-middle">
        <td colspan=3></td>
      </tr>
      <tr height=0 class="align-middle">
        <td colspan=3 class="text-center">
          <hr>
        </td>
      </tr>
    </table>
  </form>

  <table id='refill_history_header_a' width=45% class="text-center table table-sm">
    <tr height=10 class="align-middle">
      <td><input type='button' value='Refill History' class='refill_history' id='refill-history-show-btn'></td>
    </tr>
  </table>

  <div id='refill_history'></div>

  <template id="refill-history-table-template">
    <table width=70% class="text-center bg-secondary text-white table table-sm">
      <tbody data-role="body"></tbody>
      <tr height=15 class="text-center align-middle">
        <td><a href='#' class='button button-gray refill-history-hide'>Hide</a></td>
      </tr>
    </table>
  </template>

  <template id="refill-history-personal-header-template">
    <tr height=25 class="align-middle">
      <td class="text-center">
        <span class="text-dark"><b>Refill Date</b></span>
      </td>
      <td colspan=3 class="text-center">
        <span class="text-dark"><b>EOL Refill Card List</b></span>
      </td>
    </tr>
  </template>

  <template id="refill-history-empty4-template">
    <tr height=50 class="bg-light align-middle">
      <td colspan=4 class="text-center">
        <span class="text-danger">Didn't find any Refill History</span>
      </td>
    </tr>
  </template>

  <template id="refill-history-card-row-template">
    <tr height=25 class="bg-light align-middle">
      <td class="text-center">
        <span class="text-warning"></span>
      </td>
      <td colspan=3 class="text-start">
        <span class="text-primary">&nbsp; <span data-role="label"></span></span>
      </td>
    </tr>
  </template>

  <template id="refill-history-main-header-template">
    <tr height=5 class="align-middle">
      <td width=20% rowspan=2 class="text-center">
        <span class="text-dark"><b>Refill Date</b></span>
      </td>
      <td width=40% rowspan=2 class="text-center">
        <span class="text-dark"><b>Refill List</b></span>
      </td>
    </tr>
  </template>

  <template id="refill-history-main-header-personal-template">
    <tr height=5 class="align-middle">
      <td width=20% rowspan=2 class="text-center">
        <span class="text-dark"><b>Refill Date</b></span>
      </td>
      <td width=40% rowspan=2 class="text-center">
        <span class="text-dark"><b>Refill List</b></span>
      </td>
      <td width=40% colspan=2 class="text-center">
        <span class="text-dark"><b>Available Time</b></span>
      </td>
    </tr>
  </template>

  <template id="refill-history-main-subheader-template">
    <tr height=25 class="align-middle">
      <td width=20% class="text-center">
        <span class="text-success"><b>From</b></span>
      </td>
      <td width=20% class="text-center">
        <span class="text-danger"><b>Until</b></span>
      </td>
    </tr>
  </template>

  <template id="refill-history-main-row-corporate-template">
    <tr height=15 class="bg-light align-middle">
      <td class="text-center">
        <span class="text-warning"></span>
      </td>
      <td class="text-start">
        <span class="text-primary">&nbsp; <span data-role="label"></span></span>
      </td>
    </tr>
  </template>

  <template id="refill-history-main-row-personal-template">
    <tr height=15 class="bg-light align-middle">
      <td class="text-center">
        <span class="text-warning"></span>
      </td>
      <td class="text-start">
        <span class="text-primary">&nbsp; <span data-role="label"></span></span>
      </td>
      <td class="text-center">
        <span class="text-success"></span>
      </td>
      <td class="text-center">
        <span class="text-danger"></span>
      </td>
    </tr>
  </template>

  <template id="refill-history-empty2-template">
    <tr height=35 class="bg-light align-middle">
      <td colspan=2 class="text-center">
        <span class="text-danger">Didn't find any Refill History</span>
      </td>
    </tr>
  </template>

  <br>&nbsp;
</div>