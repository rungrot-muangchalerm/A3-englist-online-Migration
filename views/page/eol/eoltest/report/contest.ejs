<div id="view-report-contest" class="eol-view">
    <div id="report-app">
        <div id="report-focus-bar" class="report-focus-bar">
            <template id="report-focus-bar-template">
                <table align="center" width="90%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f0f0f0" style="border-radius:5px">
                    <tr height="30">
                        <td align="right" width="15%">
                            <font size="2" face="tahoma" color="brown"><b>Focus On &nbsp; : &nbsp; </b></font>
                        </td>
                        <td align="left" width="85%">
                            <font size="2" face="tahoma" color="brown"><b class="focus-name"></b></font>
                        </td>
                    </tr>
                </table><br>
                <div class="report-section-back-wrap">
                    <a class="back-link" href="/eol/eoltest/report<%= memberIdQuery %>">
                        <font size="2" face="tahoma" color="blue"><b>&laquo; Back to Report Menu</b></font>
                    </a>
                </div>
            </template>
        </div>

        <div id="report-contest-layout" class="report-section">
            <map name="MapContest" id="MapContest">
                <area shape="rect" coords="720,292,979,379" class="back-area" href="/eol/eoltest/report<%= memberIdQuery %>" target="_self" />
            </map>
            <img src="/assets/images/image2/eol system/Report/report-contest.png" width="100%" usemap="#MapContest" style="border-radius:15px;">
            <table align="center" width="60%" bgcolor="#f0f0f0" cellpadding="0" cellspacing="0" border="0" style="border-radius:15px;">
                <tr height="50" valign="middle">
                    <td align="right" width="13%">
                        <font size="2" face="tahoma" color="black"><b>From &nbsp; : &nbsp;</b></font>
                    </td>
                    <td align="left" width="27%">&nbsp;<input id="popup_container_contest_a" type="text" value="" size="16" style="height:22px;border-radius:8px;border:1px solid #bbb2ae"></td>
                    <td align="right" width="13%">
                        <font size="2" face="tahoma" color="black"><b>Until &nbsp; : &nbsp;</b></font>
                    </td>
                    <td align="left" width="27%">&nbsp;<input id="popup_container_contest_b" type="text" value="" size="16" style="height:22px;border-radius:8px;border:1px solid #bbb2ae"></td>
                    <td align="left" width="15%"><button type="button" class="btn-view btn-view-contest">&nbsp; View &nbsp;</button></td>
                </tr>
                <tr height="25">
                    <td align="center" colspan="5">
                        <font size="2" face="tahoma" color="red"><b>Format Date : Ex. 2010-12-31 </b></font>
                    </td>
                </tr>
            </table>
            <br><br>
            <div id="contest-items-wrap">
                <template id="report-contest-empty-template">
                    <table width="80%" align="center" cellpadding="5" cellspacing="0" border="0" style="background:#f0f0f0; border-radius:10px;">
                        <tr height="50">
                            <td align="center">
                                <font size="2" face="tahoma" color="red"><b> - Didn't find any result - </b></font>
                            </td>
                        </tr>
                    </table><br><br>&nbsp;
                </template>
                <template id="report-contest-table-template">
                    <table align="center" width="100%" cellpadding="0" cellspacing="0" border="0" class="tb-list-score-contest">
                        <tr bgcolor="#f0f0f0"></tr>
                    </table>
                </template>
                <template id="report-contest-row-template">
                    <tr style="height:50px;">
                        <td align="center"></td>
                        <td style="min-width:100px;text-align:center;">
                            <a class="contest-link" target="_blank" href="#" style="font-size:14px;" title=""></a>
                        </td>
                        <td style="min-width:100px;text-align:center;font-size:14px;">คะแนนที่ได้ : <br><b class="contest-percent"></b></td>
                        <td style="width:70%;"><img src="/assets/2010/temp_images/icon_bar/bar_01.png" style="border-radius:5px; width:0%" height="25" class="contest-bar" title=""></td>
                    </tr>
                </template>
            </div>
        </div>

        <div id="report-contest-detail" class="report-section" style="display:none;">
            <div id="contest-detail-header">
                <template id="report-detail-header-template">
                    <table align="center" width="90%" cellpadding="5" cellspacing="0" border="0" bgcolor="#fff" style="border-radius:10px">
                        <tr height="25">
                            <td width="11%" rowspan="4" bgcolor="#e7e7e7" align="center"><img class="detail-avatar" src="" height="" onerror="this.onerror=null;this.src='/assets/2010/member_images/icon_user_01.jpg'"></td>
                            <td width="22%" align="right">
                                <font size="2" face="tahoma" color="black"><b>ผู้ทำแบบทดสอบ &nbsp; : &nbsp; </b></font>
                            </td>
                            <td width="50%" align="left">
                                <font size="2" face="tahoma" color="black"><b>&nbsp; <span class="detail-fname"></span> &nbsp; &nbsp; <span class="detail-lname"></span> </b></font>
                            </td>
                            <td width="17%" rowspan="4"></td>
                        </tr>
                        <tr height="25">
                            <td align="right">
                                <font size="2" face="tahoma" color="black"><b>วันที่ทำการทดสอบ &nbsp; : &nbsp; </b></font>
                            </td>
                            <td align="left">
                                <font size="2" face="tahoma" color="black"><b>&nbsp; <span class="detail-date"></span> </b></font>
                            </td>
                        </tr>
                        <tr height="25">
                            <td align="right">
                                <font size="2" face="tahoma" color="black"><b>ประเภทการทดสอบ &nbsp; : &nbsp; </b></font>
                            </td>
                            <td align="left">
                                <font size="2" face="tahoma" color="black"><b> <span class="detail-section"></span> </b></font>
                            </td>
                        </tr>
                        <tr height="25">
                            <td align="right">
                                <font size="2" face="tahoma" color="black"><b>คะแนนที่ได้ &nbsp; : &nbsp; </b></font>
                            </td>
                            <td align="left">
                                <font size="2" face="tahoma" color="black"><b>&nbsp; <span class="detail-amount"></span> / <span class="detail-total"></span> &nbsp; คะแนน &nbsp;&nbsp;&nbsp; คิดเป็น &nbsp; <span class="detail-percent"></span> %</b></font>
                            </td>
                        </tr>
                    </table><br>
                </template>

                <template id="report-type-tabs-template">
                    <table align="center" width="90%" cellpadding="2" cellspacing="0" border="0">
                        <tr height="30">
                            <td width="15%" align="center"><a class="tab-link-1" href="#"><img src="/assets/images/icon/summary-01.png" border="0"></a></td>
                            <td width="15%" align="center"><a class="tab-link-2" href="#"><img src="/assets/images/icon/check your answer-01.png" border="0"></a></td>
                            <td width="15%" align="center"><a class="tab-link-3" href="#"><img src="/assets/images/icon/ranking-01.png" border="0"></a></td>
                            <td width="70%" align="left" colspan="2">&nbsp;</td>
                        </tr>
                    </table><br>
                </template>
            </div>

            <div id="contest-detail-content">
                <template id="report-contest-custom-question-template">
                    <table width="90%" align="center" border="0" cellpadding="0" cellspacing="0" bgcolor="#DBDBDB" style="border-radius:10px;padding:10px;">
                        <tr valign="top" height="25">
                            <td width="2%" align="center">
                                <font size="2" face="Verdana"><b class="q-no"></b></font>
                            </td>
                            <td width="98%">
                                <font size="2" face="Verdana" class="q-text"></font>
                            </td>
                        </tr>
                        <tbody class="answers-body"></tbody>
                        <tr height="15"></tr>
                        <tr>
                            <td width="2%"></td>
                            <td width="98%" class="msg-cell"></td>
                        </tr>
                        <tr height="10"></tr>
                        <tr>
                            <td class="icon-cell"></td>
                        </tr>
                    </table><br>
                </template>
                <template id="report-contest-answer-template">
                    <tr>
                        <td width="2%"></td>
                        <td width="98%">
                            <table align="center" width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td width="75%"><input type="radio" class="answer-radio"> <span class="answer-text"></span></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </template>
                <template id="report-contest-msg-template">
                    <font size="2" color="" class="msg-text"></font>
                </template>
                <template id="report-contest-icon-template">
                    <img src="" border="0" style="border-radius:10px;margin-left:35px;">
                </template>

                <template id="report-test-question-template">
                    <table width="90%" align="center" border="0" cellpadding="0" cellspacing="0" bgcolor="#DBDBDB" style="border-radius: 10px;">
                        <tr height="10">
                            <td rowspan="6">&nbsp;&nbsp;</td>
                            <td colspan="2"></td>
                            <td rowspan="5">&nbsp;&nbsp;</td>
                        </tr>
                        <tr class="relate-row" style="display:none;">
                            <td width="100%" colspan="2" align="left" class="relate-cell"></td>
                        </tr>
                        <tr valign="top" height="25">
                            <td width="5%" rowspan="3" align="center">
                                <font size="2" face="Verdana"><b class="q-no"></b></font>
                            </td>
                            <td width="95%">
                                <font size="2" face="Verdana" class="q-text"></font>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <table align="center" width="100%" cellpadding="0" cellspacing="0" border="0">
                                    <tr>
                                        <td width="75%">
                                            <font size="2" face="Verdana">
                                                <div class="answers"></div>
                                                <br><b>
                                                    <font color="blue" size="2" class="msg-a"></font>&nbsp;<span class="msg-b"></span>
                                                </b>
                                            </font>
                                        </td>
                                        <td width="25%" align="center" class="icon-cell"></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td align="left">
                                <table align="center" width="100%" cellspacing="0" cellpadding="0" border="0">
                                    <tr>
                                        <td align="left" width="80%">
                                            <font face="Verdana" color="brown" size="2"><b>Tip : <span class="reason-name"></span></font></b>
                                        </td>
                                        <td align="center" width="20%">
                                            <a class="lesson-link" target="_blank" href="#">
                                                <b>
                                                    <font face="verdana" color="green" size="2">&raquo; Go to Lessons &laquo;</font>
                                                </b>
                                            </a>
                                        </td>
                                    </tr>
                                    <tr class="description-row" style="display:none;">
                                        <td align="left" width="80%">
                                            <font face="Verdana" color="#e400e0" size="2"><b>Description : </font></b>
                                        </td>
                                        <td align="right" width="20%">&nbsp;</td>
                                    </tr>
                                    <tr class="description-row" style="display:none;">
                                        <td colspan="2" width="100%">
                                            <font size="2" face="tahoma" color="#e400e0" class="description-text"></font>
                                        </td>
                                    </tr>
                                    <tr height="25">
                                        <td colspan="2" align="center"></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr height="10">
                            <td></td>
                        </tr>
                    </table><br>
                </template>
                <template id="report-test-relate-text-template">
                    <span class="relate-text"></span><br>&nbsp;
                </template>
                <template id="report-test-relate-image-template">
                    <img src="" width="300" border="5" style="border-color:eeeeee"><br>&nbsp;
                </template>
                <template id="report-test-relate-audio-template">
                    <audio controls="controls" preload="none">
                        <source src="">
                    </audio><br>&nbsp;
                </template>
                <template id="report-test-answer-template">
                    <font size="2" face="Verdana" class="answer-text"></font><br>
                </template>
                <template id="report-test-icon-template">
                    <img src="" border="0" style="border-radius:10px;margin-left:35px;">
                </template>
                <template id="report-test-msg-template">
                    <font size="2" color="" class="msg-text"></font>
                </template>

                <template id="report-chart-bar-row-template">
                    <table align="center" width="90%" cellpadding="0" cellspacing="1" border="0" bgcolor="#FFFFFF" style="border-radius:5px">
                        <tr height="40" valign="middle">
                            <td width="20%" align="right">
                                <font size="2" face="tahoma"><b><span class="bar-skill"></span></b></font>
                            </td>
                            <td width="1%" align="center">
                                <font size="2" face="tahoma">&nbsp;:&nbsp;</font>
                            </td>
                            <td width="15%" align="right" bgcolor="eeeeee">
                                <font size="2" face="tahoma">&nbsp; <span class="bar-percent"></span>% [<span class="bar-correct"></span>/<span class="bar-total"></span>]&nbsp;</font>
                            </td>
                            <td width="64%" align="left" bgcolor="eeeeee">
                                <img src="" class="bar-image" height="25" width="" style="border-radius:5px;">
                            </td>
                        </tr>
                    </table>
                </template>
                <template id="report-chart-bar-avg-template">
                    <table align="center" width="90%" cellpadding="0" cellspacing="1" border="0" bgcolor="#FFFFFF" style="border-radius:5px">
                        <tr height="40" valign="middle">
                            <td width="20%" align="right">
                                <font size="2" face="tahoma"><b>Average</b></font>
                            </td>
                            <td width="1%" align="center">
                                <font size="2" face="tahoma">&nbsp;:&nbsp;</font>
                            </td>
                            <td width="15%" align="right" bgcolor="eeeeee">
                                <font size="2" face="tahoma"><b>&nbsp; <span class="avg-percent"></span>% [<span class="avg-correct"></span>/<span class="avg-total"></span>]&nbsp;</font>
                            </td>
                            <td width="64%" align="left" bgcolor="eeeeee">
                                <img src="/assets/2010/temp_images/icon_bar/bar_08.png" height="25" class="avg-bar" width="" style="border-radius:5px">
                            </td>
                        </tr>
                    </table>
                </template>
                <template id="report-weak-point-template">
                    <div class="weak-point-skills"></div>
                </template>
                <template id="report-weak-point-skill-template">
                    <table align="center" name="tb_topic_test" width="90%" height="25" cellpadding="0" cellspacing="0" border="0" bgcolor="#FFFFFF" style="border-radius:5px">
                        <tr>
                            <td><br>
                                <font size="2" face="tahoma" color="gray"><b>&nbsp;The Following Skills are recommended for your future practice</b></font><br>&nbsp;
                            </td>
                        </tr>
                    </table>
                </template>
                <template id="report-weak-point-skill-group-template">
                    <table align="center" width="90%" height="25" cellpadding="0" cellspacing="0" border="0" bgcolor="#FFFFFF">
                        <tr>
                            <td>
                                <font size="2" face="tahoma">&nbsp;<b class="skill-name"></b></font>
                            </td>
                        </tr>
                    </table>
                    <div class="skill-items"></div>
                    <br>
                </template>
                <template id="report-weak-point-item-template">
                    <table align="center" width="90%" cellpadding="0" cellspacing="0" border="0" bgcolor="#FFFFFF" style="border-bottom-right-radius:5px;border-bottom-left-radius:5px">
                        <tr valign="top">
                            <td align="left" width="30%">&nbsp;<font size="2" color="gray" face="tahoma"><b class="sskill-name"></b></font>
                            </td>
                            <td align="center">
                                <font size="2" color="gray" face="tahoma"><b>&nbsp;:&nbsp;&nbsp;</b></font>
                            </td>
                            <td align="left" width="70%">
                                <a class="detail-link" target="_blank" href="#">
                                    <font size="2" color="red" face="tahoma"><b class="detail-name"></b></font>
                                </a>
                            </td>
                        </tr>
                    </table>
                </template>

                <template id="report-view-group-empty-template">
                    <table width="80%" align="center" cellpadding="5" cellspacing="0" border="0" bgcolor="#FFFFFF" style="border-radius:5px">
                        <tr>
                            <td align="center"><br>
                                <font size="2" face="tahoma" color="red"><b>&nbsp;- No Data -</b></font><br>&nbsp;
                            </td>
                        </tr>
                    </table>
                </template>
                <template id="report-view-group-template">
                    <table align="center" width="80%" cellpadding="5" cellspacing="0" border="0" bgcolor="#f0f0f0" style="border-radius:10px">
                        <tr height="30">
                            <td align="center" colspan="6">
                                <font size="2" face="tahoma" color="brown"><b> View Group </b></font>
                            </td>
                        </tr>
                        <tr height="30">
                            <td align="right" width="15%">
                                <font size="2" face="tahoma" color="blue"><b>Total&nbsp;:&nbsp;</b></font>
                            </td>
                            <td align="left" width="18%">
                                <font size="2" face="tahoma" color="blue"><b class="vg-total"></b></font>
                            </td>
                            <td align="right" width="15%">
                                <font size="2" face="tahoma" color="red"><b>Min&nbsp;:&nbsp;</b></font>
                            </td>
                            <td align="left" width="18%">
                                <font size="2" face="tahoma" color="red"><b class="vg-min"></b></font>
                            </td>
                            <td align="right" width="15%">
                                <font size="2" face="tahoma" color="green"><b>Max&nbsp;:&nbsp;</b></font>
                            </td>
                            <td align="left" width="19%">
                                <font size="2" face="tahoma" color="green"><b class="vg-max"></b></font>
                            </td>
                        </tr>
                        <tr height="30">
                            <td align="right" colspan="2">
                                <font size="2" face="tahoma" color="black"><b> Average&nbsp;:&nbsp; </b></font>
                            </td>
                            <td align="left" colspan="4">
                                <font size="2" face="tahoma" color="black"><b class="vg-average"></b></font>
                            </td>
                        </tr>
                    </table><br>
                    <table align="center" width="80%" cellpadding="5" cellspacing="0" border="0" bgcolor="#f0f0f0" style="border-radius:10px">
                        <tr>
                            <td>
                                <table align="center" width="100%" cellpadding="5" cellspacing="1" border="0" class="distribution-table"></table>
                            </td>
                        </tr>
                    </table><br>
                    <table align="center" width="80%" cellpadding="5" cellspacing="0" border="0" bgcolor="#f0f0f0" style="border-radius:10px">
                        <tr height="30">
                            <td align="center" colspan="5">
                                <font size="2" face="tahoma" color="brown"><b> Ranking </b></font>
                            </td>
                        </tr>
                        <tr height="25" bgcolor="#aaaaaa">
                            <td align="center" width="10%">
                                <font size="2" face="tahoma" color="#ffffff"><b> No. </b></font>
                            </td>
                            <td align="center" width="30%">
                                <font size="2" face="tahoma" color="#ffffff"><b> First Name </b></font>
                            </td>
                            <td align="center" width="30%">
                                <font size="2" face="tahoma" color="#ffffff"><b> Last Name </b></font>
                            </td>
                            <td align="center" width="15%">
                                <font size="2" face="tahoma" color="#ffffff"><b> Highest % </b></font>
                            </td>
                            <td align="center" width="15%">
                                <font size="2" face="tahoma" color="#ffffff"><b> Amount </b></font>
                            </td>
                        </tr>
                        <tbody class="ranking-table"></tbody>
                    </table><br>
                </template>
                <template id="report-view-group-distribution-template">
                    <tr height="30">
                        <td align="left" width="20%">
                            <font size="2" face="tahoma"><b class="dist-label"></b></font>
                        </td>
                        <td align="left" width="10%">
                            <font size="2" face="tahoma"><b class="dist-amount"></b></font>
                        </td>
                        <td align="left" width="60%">
                            <img src="" class="dist-bar" height="25" style="border-radius:5px;">
                        </td>
                        <td align="right" width="10%">
                            <font size="2" face="tahoma"><b class="dist-ratio"></b></font>
