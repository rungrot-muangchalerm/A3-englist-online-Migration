<div id="view-report-contest" class="eol-view">
    <div id="report-app">
        <div id="report-focus-bar" class="report-focus-bar">
            <template id="report-focus-bar-template">
                <table width="90%" class="text-center bg-light table table-sm">
                    <tr height="30" class="align-middle">
                        <td width="15%" class="text-end">
                            <span class="text-warning"><b>Focus On &nbsp; : &nbsp; </b></span>
                        </td>
                        <td width="85%" class="text-start">
                            <span class="text-warning"><b class="focus-name"></b></span>
                        </td>
                    </tr>
                </table><br>
                <div class="report-section-back-wrap">
                    <a class="back-link" href="/eol/eoltest/report<%= memberIdQuery %>">
                        <span class="text-primary"><b>&laquo; Back to Report Menu</b></span>
                    </a>
                </div>
            </template>
        </div>

        <div id="report-contest-layout" class="report-section">
            <map name="MapContest" id="MapContest">
                <area shape="rect" coords="720,292,979,379" class="back-area" href="/eol/eoltest/report<%= memberIdQuery %>" target="_self" />
            </map>
            <img src="/assets/images/image2/eol system/Report/report-contest.png" width="100%" usemap="#MapContest">
            <table width="60%" class="text-center bg-light table table-sm">
                <tr height="50" class="align-middle">
                    <td width="13%" class="text-end">
                        <span class="text-dark"><b>From &nbsp; : &nbsp;</b></span>
                    </td>
                    <td width="27%" class="text-start">&nbsp;<input id="popup_container_contest_a" type="text" value="" size="16"></td>
                    <td width="13%" class="text-end">
                        <span class="text-dark"><b>Until &nbsp; : &nbsp;</b></span>
                    </td>
                    <td width="27%" class="text-start">&nbsp;<input id="popup_container_contest_b" type="text" value="" size="16"></td>
                    <td width="15%" class="text-start"><button type="button" class="btn-view btn-view-contest">&nbsp; View &nbsp;</button></td>
                </tr>
                <tr height="25" class="align-middle">
                    <td colspan="5" class="text-center">
                        <span class="text-danger"><b>Format Date : Ex. 2010-12-31 </b></span>
                    </td>
                </tr>
            </table>
            <br><br>
            <div id="contest-items-wrap">
                <template id="report-contest-empty-template">
                    <table width="80%" class="text-center table table-sm">
                        <tr height="50" class="align-middle">
                            <td class="text-center">
                                <span class="text-danger"><b> - Didn't find any result - </b></span>
                            </td>
                        </tr>
                    </table><br><br>&nbsp;
                </template>
                <template id="report-contest-table-template">
                    <table width="100%" class="tb-list-score-contest text-center table table-sm">
                        <tr class="bg-light"></tr>
                    </table>
                </template>
                <template id="report-contest-row-template">
                    <tr>
                        <td class="text-center"></td>
                        <td>
                            <a class="contest-link" target="_blank" href="#" title=""></a>
                        </td>
                        <td>คะแนนที่ได้ : <br><b class="contest-percent"></b></td>
                        <td><img src="/assets/2010/temp_images/icon_bar/bar_01.png" height="25" class="contest-bar" title=""></td>
                    </tr>
                </template>
            </div>
        </div>

        <div id="report-contest-detail" class="report-section">
            <div id="contest-detail-header">
                <template id="report-detail-header-template">
                    <table width="90%" class="text-center bg-light table table-sm">
                        <tr height="25" class="align-middle">
                            <td width="11%" rowspan="4" class="text-center bg-light"><img class="detail-avatar" src="" height="" onerror="this.onerror=null;this.src='/assets/2010/member_images/icon_user_01.jpg'"></td>
                            <td width="22%" class="text-end">
                                <span class="text-dark"><b>ผู้ทำแบบทดสอบ &nbsp; : &nbsp; </b></span>
                            </td>
                            <td width="50%" class="text-start">
                                <span class="text-dark"><b>&nbsp; <span class="detail-fname"></span> &nbsp; &nbsp; <span class="detail-lname"></span> </b></span>
                            </td>
                            <td width="17%" rowspan="4"></td>
                        </tr>
                        <tr height="25" class="align-middle">
                            <td class="text-end">
                                <span class="text-dark"><b>วันที่ทำการทดสอบ &nbsp; : &nbsp; </b></span>
                            </td>
                            <td class="text-start">
                                <span class="text-dark"><b>&nbsp; <span class="detail-date"></span> </b></span>
                            </td>
                        </tr>
                        <tr height="25" class="align-middle">
                            <td class="text-end">
                                <span class="text-dark"><b>ประเภทการทดสอบ &nbsp; : &nbsp; </b></span>
                            </td>
                            <td class="text-start">
                                <span class="text-dark"><b> <span class="detail-section"></span> </b></span>
                            </td>
                        </tr>
                        <tr height="25" class="align-middle">
                            <td class="text-end">
                                <span class="text-dark"><b>คะแนนที่ได้ &nbsp; : &nbsp; </b></span>
                            </td>
                            <td class="text-start">
                                <span class="text-dark"><b>&nbsp; <span class="detail-amount"></span> / <span class="detail-total"></span> &nbsp; คะแนน &nbsp;&nbsp;&nbsp; คิดเป็น &nbsp; <span class="detail-percent"></span> %</b></span>
                            </td>
                        </tr>
                    </table><br>
                </template>

                <template id="report-type-tabs-template">
                    <table width="90%" class="text-center table table-sm">
                        <tr height="30" class="align-middle">
                            <td width="15%" class="text-center"><a class="tab-link-1" href="#"><img src="/assets/images/icon/summary-01.png"></a></td>
                            <td width="15%" class="text-center"><a class="tab-link-2" href="#"><img src="/assets/images/icon/check your answer-01.png"></a></td>
                            <td width="15%" class="text-center"><a class="tab-link-3" href="#"><img src="/assets/images/icon/ranking-01.png"></a></td>
                            <td width="70%" colspan="2" class="text-start">&nbsp;</td>
                        </tr>
                    </table><br>
                </template>
            </div>

            <div id="contest-detail-content">
                <template id="report-contest-custom-question-template">
                    <table width="90%" class="text-center bg-light table table-sm">
                        <tr height="25" class="align-middle">
                            <td width="2%" class="text-center">
                                <span><b class="q-no"></b></span>
                            </td>
                            <td width="98%">
                                <span></span>
                            </td>
                        </tr>
                        <tbody class="answers-body"></tbody>
                        <tr height="15" class="align-middle"></tr>
                        <tr>
                            <td width="2%"></td>
                            <td width="98%" class="msg-cell"></td>
                        </tr>
                        <tr height="10" class="align-middle"></tr>
                        <tr>
                            <td class="icon-cell"></td>
                        </tr>
                    </table><br>
                </template>
                <template id="report-contest-answer-template">
                    <tr>
                        <td width="2%"></td>
                        <td width="98%">
                            <table width="100%" class="text-center table table-sm">
                                <tr>
                                    <td width="75%"><input type="radio" class="answer-radio"> <span class="answer-text"></span></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </template>
                <template id="report-contest-msg-template">
                    <span></span>
                </template>
                <template id="report-contest-icon-template">
                    <img src="">
                </template>

                <template id="report-test-question-template">
                    <table width="90%" class="text-center bg-light table table-sm">
                        <tr height="10" class="align-middle">
                            <td rowspan="6">&nbsp;&nbsp;</td>
                            <td colspan="2"></td>
                            <td rowspan="5">&nbsp;&nbsp;</td>
                        </tr>
                        <tr class="relate-row">
                            <td width="100%" colspan="2" class="relate-cell text-start"></td>
                        </tr>
                        <tr height="25" class="align-middle">
                            <td width="5%" rowspan="3" class="text-center">
                                <span><b class="q-no"></b></span>
                            </td>
                            <td width="95%">
                                <span></span>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <table width="100%" class="text-center table table-sm">
                                    <tr>
                                        <td width="75%">
                                            <span>
                                                <div class="answers"></div>
                                                <br><b>
                                                    <span class="text-primary"></span>&nbsp;<span class="msg-b"></span>
                                                </b>
                                            </span>
                                        </td>
                                        <td width="25%" class="icon-cell text-center"></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-start">
                                <table width="100%" class="text-center table table-sm">
                                    <tr>
                                        <td width="80%" class="text-start">
                                            <span class="text-warning"><b>Tip : <span class="reason-name"></span></span></b>
                                        </td>
                                        <td width="20%" class="text-center">
                                            <a class="lesson-link" target="_blank" href="#">
                                                <b>
                                                    <span class="text-success">&raquo; Go to Lessons &laquo;</span>
                                                </b>
                                            </a>
                                        </td>
                                    </tr>
                                    <tr class="description-row">
                                        <td width="80%" class="text-start">
                                            <span><b>Description : </span></b>
                                        </td>
                                        <td width="20%" class="text-end">&nbsp;</td>
                                    </tr>
                                    <tr class="description-row">
                                        <td colspan="2" width="100%">
                                            <span></span>
                                        </td>
                                    </tr>
                                    <tr height="25" class="align-middle">
                                        <td colspan="2" class="text-center"></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr height="10" class="align-middle">
                            <td></td>
                        </tr>
                    </table><br>
                </template>
                <template id="report-test-relate-text-template">
                    <span class="relate-text"></span><br>&nbsp;
                </template>
                <template id="report-test-relate-image-template">
                    <img src="" width="300"><br>&nbsp;
                </template>
                <template id="report-test-relate-audio-template">
                    <audio controls="controls" preload="none">
                        <source src="">
                    </audio><br>&nbsp;
                </template>
                <template id="report-test-answer-template">
                    <span></span><br>
                </template>
                <template id="report-test-icon-template">
                    <img src="">
                </template>
                <template id="report-test-msg-template">
                    <span></span>
                </template>

                <template id="report-chart-bar-row-template">
                    <table width="90%" class="text-center bg-light table table-sm">
                        <tr height="40" class="align-middle">
                            <td width="20%" class="text-end">
                                <span><b><span class="bar-skill"></span></b></span>
                            </td>
                            <td width="1%" class="text-center">
                                <span>&nbsp;:&nbsp;</span>
                            </td>
                            <td width="15%" class="text-end bg-light">
                                <span>&nbsp; <span class="bar-percent"></span>% [<span class="bar-correct"></span>/<span class="bar-total"></span>]&nbsp;</span>
                            </td>
                            <td width="64%" class="text-start bg-light">
                                <img src="" class="bar-image" height="25" width="">
                            </td>
                        </tr>
                    </table>
                </template>
                <template id="report-chart-bar-avg-template">
                    <table width="90%" class="text-center bg-light table table-sm">
                        <tr height="40" class="align-middle">
                            <td width="20%" class="text-end">
                                <span><b>Average</b></span>
                            </td>
                            <td width="1%" class="text-center">
                                <span>&nbsp;:&nbsp;</span>
                            </td>
                            <td width="15%" class="text-end bg-light">
                                <span><b>&nbsp; <span class="avg-percent"></span>% [<span class="avg-correct"></span>/<span class="avg-total"></span>]&nbsp;</span>
                            </td>
                            <td width="64%" class="text-start bg-light">
                                <img src="/assets/2010/temp_images/icon_bar/bar_08.png" height="25" class="avg-bar" width="">
                            </td>
                        </tr>
                    </table>
                </template>
                <template id="report-weak-point-template">
                    <div class="weak-point-skills"></div>
                </template>
                <template id="report-weak-point-skill-template">
                    <table name="tb_topic_test" width="90%" height="25" class="text-center bg-light table table-sm">
                        <tr>
                            <td><br>
                                <span class="text-secondary"><b>&nbsp;The Following Skills are recommended for your future practice</b></span><br>&nbsp;
                            </td>
                        </tr>
                    </table>
                </template>
                <template id="report-weak-point-skill-group-template">
                    <table width="90%" height="25" class="text-center bg-light table table-sm">
                        <tr>
                            <td>
                                <span>&nbsp;<b class="skill-name"></b></span>
                            </td>
                        </tr>
                    </table>
                    <div class="skill-items"></div>
                    <br>
                </template>
                <template id="report-weak-point-item-template">
                    <table width="90%" class="text-center bg-light table table-sm">
                        <tr>
                            <td width="30%" class="text-start">&nbsp;<span class="text-secondary"><b class="sskill-name"></b></span>
                            </td>
                            <td class="text-center">
                                <span class="text-secondary"><b>&nbsp;:&nbsp;&nbsp;</b></span>
                            </td>
                            <td width="70%" class="text-start">
                                <a class="detail-link" target="_blank" href="#">
                                    <span class="text-danger"><b class="detail-name"></b></span>
                                </a>
                            </td>
                        </tr>
                    </table>
                </template>

                <template id="report-view-group-empty-template">
                    <table width="80%" class="text-center bg-light table table-sm">
                        <tr>
                            <td class="text-center"><br>
                                <span class="text-danger"><b>&nbsp;- No Data -</b></span><br>&nbsp;
                            </td>
                        </tr>
                    </table>
                </template>
                <template id="report-view-group-template">
                    <table width="80%" class="text-center bg-light table table-sm">
                        <tr height="30" class="align-middle">
                            <td colspan="6" class="text-center">
                                <span class="text-warning"><b> View Group </b></span>
                            </td>
                        </tr>
                        <tr height="30" class="align-middle">
                            <td width="15%" class="text-end">
                                <span class="text-primary"><b>Total&nbsp;:&nbsp;</b></span>
                            </td>
                            <td width="18%" class="text-start">
                                <span class="text-primary"><b class="vg-total"></b></span>
                            </td>
                            <td width="15%" class="text-end">
                                <span class="text-danger"><b>Min&nbsp;:&nbsp;</b></span>
                            </td>
                            <td width="18%" class="text-start">
                                <span class="text-danger"><b class="vg-min"></b></span>
                            </td>
                            <td width="15%" class="text-end">
                                <span class="text-success"><b>Max&nbsp;:&nbsp;</b></span>
                            </td>
                            <td width="19%" class="text-start">
                                <span class="text-success"><b class="vg-max"></b></span>
                            </td>
                        </tr>
                        <tr height="30" class="align-middle">
                            <td colspan="2" class="text-end">
                                <span class="text-dark"><b> Average&nbsp;:&nbsp; </b></span>
                            </td>
                            <td colspan="4" class="text-start">
                                <span class="text-dark"><b class="vg-average"></b></span>
                            </td>
                        </tr>
                    </table><br>
                    <table width="80%" class="text-center bg-light table table-sm">
                        <tr>
                            <td>
                                <table width="100%" class="distribution-table text-center table table-sm"></table>
                            </td>
                        </tr>
                    </table><br>
                    <table width="80%" class="text-center bg-light table table-sm">
                        <tr height="30" class="align-middle">
                            <td colspan="5" class="text-center">
                                <span class="text-warning"><b> Ranking </b></span>
                            </td>
                        </tr>
                        <tr height="25" class="bg-secondary text-white align-middle">
                            <td width="10%" class="text-center">
                                <span><b> No. </b></span>
                            </td>
                            <td width="30%" class="text-center">
                                <span><b> First Name </b></span>
                            </td>
                            <td width="30%" class="text-center">
                                <span><b> Last Name </b></span>
                            </td>
                            <td width="15%" class="text-center">
                                <span><b> Highest % </b></span>
                            </td>
                            <td width="15%" class="text-center">
                                <span><b> Amount </b></span>
                            </td>
                        </tr>
                        <tbody class="ranking-table"></tbody>
                    </table><br>
                </template>
                <template id="report-view-group-distribution-template">
                    <tr height="30" class="align-middle">
                        <td width="20%" class="text-start">
                            <span><b class="dist-label"></b></span>
                        </td>
                        <td width="10%" class="text-start">
                            <span><b class="dist-amount"></b></span>
                        </td>
                        <td width="60%" class="text-start">
                            <img src="" class="dist-bar" height="25">
                        </td>
                        <td width="10%" class="text-end">
                            <span><b class="dist-ratio"></b></span>
                        </td>
                    </tr>
                </template>
                <template id="report-view-group-ranking-template">
                    <tr height="25" class="rank-row align-middle">
                        <td class="text-center">
                            <span class="text-dark"><b class="rank-order"></b></span>
                        </td>
                        <td class="text-start">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-dark"><b class="rank-fname"></b></span>
                        </td>
                        <td class="text-start">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-dark"><b class="rank-lname"></b></span>
                        </td>
                        <td class="text-end">
                            <span class="text-dark"><b class="rank-highest"></b></span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                        </td>
                        <td class="text-center">
                            <span class="text-dark"><b class="rank-amount"></b></span>
                        </td>
                    </tr>
                </template>
            </div>
        </div>
    </div>
</div>