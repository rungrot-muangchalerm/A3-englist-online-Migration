<div id="view-report-academic" class="eol-view">
  <div id="report-app">
    <div id="report-focus-bar">
      <template id="report-focus-bar-template">
        <section class="bg-body-tertiary border rounded-3 shadow-sm p-3 mb-3">
          <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
            <div>
              <p class="text-danger fw-semibold mb-1">Academic Report</p>
              <h1 class="h3 fw-bold mb-1">Test Evaluation Report</h1>
              <div class="text-body-secondary">Focus on <span class="focus-name fw-semibold text-body"></span></div>
            </div>
            <a class="back-link btn btn-outline-secondary align-self-start" href="/eol/eoltest/report<%= memberIdQuery %>">
              <i class="bi bi-arrow-left"></i> Back to Report Menu
            </a>
          </div>
        </section>
      </template>
    </div>

    <div id="report-academic-layout" class="report-section">
      <section class="bg-body-tertiary border rounded-3 shadow-sm p-3 p-lg-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
          <div>
            <p class="text-danger fw-semibold mb-1">Report Center</p>
            <h2 class="h4 fw-bold mb-0">Select Skill Report</h2>
          </div>
          <a class="back-area btn btn-outline-secondary align-self-start" href="/eol/eoltest/report<%= memberIdQuery %>">
            <i class="bi bi-arrow-left"></i> Back
          </a>
        </div>

        <div class="row g-3">
          <div class="col-md-6 col-xl-4">
            <a class="multiple-skills-link d-flex align-items-center gap-3 border rounded-3 p-3 text-decoration-none text-body h-100" href="/eol/eoltest/report/academic?skill_id=10<%= memberIdParam %>">
              <span class="btn btn-danger rounded-circle"><i class="bi bi-layers"></i></span>
              <span class="flex-grow-1">
                <strong class="d-block">Multiple Skills</strong>
                <small class="text-body-secondary">Integrated skill results</small>
              </span>
              <i class="bi bi-arrow-right text-danger"></i>
            </a>
          </div>
          <div class="col-md-6 col-xl-4">
            <a class="skill-link d-flex align-items-center gap-3 border rounded-3 p-3 text-decoration-none text-body h-100" data-skill-id="1" href="/eol/eoltest/report/academic?skill_id=1<%= memberIdParam %>">
              <span class="btn btn-outline-danger rounded-circle"><i class="bi bi-book"></i></span>
              <span class="flex-grow-1"><strong class="d-block">Reading Comprehension</strong><small class="text-body-secondary">Reading results</small></span>
              <i class="bi bi-arrow-right text-danger"></i>
            </a>
          </div>
          <div class="col-md-6 col-xl-4">
            <a class="skill-link d-flex align-items-center gap-3 border rounded-3 p-3 text-decoration-none text-body h-100" data-skill-id="2" href="/eol/eoltest/report/academic?skill_id=2<%= memberIdParam %>">
              <span class="btn btn-outline-danger rounded-circle"><i class="bi bi-headphones"></i></span>
              <span class="flex-grow-1"><strong class="d-block">Listening Comprehension</strong><small class="text-body-secondary">Listening results</small></span>
              <i class="bi bi-arrow-right text-danger"></i>
            </a>
          </div>
          <div class="col-md-6 col-xl-4">
            <a class="skill-link d-flex align-items-center gap-3 border rounded-3 p-3 text-decoration-none text-body h-100" data-skill-id="3" href="/eol/eoltest/report/academic?skill_id=3<%= memberIdParam %>">
              <span class="btn btn-outline-danger rounded-circle"><i class="bi bi-mic"></i></span>
              <span class="flex-grow-1"><strong class="d-block">Semi-Speaking</strong><small class="text-body-secondary">Speaking results</small></span>
              <i class="bi bi-arrow-right text-danger"></i>
            </a>
          </div>
          <div class="col-md-6 col-xl-4">
            <a class="skill-link d-flex align-items-center gap-3 border rounded-3 p-3 text-decoration-none text-body h-100" data-skill-id="4" href="/eol/eoltest/report/academic?skill_id=4<%= memberIdParam %>">
              <span class="btn btn-outline-danger rounded-circle"><i class="bi bi-pencil-square"></i></span>
              <span class="flex-grow-1"><strong class="d-block">Semi-Writing</strong><small class="text-body-secondary">Writing results</small></span>
              <i class="bi bi-arrow-right text-danger"></i>
            </a>
          </div>
          <div class="col-md-6 col-xl-4">
            <a class="skill-link d-flex align-items-center gap-3 border rounded-3 p-3 text-decoration-none text-body h-100" data-skill-id="5" href="/eol/eoltest/report/academic?skill_id=5<%= memberIdParam %>">
              <span class="btn btn-outline-danger rounded-circle"><i class="bi bi-braces"></i></span>
              <span class="flex-grow-1"><strong class="d-block">Grammar</strong><small class="text-body-secondary">Grammar results</small></span>
              <i class="bi bi-arrow-right text-danger"></i>
            </a>
          </div>
          <div class="col-md-6 col-xl-4">
            <a class="skill-link d-flex align-items-center gap-3 border rounded-3 p-3 text-decoration-none text-body h-100" data-skill-id="7" href="/eol/eoltest/report/academic?skill_id=7<%= memberIdParam %>">
              <span class="btn btn-outline-danger rounded-circle"><i class="bi bi-card-text"></i></span>
              <span class="flex-grow-1"><strong class="d-block">Vocabulary</strong><small class="text-body-secondary">Vocabulary results</small></span>
              <i class="bi bi-arrow-right text-danger"></i>
            </a>
          </div>
        </div>
      </section>
    </div>

    <div id="report-academic-list" class="report-section d-none">
      <div id="academic-list-filter">
        <template id="report-academic-filter-template">
          <section class="bg-body-tertiary border rounded-3 shadow-sm p-3 mb-3">
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
              <div>
                <p class="text-danger fw-semibold mb-1">Report</p>
                <h2 class="h4 fw-bold mb-0 skill-name"></h2>
              </div>
              <div class="row g-2 align-items-end">
                <div class="col-sm-auto">
                  <label for="popup_container_a" class="form-label small">From</label>
                  <input id="popup_container_a" type="text" value="" class="form-control form-control-sm">
                </div>
                <div class="col-sm-auto">
                  <label for="popup_container_b" class="form-label small">Until</label>
                  <input id="popup_container_b" type="text" value="" class="form-control form-control-sm">
                </div>
                <div class="col-sm-auto">
                  <button type="button" class="btn btn-danger btn-sm btn-view-academic">View</button>
                </div>
              </div>
            </div>
            <div class="form-text mt-2">Format Date: 2010-12-31</div>
          </section>
        </template>
      </div>

      <div id="academic-list-levels">
        <template id="report-empty-template">
          <div class="alert alert-danger">No Data</div>
        </template>

        <template id="report-academic-level-template">
          <section class="bg-body-tertiary border rounded-3 shadow-sm p-3 mb-3">
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-2 mb-3">
              <h3 class="h5 fw-bold mb-0"><span class="level-title"></span><span class="level-name"></span></h3>
              <div class="d-flex flex-wrap gap-2">
                <span class="badge text-bg-primary">Min <span class="level-min"></span></span>
                <span class="badge text-bg-danger">Max <span class="level-max"></span></span>
                <span class="badge text-bg-success">Average <span class="level-average"></span></span>
              </div>
            </div>
            <div class="table-responsive">
              <table class="items-table table table-sm table-hover align-middle mb-0"></table>
            </div>
          </section>
        </template>

        <template id="report-academic-item-template">
          <tr>
            <td>
              <a class="item-link text-warning fw-semibold text-decoration-none" target="_blank" href="#">
                <span class="item-date"></span>
              </a>
            </td>
            <td class="text-end"><span class="item-correct"></span> / <span class="item-total"></span></td>
            <td>
              <div class="progress">
                <div class="progress-bar bg-danger item-progress" role="progressbar">
                  <img class="item-bar d-none" src="" alt="">
                </div>
              </div>
            </td>
            <td class="text-end text-primary fw-semibold"><span class="item-percent"></span>%</td>
          </tr>
        </template>
      </div>
    </div>

    <div id="report-academic-detail" class="report-section d-none">
      <div id="academic-detail-header">
        <template id="report-detail-header-template">
          <section class="bg-body-tertiary border rounded-3 shadow-sm p-3 mb-3">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-3">
              <img class="detail-avatar rounded-circle border" src="" height="" alt="">
              <div class="flex-grow-1">
                <h2 class="h4 fw-bold mb-2"><span class="detail-fname"></span> <span class="detail-lname"></span></h2>
                <div class="row g-2 small text-body-secondary">
                  <div class="col-md-4">Date: <span class="detail-date text-body"></span></div>
                  <div class="col-md-4">Type: <span class="detail-section text-body"></span></div>
                  <div class="col-md-4">Score: <span class="detail-amount text-body"></span> / <span class="detail-total text-body"></span> (<span class="detail-percent text-body"></span>%)</div>
                </div>
              </div>
              <a class="back-link btn btn-outline-secondary align-self-start" href="/eol/eoltest/report<%= memberIdQuery %>">
                <i class="bi bi-arrow-left"></i> Back
              </a>
            </div>
          </section>
        </template>

        <template id="report-type-tabs-template">
          <nav class="nav nav-pills gap-2 mb-3">
            <a class="tab-link-1 nav-link" href="#"><i class="bi bi-bar-chart"></i> Summary</a>
            <a class="tab-link-2 nav-link" href="#"><i class="bi bi-check2-square"></i> Answers</a>
            <a class="tab-link-3 nav-link" href="#"><i class="bi bi-trophy"></i> Ranking</a>
          </nav>
        </template>
      </div>

      <div id="academic-detail-summary">
        <template id="report-chart-bar-row-template">
          <div class="bg-body-tertiary border rounded-3 p-3 mb-2">
            <div class="d-flex justify-content-between gap-3 mb-2">
              <strong class="bar-skill"></strong>
              <span><span class="bar-percent"></span>% [<span class="bar-correct"></span>/<span class="bar-total"></span>]</span>
            </div>
            <div class="progress">
              <div class="progress-bar bg-danger bar-progress" role="progressbar">
                <img src="" class="bar-image d-none" alt="">
              </div>
            </div>
          </div>
        </template>

        <template id="report-chart-bar-avg-template">
          <div class="bg-body-tertiary border border-success rounded-3 p-3 mb-3">
            <div class="d-flex justify-content-between gap-3 mb-2">
              <strong>Average</strong>
              <span><span class="avg-percent"></span>% [<span class="avg-correct"></span>/<span class="avg-total"></span>]</span>
            </div>
            <div class="progress">
              <div class="progress-bar bg-success avg-progress" role="progressbar">
                <img src="/assets/2010/temp_images/icon_bar/bar_08.png" class="avg-bar d-none" alt="">
              </div>
            </div>
          </div>
        </template>

        <template id="report-weak-point-template">
          <section class="bg-body-tertiary border rounded-3 shadow-sm p-3">
            <h3 class="h5 fw-bold mb-3">Recommended Practice</h3>
            <div class="weak-point-skills"></div>
          </section>
        </template>
        <template id="report-weak-point-skill-template">
          <p class="text-body-secondary mb-3">The following skills are recommended for your future practice.</p>
        </template>
        <template id="report-weak-point-skill-group-template">
          <div class="border rounded-3 p-3 mb-3">
            <h4 class="h6 fw-bold skill-name"></h4>
            <div class="skill-items list-group"></div>
          </div>
        </template>
        <template id="report-weak-point-item-template">
          <div class="list-group-item">
            <span class="text-body-secondary sskill-name"></span>
            <a class="detail-link d-block text-danger fw-semibold text-decoration-none" target="_blank" href="#">
              <span class="detail-name"></span>
            </a>
          </div>
        </template>
      </div>

      <div id="academic-detail-answers">
        <template id="report-test-question-template">
          <section class="bg-body-tertiary border rounded-3 shadow-sm p-3 mb-3">
            <div class="relate-row d-none mb-3">
              <div class="relate-cell"></div>
            </div>
            <div class="d-flex gap-3">
              <span class="badge text-bg-danger align-self-start q-no"></span>
              <div class="flex-grow-1">
                <div class="fw-semibold mb-3 q-text"></div>
                <div class="answers mb-3"></div>
                <div class="mb-3">
                  <span class="text-primary msg-a"></span>
                  <span class="msg-b"></span>
                </div>
                <div class="icon-cell mb-3"></div>
                <div class="border-top pt-3">
                  <div class="text-warning fw-semibold">Tip: <span class="reason-name"></span></div>
                  <a class="lesson-link btn btn-outline-success btn-sm mt-2" target="_blank" href="#">Go to Lessons</a>
                  <div class="description-row d-none mt-3">
                    <strong>Description:</strong>
                  </div>
                  <div class="description-row d-none">
                    <span class="description-text"></span>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </template>
        <template id="report-test-relate-text-template">
          <p class="relate-text mb-0"></p>
        </template>
        <template id="report-test-relate-image-template">
          <img src="" width="300" alt="" class="img-fluid rounded border">
        </template>
        <template id="report-test-relate-audio-template">
          <audio controls="controls" preload="none" class="w-100">
            <source src="">
          </audio>
        </template>
        <template id="report-test-answer-template">
          <div class="mb-1"><span class="answer-text"></span></div>
        </template>
        <template id="report-test-icon-template">
          <img src="" alt="" class="img-fluid">
        </template>
        <template id="report-test-msg-template">
          <span class="msg-text"></span>
        </template>
      </div>

      <div id="academic-detail-group">
        <template id="report-view-group-empty-template">
          <div class="alert alert-danger">No Data</div>
        </template>
        <template id="report-view-group-template">
          <section class="bg-body-tertiary border rounded-3 shadow-sm p-3">
            <h3 class="h5 fw-bold mb-3">View Group</h3>
            <div class="row g-2 mb-3">
              <div class="col-md-3"><span class="badge text-bg-primary w-100">Total <span class="vg-total"></span></span></div>
              <div class="col-md-3"><span class="badge text-bg-danger w-100">Min <span class="vg-min"></span></span></div>
              <div class="col-md-3"><span class="badge text-bg-success w-100">Max <span class="vg-max"></span></span></div>
              <div class="col-md-3"><span class="badge text-bg-secondary w-100">Average <span class="vg-average"></span></span></div>
            </div>
            <div class="table-responsive mb-3">
              <table class="distribution-table table table-sm align-middle"></table>
            </div>
            <div class="table-responsive">
              <table class="table table-sm table-hover align-middle">
                <thead>
                  <tr>
                    <th>No.</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th class="text-end">Highest %</th>
                    <th class="text-center">Amount</th>
                  </tr>
                </thead>
                <tbody class="ranking-table"></tbody>
              </table>
            </div>
          </section>
        </template>
        <template id="report-view-group-distribution-template">
          <tr>
            <td class="dist-label fw-semibold"></td>
            <td class="dist-amount"></td>
            <td>
              <div class="progress">
                <div class="progress-bar bg-danger dist-progress" role="progressbar">
                  <img src="" class="dist-bar d-none" alt="">
                </div>
              </div>
            </td>
            <td class="text-end"><span class="dist-ratio"></span>%</td>
          </tr>
        </template>
        <template id="report-view-group-ranking-template">
          <tr class="rank-row">
            <td class="rank-order fw-semibold"></td>
            <td class="rank-fname"></td>
            <td class="rank-lname"></td>
            <td class="rank-highest text-end"></td>
            <td class="rank-amount text-center"></td>
          </tr>
        </template>
      </div>
    </div>
  </div>
</div>
