                            <td colspan="4"></td>
                        </tr>
                        <tr height="30">
                            <td>&nbsp;</td>
                            <td colspan="3">
                                <table align="center" width="100%" cellpadding="5" cellspacing="0" border="0" bgcolor="#f0f0f0" style="border-radius:10px">
                                    <tr height="25">
                                        <td align="right" width="15%">
                                            <font size="2" face="tahoma" color="blue"><b>Min&nbsp;:&nbsp;</b></font>
                                        </td>
                                        <td align="left" width="20%">
                                            <font size="2" face="tahoma" color="blue"><b class="level-min"></b></font>
