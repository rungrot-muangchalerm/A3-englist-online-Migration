                            <td align="center">
                                <font size="3" face="tahoma" color="green"><b> Report : <span class="skill-name"></span></b></font>
                            </td>
                        </tr>
                    </table>
                    <br>
                    <table align="center" width="60%" bgcolor="#ffffff" cellpadding="0" cellspacing="0" border="0" style="border-radius:10px;">
                        <tr height="50" valign="middle">
                            <td align="right" width="13%">
                                <font size="2" face="tahoma" color="black"><b>From &nbsp; : &nbsp;</b></font>
                            </td>
                            <td align="left" width="27%">&nbsp;<input id="popup_container_a" type="text" value="" size="16" style="height:22px;border-radius:8px;border:1px solid #bbb2ae"></td>
                            <td align="right" width="13%">
                                <font size="2" face="tahoma" color="black"><b>Until &nbsp; : &nbsp;</b></font>
                            </td>
                            <td align="left" width="27%">&nbsp;<input id="popup_container_b" type="text" value="" size="16" style="height:22px;border-radius:8px;border:1px solid #bbb2ae"></td>
                            <td align="left" width="15%"><button type="button" class="btn-view btn-view-academic">&nbsp; View &nbsp;</button></td>
                        </tr>
                        <tr height="25">
