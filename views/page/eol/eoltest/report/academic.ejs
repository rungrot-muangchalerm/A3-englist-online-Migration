                                        <td align="right" width="15%">
                                            <font size="2" face="tahoma" color="red"><b>Max&nbsp;:&nbsp;</b></font>
                                        </td>
                                        <td align="left" width="20%">
                                            <font size="2" face="tahoma" color="red"><b class="level-max"></b></font>
                                        </td>
                                        <td align="right" width="15%">
                                            <font size="2" face="tahoma" color="green"><b>Average&nbsp;:&nbsp;</b></font>
                                        </td>
                                        <td align="left" width="15%">
                                            <font size="2" face="tahoma" color="green"><b class="level-average"></b></font>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                    <br>
                </template>
                <template id="report-academic-item-template">
                    <tr height="30">
                        <td align="left" width="20%" bgcolor="#f0f0f0">
                            <a class="item-link" target="_blank" href="#">
                                <font size="2" face="tahoma" color="brown"><b>&nbsp; <span class="item-date"></span></b></font>
                            </a>
                        </td>
                        <td width="10%" align="right" bgcolor="#d7d7d7">
                            <font size="2" face="tahoma" color="black"><b><span class="item-correct"></span> / <span class="item-total"></span>&nbsp;&nbsp;</b></font>
                        </td>
                        <td width="60%" align="left" bgcolor="#f0f0f0">&nbsp;<img class="item-bar" src="" width="" height="25" style="border-radius:5px;margin-top:2.5px;"></td>
                        <td width="10%" align="right" bgcolor="#d7d7d7">
