                        </td>
                    </tr>
                    <tr height="1">
                        <td colspan="4"></td>
                    </tr>
                </template>
            </div>
        </div>

        <div id="report-academic-detail" class="report-section" style="display:none;">
            <div id="academic-detail-header">
                <template id="report-detail-header-template">

                    <table align="center" width="90%" cellpadding="5" cellspacing="0" border="0" bgcolor="#fff" style="border-radius:10px">
                        <tr height="25">
                            <td width="11%" rowspan="4" bgcolor="#e7e7e7" align="center"><img class="detail-avatar" src="" height="" onerror="this.onerror=null;this.src='/assets/2010/member_images/icon_user_01.jpg'"></td>
                            <td width="22%" align="right">
                                <font size="2" face="tahoma" color="black"><b>ผู้ทำแบบทดสอบ &nbsp; : &nbsp; </b></font>
                            </td>
                            <td width="50%" align="left">
                                <font size="2" face="tahoma" color="black"><b>&nbsp; <span class="detail-fname"></span> &nbsp; &nbsp; <span class="detail-lname"></span> </b></font>
                            </td>
                            <td width="17%" rowspan="4"></td>
