                    <table align="center" width="90%" height="25" cellpadding="0" cellspacing="0" border="0" bgcolor="#FFFFFF" style="border-radius:5px">
                        <tr>
                            <td align="center"><br>
                                <font size="2" face="tahoma" color="red"><b>&nbsp;- No Data -</b></font><br>&nbsp;
                            </td>
                        </tr>
                    </table>
                </template>
                <template id="report-academic-level-template">
                    <br>
                    <table align="center" width="90%" cellpadding="0" cellspacing="0" border="0">
                        <tr height="50">
                            <td align="left" colspan="4">
                                <font size="3" face="tahoma" class="level-title" color=""><b>&nbsp; <span class="level-name"></span></b></font>
                            </td>
                        </tr>
                    </table>
                    <table align="center" width="90%" cellpadding="0" cellspacing="0" border="0" class="items-table"></table>
                    <table align="center" width="90%" cellpadding="0" cellspacing="0" border="0">
