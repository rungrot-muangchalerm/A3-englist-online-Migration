                                        <font size="2" face="tahoma" color="black"><b><img src="/assets/images/icon/arrow.gif"> Reading Comprehension </b></font>
                                    </a>
                                </td>
                                <td width="33%">&nbsp;
                                    <a class="skill-link" data-skill-id="3" href="/eol/eoltest/report/academic?skill_id=3<%= memberIdParam %>">
                                        <font size="2" face="tahoma" color="black"><b><img src="/assets/images/icon/arrow.gif"> Semi-Speaking </b></font>
                                    </a>
                                </td>
                                <td width="33%">&nbsp;
                                    <a class="skill-link" data-skill-id="5" href="/eol/eoltest/report/academic?skill_id=5<%= memberIdParam %>">
                                        <font size="2" face="tahoma" color="black"><b><img src="/assets/images/icon/arrow.gif"> Grammar </b></font>
                                    </a>
                                </td>
                            </tr>
                            <tr height="25">
                                <td width="33%">&nbsp;
                                    <a class="skill-link" data-skill-id="2" href="/eol/eoltest/report/academic?skill_id=2<%= memberIdParam %>">
                                        <font size="2" face="tahoma" color="black"><b><img src="/assets/images/icon/arrow.gif"> Listening Comprehension </b></font>
                                    </a>
                                </td>
                                <td width="33%">&nbsp;
                                    <a class="skill-link" data-skill-id="4" href="/eol/eoltest/report/academic?skill_id=4<%= memberIdParam %>">
                                        <font size="2" face="tahoma" color="black"><b><img src="/assets/images/icon/arrow.gif"> Semi-Writing </b></font>
                                    </a>
                                </td>
                                <td width="33%">&nbsp;
                                    <a class="skill-link" data-skill-id="7" href="/eol/eoltest/report/academic?skill_id=7<%= memberIdParam %>">
                                        <font size="2" face="tahoma" color="black"><b><img src="/assets/images/icon/arrow.gif"> Vocabulary </b></font>
                                    </a>
                                </td>
                            </tr>
