<div id="view-report" class="eol-view">
    <div id='report-app'>
        <div id="report-section-selector" class="report-section">
            <div id="selector-class" class="selector-class">
                <p id="selector-text"></p>
            </div>
            <table width="90%" class="sec-report text-center table table-sm">
                <tr>
                    <td>
                        <div>
                            <div id="report-buttons" class="report-buttons">
                                <a id="report-button-academic" class="report-button" href="/eol/eoltest/report/academic<%= memberIdQuery %>">
                                    <img id="report-button-academic-img" src="/assets/images/image2/eol system/Report/Button/Test Evaluation Report.png">
                                </a>
                                <a id="report-button-standard" class="report-button" href="/eol/eoltest/report/standard<%= memberIdQuery %>">
                                    <img id="report-button-standard-img" src="/assets/images/image2/eol system/Report/Button/EST Report.png">
                                </a>
                                <a id="report-button-contest" class="report-button" href="/eol/eoltest/report/contest<%= memberIdQuery %>">
                                    <img id="report-button-contest-img" src="/assets/images/image2/eol system/Report/Button/Contest Report.png">
                                </a>
                            </div>
                            <img src="/assets/images/image2/eol system/Report/bg-report.png" width="100%">
                        </div>
                    </td>
                </tr>
            </table><br>&nbsp;
        </div>
    </div>
</div>