<div id="view-report" class="eol-view">
    <div id='report-app'>
        <div id="report-section-selector" class="report-section">
            <div id="selector-class" class="selector-class" style="z-index: 2; top: 30%;">
                <p id="selector-text"></p>
            </div>
            <table align="center" width="90%" cellpadding="0" cellspacing="0" border="0" class="sec-report">
                <tr>
                    <td>
                        <div style="position: relative;">
                            <div id="report-buttons" class="report-buttons" style="position: absolute; top: 38%; left: 0; right: 0; display: flex; justify-content: center; align-items: center; gap: 4%; z-index: 1;">
                                <a id="report-button-academic" class="report-button" href="/eol/eoltest/report/academic<%= memberIdQuery %>" style="width: 28%; display: block;">
                                    <img id="report-button-academic-img" src="/assets/images/image2/eol system/Report/Button/Test Evaluation Report.png" style="width: 100%; border-radius: 20px; display: block;">
                                </a>
                                <a id="report-button-standard" class="report-button" href="/eol/eoltest/report/standard<%= memberIdQuery %>" style="width: 28%; display: block;">
                                    <img id="report-button-standard-img" src="/assets/images/image2/eol system/Report/Button/EST Report.png" style="width: 100%; border-radius: 20px; display: block;">
                                </a>
                                <a id="report-button-contest" class="report-button" href="/eol/eoltest/report/contest<%= memberIdQuery %>" style="width: 28%; display: none;">
                                    <img id="report-button-contest-img" src="/assets/images/image2/eol system/Report/Button/Contest Report.png" style="width: 100%; border-radius: 20px; display: block;">
                                </a>
                            </div>
                            <img src="/assets/images/image2/eol system/Report/bg-report.png" width="100%" style="border-radius:10px">
                        </div>
                    </td>
                </tr>
            </table><br>&nbsp;
        </div>
    </div>
</div>
