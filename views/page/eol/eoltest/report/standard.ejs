<div id="view-report-standard" class="eol-view">
    <div id="report-app">
        <div id="report-focus-bar" class="report-focus-bar">
            <template id="report-focus-bar-template">
                <table align="center" width="90%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f0f0f0" style="border-radius:5px">
                    <tr height="30">
                        <td align="right" width="15%">
                            <font size="2" face="tahoma" color="brown"><b>Focus On &nbsp; : &nbsp; </b></font>
                        </td>
                        <td align="left" width="85%">
                            <font size="2" face="tahoma" color="brown"><b class="focus-name"></b></font>
                        </td>
                    </tr>
                </table><br>
                <div class="report-section-back-wrap">
                    <a class="back-link" href="/eol/eoltest/report<%= memberIdQuery %>">
                        <font size="2" face="tahoma" color="blue"><b>&laquo; Back to Report Menu</b></font>
                    </a>
                </div>
            </template>
        </div>

        <div id="report-standard-layout" class="report-section">
            <map name="BackStandard" id="BackStandard">
                <area shape="rect" coords="720,286,978,377" class="back-area" href="/eol/eoltest/report<%= memberIdQuery %>" target="_self" />
            </map>
            <img src="/assets/images/image2/eol system/Report/report-standard-test.png" width="100%" usemap="#BackStandard" style="border-radius:10px;">
            <br>
            <table align="center" width="60%" bgcolor="#827f7beb" cellpadding="0" cellspacing="0" border="0" style="border-radius: 10px;">
                <tr height="50" valign="middle">
                    <td align="right" width="13%">
                        <font size="2" face="tahoma" color="black"><b>From &nbsp; : &nbsp;</b></font>
                    </td>
                    <td align="left" width="27%">&nbsp;<input id="popup_eolstandard_a" type="text" value="" size="16" style="height:22px;border-radius:8px;border:1px solid #bbb2ae;"></td>
                    <td align="right" width="13%">
                        <font size="2" face="tahoma" color="black"><b>Until &nbsp; : &nbsp;</b></font>
                    </td>
                    <td align="left" width="27%">&nbsp;<input id="popup_eolstandard_b" type="text" value="" size="16" style="height:22px;border-radius:8px;border:1px solid #bbb2ae;"></td>
                    <td align="left" width="15%"><button type="button" class="btn-view btn-view-standard">&nbsp; View &nbsp;</button></td>
                </tr>
                <tr height="25">
                    <td align="center" colspan="5">
