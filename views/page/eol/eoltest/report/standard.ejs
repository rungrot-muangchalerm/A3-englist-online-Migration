                    </td>
                </tr>
                <tr height="25" class="align-middle">
                    <td width="10%" rowspan="4" class="text-center bg-body-secondary">
                        <img class="detail-avatar" src="" height="" onerror="this.onerror=null;this.src='/assets/2010/member_images/icon_user_01.jpg'">
                    </td>
                    <td width="20%" class="text-end">
                        <span class="text-body"><b>ผู้ทำแบบทดสอบ &nbsp; : &nbsp; </b></span>
