<div id="view-report-standard" class="eol-view">
    <div id="report-app">
        <div id="report-focus-bar" class="report-focus-bar">
            <template id="report-focus-bar-template">
                <table width="90%" class="text-center bg-body-secondary table table-sm">
                    <tr height="30" class="align-middle">
                        <td width="15%" class="text-end">
                            <span class="text-warning"><b>Focus On &nbsp; : &nbsp; </b></span>
                        </td>
                        <td width="85%" class="text-start">
                            <span class="text-warning"><b class="focus-name"></b></span>
                        </td>
                    </tr>
                </table><br>
                <div class="report-section-back-wrap">
                    <a class="back-link" href="/eol/eoltest/report<%= memberIdQuery %>">
                        <span class="text-primary"><b>&laquo; Back to Report Menu</b></span>
                    </a>
                </div>
            </template>
        </div>

        <div id="report-standard-layout" class="report-section">
            <map name="BackStandard" id="BackStandard">
                <area shape="rect" coords="720,286,978,377" class="back-area" href="/eol/eoltest/report<%= memberIdQuery %>" target="_self" />
            </map>
            <img src="/assets/images/image2/eol system/Report/report-standard-test.png" width="100%" usemap="#BackStandard">
            <br>
            <table width="60%" class="text-center bg-body-secondary table table-sm">
                <tr height="50" class="align-middle">
                    <td width="13%" class="text-end">
                        <span class="text-body"><b>From &nbsp; : &nbsp;</b></span>
                    </td>
                    <td width="27%" class="text-start">&nbsp;<input id="popup_eolstandard_a" type="text" value="" size="16"></td>
                    <td width="13%" class="text-end">
                        <span class="text-body"><b>Until &nbsp; : &nbsp;</b></span>
                    </td>
                    <td width="27%" class="text-start">&nbsp;<input id="popup_eolstandard_b" type="text" value="" size="16"></td>
                    <td width="15%" class="text-start"><button type="button" class="btn-view btn-view-standard">&nbsp; View &nbsp;</button></td>
                </tr>
                <tr height="25" class="align-middle">
                    <td colspan="5" class="text-center">
                        <span class="text-danger"><b>Format Date : Ex. 2010-12-31 </b></span>
                    </td>
                </tr>
            </table>
            <br><br><br>
            <div id="standard-items-wrap">
                <template id="report-standard-empty-template">
                    <table width="80%" class="text-center table table-sm">
                        <tr height="50" class="align-middle">
                            <td class="text-center">
                                <span class="text-danger"><b> - Didn't find any EOL Standard Test result - </b></span>
                            </td>
                        </tr>
                    </table><br><br>&nbsp;
                </template>
                <template id="report-standard-list-table-template">
                    <table width="80%" class="text-center table table-sm">
                        <tr height="25" class="align-middle">
                            <td colspan="6" class="text-start"></td>
                        </tr>
                        <tbody class="items-body"></tbody>
                        <tr height="25" class="bg-body-secondary align-middle">
                            <td colspan="6" class="text-start"></td>
                        </tr>
                    </table><br><br>&nbsp;
                </template>
                <template id="report-standard-row-template">
                    <tr height="25" class="align-middle">
                        <td width="7%" class="text-end">
                            <span class="text-body">&bull;&nbsp;</span>
                        </td>
                        <td width="15%" class="text-start">
                            <span class="text-body"><b>ทำการทดสอบเมื่อ</b></span>
                        </td>
                        <td width="44%" class="text-start">
                            <span class="text-body"><b class="std-date"></b></span>
                        </td>
                        <td width="20%" class="text-start">
                            <span class="text-body"><b>คิดเป็น&nbsp;&nbsp;<span class="std-percent"></span>&nbsp;&nbsp;%</b></span>
                        </td>
                        <td width="14%" class="text-center">
                            <a class="std-link" target="_blank" href="#">
                                <span class="text-primary"><b>[ดูรายละเอียด]&nbsp;&nbsp;</b></span>
                            </a>
                        </td>
                    </tr>
                </template>
            </div>
        </div>

        <div id="report-standard-detail" class="report-section">
            <div class="report-section-back-wrap">
                <a class="back-link" href="/eol/eoltest/report/standard<%= memberIdQuery %>">
