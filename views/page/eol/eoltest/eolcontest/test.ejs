<div id="eolcontest-app" class="f-thai">
  <div class="ecop-header">
    <img src="/assets/images/icon/icon_corporate.png">
    <div class="ecop-header-title oswald">CORPORATE MEMBER'S USE</div>
  </div>

  <div class="timer-box text-center">
    <div id="contest-timer">เวลาที่เหลือ : <span class="text-danger">0</span> นาที กับ <span class="text-danger">0</span> วินาที</div>
  </div>

  <div class="test-wrap">
    <table width="100%" class="table table-sm">
      <tr>
        <td colspan="2">
          <span class="text-secondary"><b></b></span>
        </td>
      </tr>
      <tr>
        <td colspan="2">
          <span><b id="contest-question-no">No. -</b></span>
        </td>
      </tr>
      <tr>
        <td colspan="2" id="contest-media" class="media-wrap"></td>
      </tr>
      <tr>
        <td colspan="2" id="contest-question-text" class="question-text"></td>
      </tr>
      <tr>
        <td colspan="2" id="contest-answers"></td>
      </tr>
      <tr>
        <td colspan="2">
          <button id="contest-record-btn" class="btn-record">Record your answer</button>
        </td>
      </tr>
      <tr>
        <td colspan="2">
          <div class="question-grid">
            <span class="text-dark"><b>Question Number</b></span>
            <div id="contest-question-grid"></div>
          </div>
        </td>
      </tr>
      <tr>
        <td colspan="2">
          <table width="100%" class="table table-sm">
            <tr>
              <td width="10%" class="text-start"><img id="contest-back-btn" src="/assets/images/image2/test/back.png"></td>
              <td width="80%" class="text-center">
                <span class="text-danger">Red : Unanswer</span>
                &nbsp;&nbsp;&nbsp;
                <span class="text-success">Green : Answered</span>
              </td>
              <td width="10%" class="text-end"><img id="contest-next-btn" src="/assets/images/image2/test/next.png"></td>
            </tr>
          </table>
        </td>
      </tr>
      <tr>
        <td colspan="2" class="finish-wrap">
          <button id="contest-finish-btn" class="btn-finish">Finish</button>
        </td>
      </tr>
    </table>
  </div>

  <div class="back-wrap">
    <a href="/eol/eoltest/eolcontest">
      <img src="/assets/images/image2/eol system/ecop/btn_backsite.png">
    </a>
  </div>
</div>