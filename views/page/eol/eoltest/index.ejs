<div id="view-master" class="eol-view d-none">
  <section class="bg-body-tertiary border rounded-3 shadow-sm p-3 p-lg-4">
    <div class="d-flex flex-column gap-3 mb-4">
      <div>
        <p class="text-danger fw-semibold mb-1">Master Account</p>
        <h1 class="h3 fw-bold mb-0">Sub account management</h1>
      </div>
      <div class="row g-2 align-items-end">
        <div class="col-lg-5">
          <label for="group_id" class="form-label fw-semibold">Group</label>
          <select name="group_id" id="group_id" class="form-select"></select>
        </div>
        <div class="col-lg-auto d-flex flex-wrap gap-2">
          <button type="button" class="btn btn-dark" id="master-view-group"><i class="bi bi-eye"></i> View</button>
          <button type="button" class="btn btn-outline-light modalInput" rel="#prompt1" id="master-rename-btn"><i class="bi bi-pencil-square"></i> Edit</button>
          <button type="button" class="btn btn-outline-danger" id="master-delete-group"><i class="bi bi-trash3"></i> Delete</button>
        </div>
        <div class="col-lg">
          <label for="group_name" class="form-label fw-semibold">Create group</label>
          <div class="input-group">
            <input type="text" name="group_name" id="group_name" placeholder="Name Group" class="form-control" required>
            <button type="button" class="btn btn-danger" id="master-create-group"><i class="bi bi-plus-lg"></i> Create</button>
          </div>
        </div>
      </div>
    </div>

    <div id="master-empty" class="bg-body-secondary border rounded-3 p-5 text-center d-none">
      <i class="bi bi-inbox display-6 text-body-secondary"></i>
      <h2 class="h5 mt-3 mb-0">No Data</h2>
    </div>

    <div id="master-list-wrap">
      <div class="table-responsive">
        <table class="table table-hover table-sm align-middle">
          <thead class="table-dark">
            <tr>
              <th class="text-center">
                <button type="button" id="master-select-all" class="btn btn-sm btn-outline-light">All</button>
                <input type="hidden" id="all_status" value="select">
              </th>
              <th>First name - Last name</th>
              <th class="text-center">Username</th>
              <th class="text-center">Password</th>
              <th class="text-center">Operating time</th>
              <th class="text-center">Management</th>
            </tr>
          </thead>
          <tbody id="master-member-rows"></tbody>
        </table>
      </div>

      <div class="d-flex flex-wrap align-items-center gap-2 border-top border-bottom py-3 mb-3">
        <span class="fw-semibold text-danger">Page :</span>
        <div id="master-pagination" class="d-flex flex-wrap gap-1"></div>
      </div>

      <div class="bg-body-secondary border rounded-3 p-3 mb-4">
        <div class="row g-2 align-items-center">
          <div class="col-lg-auto fw-semibold">Selected Items :</div>
          <div class="col-lg-auto d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="master-bulk-limit">
              <img src="/assets/images/icon/limit.png" alt="" width="18" height="18"> Limit
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="master-bulk-unlimit">
              <img src="/assets/images/icon/unlimit.png" alt="" width="18" height="18"> Unlimit
            </button>
            <button type="button" class="btn btn-outline-danger btn-sm" id="master-bulk-delete">
              <img src="/assets/images/icon/bin.png" alt="" width="18" height="18"> Delete
            </button>
          </div>
          <div class="col-lg-auto fw-semibold">Move To :</div>
          <div class="col-lg">
            <select id="ref_id" class="form-select form-select-sm"></select>
          </div>
          <div class="col-lg-auto">
            <button type="button" class="btn btn-dark btn-sm" id="master-bulk-move">Set</button>
          </div>
        </div>
      </div>
    </div>

    <div id="master-add-section" class="border rounded-3 p-3 p-lg-4">
      <p class="text-danger fw-semibold mb-1">Add New Member</p>
      <h2 class="h4 fw-bold mb-3">Create sub account</h2>
      <div id="master-action-error-row" class="d-none"></div>
      <div id="master-action-error-msg" class="alert alert-danger d-none">
        <span id="master-action-error-text"></span>
      </div>
      <div id="master-action-error-end" class="d-none"></div>

      <div class="row g-3">
        <div class="col-md-6">
          <label for="master-add-user-newgroup" class="form-label">Add to Group</label>
          <select name="user_newgroup" id="master-add-user-newgroup" class="form-select"></select>
        </div>
        <div class="col-md-6">
          <label for="master-add-user" class="form-label">Username</label>
          <input type="text" name="add_user" id="master-add-user" placeholder="Username" class="form-control" required>
          <div class="form-text">8-20 characters</div>
        </div>
        <div class="col-md-6">
          <label for="master-add-pass" class="form-label">Password</label>
          <input type="password" name="add_pass" id="master-add-pass" placeholder="Password" class="form-control" required>
          <div class="form-text">8-20 characters</div>
        </div>
        <div class="col-md-6">
          <label for="master-add-re" class="form-label">Re - Password</label>
          <input type="password" name="add_re" id="master-add-re" placeholder="Re - Password" class="form-control" required>
          <div class="form-text">Same as password</div>
        </div>
      </div>

      <p class="text-primary small mt-3 mb-3">Use a-z, A-Z, 0-9, "-", "_", "@" or ".". Usernames cannot be duplicated.</p>
      <button type="button" class="btn btn-danger" id="master-add-member-btn"><i class="bi bi-person-plus"></i> Add</button>
    </div>
    <div id="master-no-add-section" class="d-none"></div>
  </section>

  <template id="master-group-option-template">
    <option value=""></option>
  </template>

  <template id="master-member-row-template">
    <tr class="line_hover">
      <td class="text-center">
        <input type="checkbox" name="" value="" title="" class="form-check-input master-member-check">
      </td>
      <td data-role="name-cell"></td>
      <td data-role="user-cell" class="text-center"></td>
      <td data-role="pass-cell" class="text-center"></td>
      <td data-role="operating-cell" class="text-center"></td>
      <td data-role="actions-cell" class="text-center">
        <div class="btn-group btn-group-sm" role="group">
          <button type="button" class="btn btn-outline-light border master-status-btn" title=""><img src="" alt="" width="18" height="18"></button>
          <a target="_blank" href="" title="View Personal Report" data-role="report-link" class="btn btn-outline-light border"><img src="/assets/images/icon/report.png" alt="" width="18" height="18"></a>
          <button type="button" class="btn btn-outline-light border master-left-btn" title="Move current group"><img src="/assets/images/icon/move.png" alt="" width="18" height="18"></button>
          <button class="btn btn-outline-light border modalInput master-edit-btn" rel="#prompt2" type="button" title="Edit Username and Password"><img src="/assets/images/icon/edit.png" alt="" width="18" height="18"></button>
          <button type="button" class="btn btn-outline-light border master-delete-btn" title="Delete this Sub Account from this Corporate Card"><img src="/assets/images/icon/bin.png" alt="" width="18" height="18"></button>
        </div>
      </td>
    </tr>
  </template>

  <template id="master-member-name-table-template">
    <div class="d-flex flex-wrap gap-2">
      <span data-role="fname"></span>
      <span data-role="lname"></span>
    </div>
  </template>

  <template id="master-member-name-empty-template">
    <span class="text-danger">-</span>
  </template>

  <template id="master-member-user-template">
    <strong data-role="text"></strong>
  </template>

  <template id="master-member-pass-template">
    <strong data-role="text"></strong>
  </template>

  <template id="master-pagination-link-template">
    <a href="#" class="btn btn-sm btn-outline-secondary master-page-link"><span></span></a>
  </template>

  <div class="modal fade modal1" id="prompt1" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form id="rename-group-form" onsubmit="event.preventDefault();">
          <div class="modal-header">
            <h2 class="modal-title h5">Rename Group</h2>
            <button type="button" class="btn-close close" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <label for="rename" class="form-label">Group name</label>
            <input type="text" name="rename" id="rename" class="form-control mb-2">
            <input type="text" name="idrename" id="idrename" readonly class="form-control d-none">
            <span id="txt_alert" class="text-danger d-none">ไม่สามารถเปลี่ยนชื่อ None Group ได้</span>
          </div>
          <div class="modal-footer">
            <input type="button" value="Cancel" class="close btn btn-outline-secondary">
            <input type="submit" id="btn_rename" value="Save" class="btn btn-danger">
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="modal fade modal1" id="prompt2" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form id="edit-sub-form" onsubmit="event.preventDefault();">
          <div class="modal-header">
            <h2 class="modal-title h5">Edit Sub Account</h2>
            <button type="button" class="btn-close close" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <label for="rename-subAcc" class="form-label">New Username</label>
            <input type="text" name="rename-subAcc" id="rename-subAcc" class="form-control mb-3">
            <input type="text" name="idre-sub" id="idre-sub" readonly class="form-control d-none">
            <label for="pass" class="form-label">New Password</label>
            <input type="password" name="pass" id="pass" class="form-control mb-3">
            <label for="re-pass" class="form-label">Re-New password</label>
            <input type="password" name="re-pass" id="re-pass" class="form-control mb-3">
            <div id="imgload" class="d-none"><img src="/assets/images/image2/eol system/loading2.gif" alt="Loading"></div>
            <div id="editerror" class="text-danger"></div>
          </div>
          <div class="modal-footer">
            <input type="button" value="Cancel" class="close btn btn-outline-secondary">
            <input type="submit" id="btn_rename_sub" value="Save" class="btn btn-danger">
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
