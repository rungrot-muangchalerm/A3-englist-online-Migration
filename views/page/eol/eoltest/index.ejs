  <!-- Rename Group modal -->
  <div class='modal1' id='prompt1'>
    <h2> Rename Group</h2>
    <form id='rename-group-form' onsubmit='event.preventDefault();'>
      <input type="text" name="rename" id="rename">
      <input type="text" name="idrename" id="idrename" readonly class="txt_rename">
      <br><br>
      <span> ไม่สามารถเปลี่ยนชื่อ None Group ได้ </span>
      <br>
      <input type="submit" id="btn_rename" value="Save" class="btntest btn-save" />
      <input type="button" value="Cancel" class="close btntest btn-cancel" />
    </form>
  </div>

  <!-- Edit Sub Account modal -->
  <div class='modal1' id='prompt2'>
    <h2> Edit Sub Account</h2>
    <form id='edit-sub-form' onsubmit='event.preventDefault();'>
      <b>New Username :</b> <input type="text" name="rename-subAcc" id="rename-subAcc">
      <input type="text" name="idre-sub" id="idre-sub" readonly class="txt_rename"><br><br>
      <b>New Password :</b><input type="password" name="pass" id="pass"><br><br>
      <b>Re-New password :</b><input type="password" name="re-pass" id="re-pass"><br><br><br>
      <div id="imgload"> <img src="/assets/images/image2/eol system/loading2.gif" /></div>
      <div id="editerror"></div>
      <input type="submit" id="btn_rename_sub" value="Save" class="btntest btn-save" />
      <input type="button" value="Cancel" class="close btntest btn-cancel" />
    </form>
  </div>
