<div id="view-academic" class="eol-view">
  <section class="bg-body-tertiary border rounded-3 shadow-sm p-3 p-lg-4 mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
      <div>
        <p class="text-danger fw-semibold mb-1">Test &amp; Evaluation</p>
        <h1 class="h3 fw-bold mb-2">Academic Skill Selector</h1>
        <p class="text-body-secondary mb-0">Select a skill, choose an unlocked level, and start the assessment.</p>
      </div>
      <a href="/eol/eoltest" class="btn btn-outline-secondary align-self-start">
        <i class="bi bi-arrow-left"></i> Back to System Page
      </a>
    </div>
  </section>

  <section class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="bg-body-tertiary border rounded-3 shadow-sm p-3 h-100">
        <div class="d-flex align-items-center gap-3">
          <span class="btn btn-danger rounded-circle"><i class="bi bi-list-check"></i></span>
          <div>
            <div class="text-body-secondary small">Skill groups</div>
            <div class="fs-5 fw-bold" id="academic-skill-count">Loading</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="bg-body-tertiary border rounded-3 shadow-sm p-3 h-100">
        <div class="d-flex align-items-center gap-3">
          <span class="btn btn-outline-danger rounded-circle"><i class="bi bi-unlock"></i></span>
          <div>
            <div class="text-body-secondary small">Available levels</div>
            <div class="fs-5 fw-bold" id="academic-unlocked-count">Loading</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="bg-body-tertiary border rounded-3 shadow-sm p-3 h-100">
        <div class="d-flex align-items-center gap-3">
          <span class="btn btn-outline-secondary rounded-circle"><i class="bi bi-lock"></i></span>
          <div>
            <div class="text-body-secondary small">Locked levels</div>
            <div class="fs-5 fw-bold" id="academic-locked-count">Loading</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div id="academic-app" class="row g-4">
    <template id="academic-level-row-template">
      <tr class="align-middle">
        <td class="ps-3">
          <span class="level-color badge rounded-pill text-bg-secondary">Level</span>
        </td>
        <td>
          <strong class="level-name"></strong>
        </td>
        <td class="level-message text-end small"></td>
        <td class="text-end">
          <input class="btn btn-sm btn-danger btn-goto-test" type="button" value="Start">
        </td>
      </tr>
    </template>

    <template id="academic-skill-row-template">
      <tr class="skill-row align-middle">
        <td colspan="4" class="p-0">
          <button type="button" class="btn w-100 text-start border-0 rounded-0 py-3 skill-toggle-a">
            <span class="d-flex align-items-center gap-3">
              <span class="btn btn-sm btn-outline-danger rounded-circle"><i class="bi bi-chevron-right"></i></span>
              <span class="fw-semibold skill-name"></span>
            </span>
          </button>
          <button type="button" class="btn w-100 text-start border-0 rounded-0 py-3 skill-toggle-b d-none">
            <span class="d-flex align-items-center gap-3">
              <span class="btn btn-sm btn-danger rounded-circle"><i class="bi bi-chevron-down"></i></span>
              <span class="fw-semibold skill-name"></span>
            </span>
          </button>
        </td>
      </tr>
      <tr class="level-list-row d-none">
        <td colspan="4" class="p-0">
          <div class="table-responsive">
            <table class="level-table table table-sm table-hover align-middle mb-0"></table>
          </div>
        </td>
      </tr>
    </template>

    <div class="col-xl-7">
      <section class="bg-body-tertiary border rounded-3 shadow-sm h-100">
        <div class="border-bottom p-3">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-list-check text-danger"></i>
            <h2 class="h5 fw-bold mb-0">Single Skill</h2>
          </div>
        </div>
        <div class="table-responsive">
          <table id="single-skills-table" class="table table-sm align-middle mb-0">
            <tbody id="single-skills-body">
              <tr>
                <td class="p-4 text-body-secondary">Loading skills...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <div class="col-xl-5">
      <section class="bg-body-tertiary border rounded-3 shadow-sm h-100">
        <div class="border-bottom p-3">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-layers text-danger"></i>
            <h2 class="h5 fw-bold mb-0">Multiple Skills</h2>
          </div>
        </div>
        <div class="table-responsive">
          <table id="multi-skills-table" class="table table-sm align-middle mb-0">
            <tbody id="multi-skills-body">
              <tr>
                <td class="p-4 text-body-secondary">Loading skills...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</div>
