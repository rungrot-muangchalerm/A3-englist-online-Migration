<div id="view-academic">
  <div id='academic-app'>
    <template id="academic-level-row-template">
      <tr height="32" class="align-middle">
        <td width="8%">&nbsp;</td>
        <td width="32%">
          <span class="text-dark"><b>
              <span>&raquo; <span class="level-name"></span></span>
            </b></span>
        </td>
        <td width="47%" class="level-message text-end"></td>
        <td width="13%" class="text-end">
          <input class="btn-goto-test" type="button" value=" Test ">
        </td>
      </tr>
    </template>

    <template id="academic-skill-row-template">
      <tr height="40" class="skill-row align-middle">
        <td colspan="2" class="bg-light">
          <div class="skill-toggle-a">
            <span class="text-dark"><b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&raquo; <span class="skill-name"></span> <br></b></span>
          </div>
          <div class="skill-toggle-b">
            <span class="text-dark"><b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&laquo; <span class="skill-name"></span> <br></b></span>
          </div>
        </td>
      </tr>
      <tr class="level-list-row">
        <td colspan="2" class="table-light">
          <table width="100%" class="level-table text-center table table-sm"></table>
        </td>
      </tr>
    </template>

    <div>
      <table width="970px" class="text-center table table-sm">
        <tr>
          <td width="60%">
            <table width="70%" id="single-skills-table" class="text-center table table-sm">
              <tr height="50" class="align-middle">
                <td colspan="2">
                  <span class="text-white"><b>&nbsp; &raquo; Single Skill</b></span><br>
                </td>
              </tr>
              <tbody id="single-skills-body"></tbody>
              <tr height="15" class="align-middle">
                <td colspan="2"></td>
              </tr>
              <tr height="25" class="align-middle">
                <td colspan="2"></td>
              </tr>
            </table>
            <table width="70%" id="multi-skills-table" class="text-center table table-sm">
              <tr height="50" class="align-middle">
                <td colspan="2">
                  <span class="text-white"><b>&nbsp; &raquo; Multiple Skills</b></span><br>
                </td>
              </tr>
              <tbody id="multi-skills-body"></tbody>
              <tr height="15" class="align-middle">
                <td colspan="2"></td>
              </tr>
              <tr height="10" class="align-middle">
                <td colspan="2"></td>
              </tr>
            </table>
          </td>
        </tr>
      </table><br>&nbsp;
    </div>
    <img src="/assets/images/image2/eol system/bg-test-evo1.png" width="100%">
  </div>
</div>