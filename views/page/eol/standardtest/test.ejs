<div id="standardtest-test-app" class="f-thai">
  <img src="/assets/images/image2/eol system/Standard Test/EST_head_test.png" class="head-img" alt="EST">

  <div class="timer-box">
    <div id="timer-display"></div>
  </div>

  <form id="quiz-form">
    <input type="hidden" id="time-left-input" name="time_left">
    <div id="questions-container" class="question-wrap"></div>

    <table width="90%" class="text-center table table-sm">
      <tr>
        <td width="15%" class="text-start">
          <img src="/assets/images/icon/back1.png" id="back-btn" alt="Back">
        </td>
        <td width="70%" class="text-center">
          <span class="text-danger">Red : Unanswer</span>
          &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
          <span class="text-success">Green : Answered</span>
          <br>
          <div id="page-numbers" class="page-nav"></div>
        </td>
        <td width="15%" class="text-end">
          <img src="/assets/images/icon/next1.png" id="next-btn" alt="Next">
        </td>
      </tr>
    </table>

    <table width="90%" class="text-center table table-sm">
      <tr height="20" class="align-middle">
        <td></td>
      </tr>
      <tr height="8" class="align-middle">
        <td></td>
      </tr>
      <tr height="75" class="align-middle">
        <td class="text-center">
          <img src="/assets/images/icon/finish1.png" id="finish-btn" class="finish-btn" alt="Finish">
        </td>
      </tr>
    </table>
  </form>
</div>