<div id="standardtest-test-app" class="f-thai">
  <style>
    #standardtest-test-app {
      font-family: 'IBM Plex Sans Thai', tahoma, sans-serif;
    }

    #standardtest-test-app .head-img {
      width: 80%;
      max-width: 100%;
      display: block;
      margin: 0 auto;
    }

    #standardtest-test-app .timer-box {
      width: 250px;
      margin: 10px auto;
      background: #eeeeee;
      border-radius: 6px;
      text-align: center;
      padding: 5px;
    }

    #standardtest-test-app .question-wrap {
      width: 90%;
      margin: 0 auto;
    }

    #standardtest-test-app .media-box {
      width: 90%;
      margin: 10px auto;
      padding: 10px;
      background: #fff;
      border-radius: 5px;
      text-align: center;
    }

    #standardtest-test-app .question-table {
      width: 90%;
      margin: 0 auto;
    }

    #standardtest-test-app .question-table td {
      padding: 5px;
      vertical-align: top;
    }

    #standardtest-test-app .answer-row label {
      font-size: 15px;
      cursor: pointer;
    }

    #standardtest-test-app .page-nav {
      width: 90%;
      margin: 15px auto;
      text-align: center;
      background: #fff;
      border-radius: 6px;
      padding: 10px 0;
    }

    #standardtest-test-app .page-nav a {
      cursor: pointer;
      margin: 0 2px;
      font-size: 13px;
    }

    #standardtest-test-app .page-nav .current {
      color: red;
      font-weight: bold;
    }

    #standardtest-test-app .page-nav .other {
      color: blue;
    }

    #standardtest-test-app .nav-buttons img {
      height: 40px;
      cursor: pointer;
    }

    #standardtest-test-app .finish-btn {
      cursor: pointer;
      width: 165px;
      height: 46px;
    }

    #standardtest-test-app .audio-trigger {
      cursor: pointer;
      color: blue;
      font-weight: bold;
    }

    #standardtest-test-app .played-msg {
      color: red;
      font-weight: bold;
    }
  </style>

  <img src="/assets/images/image2/eol system/Standard Test/EST_head_test.png" class="head-img" alt="EST">

  <div class="timer-box">
    <div id="timer-display"></div>
  </div>

  <form id="quiz-form">
    <input type="hidden" id="time-left-input" name="time_left">
    <div id="questions-container" class="question-wrap"></div>

    <table align="center" width="90%" cellpadding="5" cellspacing="0" border="0" style="background:#fff; border-radius:6px;">
      <tr>
        <td width="15%" align="left">
          <img src="/assets/images/icon/back1.png" id="back-btn" style="height:40px;cursor:pointer;" alt="Back">
        </td>
        <td width="70%" align="center">
          <font size="2" face="tahoma" color="red">Red : Unanswer</font>
          &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
          <font size="2" face="tahoma" color="green">Green : Answered</font>
          <br>
          <div id="page-numbers" class="page-nav"></div>
        </td>
        <td width="15%" align="right">
          <img src="/assets/images/icon/next1.png" id="next-btn" style="height:40px;cursor:pointer;" alt="Next">
        </td>
      </tr>
    </table>

    <table align="center" width="90%" cellpadding="0" cellspacing="0" border="0">
      <tr height="20">
        <td></td>
      </tr>
      <tr height="8">
        <td style="background:#777; border-radius:4px;"></td>
      </tr>
      <tr height="75">
        <td align="center">
          <img src="/assets/images/icon/finish1.png" id="finish-btn" class="finish-btn" alt="Finish">
        </td>
      </tr>
    </table>
  </form>
</div>