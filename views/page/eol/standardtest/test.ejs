<div id="standardtest-test-app">
  <section class="bg-body-tertiary border rounded-3 shadow-sm p-3 p-lg-4 mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
      <div>
        <p class="text-danger fw-semibold mb-1">EOL Standard Test</p>
        <h1 class="h3 fw-bold mb-0">EST Test Session</h1>
      </div>
      <div id="timer-display" class="alert alert-warning mb-0"></div>
    </div>
  </section>

  <form id="quiz-form">
    <input type="hidden" id="time-left-input" name="time_left">
    <div id="questions-container"></div>

    <section class="bg-body-tertiary border rounded-3 shadow-sm p-3 mb-4">
      <div class="d-flex flex-column flex-lg-row align-items-center justify-content-between gap-3">
        <button id="back-btn" type="button" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left"></i> Back
        </button>
        <div class="text-center">
          <div class="small mb-2">
            <span class="text-danger fw-semibold">Red : Unanswer</span>
            <span class="mx-2">|</span>
            <span class="text-success fw-semibold">Green : Answered</span>
          </div>
          <div id="page-numbers" class="d-flex flex-wrap justify-content-center gap-2"></div>
        </div>
        <button id="next-btn" type="button" class="btn btn-outline-secondary">
          Next <i class="bi bi-arrow-right"></i>
        </button>
      </div>
    </section>

    <div class="text-center">
      <button id="finish-btn" type="button" class="btn btn-success btn-lg">
        <i class="bi bi-check-circle"></i> Finish
      </button>
    </div>
  </form>
</div>
