<div id="test-app" class="f-thai">
  <div class="timer-box">
    <div id="timer-display"></div>
  </div>
  <table class="question-table table table-sm">
    <tr height="30" class="align-middle">
      <td width="90%" colspan="2">
        <span class="text-secondary"><b>Skill : <span id="question-skill"></span></b></span><br><br>
        <span><b>No. <span id="question-number"></span></b></span>
      </td>
      <td width="10%" class="text-end">&nbsp;</td>
    </tr>
    <tr id="media-row">
      <td colspan="3">
        <div id="media-content" class="media-box"></div>
      </td>
    </tr>
    <tr height="10" class="align-middle">
      <td colspan="3"></td>
    </tr>
    <tr>
      <td colspan="3">
        <span><b id="question-text"></b></span>
      </td>
    </tr>
    <tr height="10" class="align-middle">
      <td colspan="3"></td>
    </tr>
    <tr>
      <td colspan="3">
        <form id="answer-form">
          <input type="hidden" id="time-left-input" name="time_left">
          <div id="answers-list"></div>
          <div>
            <input type="submit" value=" Record your answer " class="record_answer">
          </div>
        </form>
      </td>
    </tr>
    <tr height="30" class="align-middle">
      <td colspan="3" class="text-center">
        <span class="text-dark"><b>Question Number</b></span>
      </td>
    </tr>
    <tr height="10" class="align-middle">
      <td colspan="3"></td>
    </tr>
    <tr>
      <td colspan="3" class="text-center">
        <div id="number-pad" class="number-pad"></div>
      </td>
    </tr>
    <tr>
      <td colspan="3">
        <table width="100%" class="table table-sm">
          <tr>
            <td width="10%" class="text-start"><button id="back-btn"><img src="/assets/images/image2/test/back.png"></button></td>
            <td width="80%" class="text-center">
              <span class="text-danger">Red : Unanswer</span>
              &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
              <span class="text-success">Green : Answered</span>
            </td>
            <td width="10%" class="text-end"><button id="next-btn"><img src="/assets/images/image2/test/next.png"></button></td>
          </tr>
        </table>
      </td>
    </tr>
    <tr height="10" class="align-middle">
      <td colspan="3"></td>
    </tr>
    <tr height="1" class="bg-secondary text-white align-middle">
      <td colspan="3"></td>
    </tr>
    <tr height="10" class="align-middle">
      <td colspan="3"></td>
    </tr>
    <tr>
      <td colspan="3" class="text-center">
        <button id="finish-btn"><img src="/assets/images/image2/test/finish.png" class="finish-btn"></button>
      </td>
    </tr>
  </table>
  <br>&nbsp;
</div>