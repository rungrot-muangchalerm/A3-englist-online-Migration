<div class="bg-light py-4">
    <div class="container-lg">
        <div class="row">
            <div class="col-12">
                <nav id="sub_menu" class="nav nav-pills justify-content-center flex-wrap gap-2 mb-4">
                    <a class="nav-link active" href="/shop/product-eol-member-club">สินค้า</a>
                    <a class="nav-link" href="/shop/payment">วิธีการสั่งซื้อ</a>
                    <a class="nav-link" href="/shop/policy-change-product">นโยบายการเปลี่ยนสินค้า</a>
                </nav>

                <div id="apDiv68" class="card border-0 border-top border-5 border-warning shadow-sm mb-4">
                    <div class="card-body">
                        <div id="apdiv3menubar" class="row g-3 justify-content-center">
                            <a class="col-6 col-md-4 col-lg-3 d-block text-center" href="/shop/product-eol-member-club">
                                <img class="img-fluid rounded" src="/assets/images/image2/about web/menu_icon/EOL-System-Club.jpg" alt="EOL Member Club">
                            </a>
                            <a class="col-6 col-md-4 col-lg-3 d-block text-center" href="/shop/product-personal">
                                <img class="img-fluid rounded" src="/assets/images/image2/about web/menu_icon/personal-new.jpg" alt="EOL Personal">
                            </a>
                            <a class="col-6 col-md-4 col-lg-3 d-block text-center" href="#">
                                <img class="img-fluid rounded" src="/assets/images/image2/about web/menu_icon/over-1year-course.jpg" alt="EOL 1 Year Course">
                            </a>
                            <a class="col-6 col-md-4 col-lg-3 d-block text-center" href="/shop/product-intelligence">
                                <img class="img-fluid rounded" src="/assets/images/image2/about web/menu_icon/Intelligence-package-new.jpg" alt="EOL Intelligence">
                            </a>
                            <a class="col-6 col-md-4 col-lg-3 d-block text-center" href="/shop/product-corporate">
                                <img class="img-fluid rounded" src="/assets/images/image2/about web/menu_icon/coporate-new.jpg" alt="EOL Corporate">
                            </a>
                        </div>
                    </div>
                </div>

                <div id="apDiv69" class="card border-0 border-top border-5 border-warning shadow-sm mb-4">
                    <div class="card-body text-center">
                        <h2 class="card-title h3"><strong>EOL 1 YEAR COURSE</strong><br>
                            <span class="text-muted">เรียนตามหลักสูตรต่อเนื่อง 52 สัปดาห์</span>
                        </h2>
                        <hr>
                    </div>
                </div>

                <div class="text_paragraph"></div>

                <% if (typeof products !== 'undefined' && products.length > 0) { %>
                    <% products.forEach(function(product) { %>
                        <div class="card border-0 border-top border-5 border-warning shadow-sm mb-4">
                            <div class="card-body">
                                <div class="row g-4 align-items-center">
                                    <div class="col-12 col-md-5 text-center">
                                        <img src="/assets/images/shop/products/<%= product.product_image %>" class="img-fluid rounded" alt="<%= product.product_name %>">
                                    </div>
                                    <div class="col-12 col-md-7">
                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item px-0">
                                                <div class="row align-items-center g-2">
                                                    <div class="col-2 text-center">
                                                        <img src="/assets/images/shop/products/icon-card.png" class="img-fluid" alt="">
                                                    </div>
                                                    <div class="col-10">
                                                        <%= product.product_name %>
                                                    </div>
                                                </div>
                                            </li>
                                            <li class="list-group-item px-0">
                                                <div class="row align-items-center g-2">
                                                    <div class="col-2 text-center">
                                                        <img src="/assets/images/shop/products/icon-refill.png" class="img-fluid" alt="">
                                                    </div>
                                                    <div class="col-10">
                                                        <%= product.product_detail %>
                                                    </div>
                                                </div>
                                            </li>
                                            <li class="list-group-item px-0">
                                                <div class="row align-items-center g-2">
                                                    <div class="col-2 text-center">
                                                        <img src="/assets/images/shop/products/icon-money.png" class="img-fluid" alt="">
                                                    </div>
                                                    <div class="col-10">
                                                        2,929 Baht
                                                    </div>
                                                </div>
                                            </li>
                                            <li class="list-group-item px-0">
                                                <input type="button" class="btn btn-warning w-100 purchase_item" value="สั่งซื้อ">
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } %>

                <div class="card border-0 border-top border-5 border-warning shadow-sm mb-4">
                    <div class="card-body">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item">
                                <span class="fw-bold">Expire date</span> : ต้องใช้งานภายใน 365 วัน หลังจาก Login วันแรกเท่านั้น
                            </li>
                        </ul>
                    </div>
                </div>

                <a class="link_shortcut btn btn-warning d-inline-block my-3 text-decoration-none" href="/eol_system/oneyear">WHAT IS EOL 1 YEAR COURSE?</a>
            </div>
        </div>
    </div>
</div>
