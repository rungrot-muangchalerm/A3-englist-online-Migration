<div class="main-academic" id="admin-gepot-pdf-app">
  <br><br>
  <div align="center" class="f-thai">
    <br><br>
    <a href="/backoffice/mainoffice/admin/check-question-amount">[Check Question Amount]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/check-reason-index-details">[Check Reason Index and Details]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/check-questions-list">[Check Questions List]</a>&nbsp;&nbsp;
    <br><br>
    <a href="/backoffice/mainoffice/admin/extra-test-system">[Extra Test System]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/analyze-quiz">[Analyze Quiz]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/quiz-comment">[Quiz Comment]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/lessons-related">[Lessons & Related]</a>&nbsp;&nbsp;
    <br><br>
    <a href="/backoffice/mainoffice/admin/monthly-report">[Monthly Report]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/export-report-gepot-excel">[Export Report GEPOT Excel]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/export-report-gepot-pdf">[Export Report GEPOT PDF]</a>&nbsp;&nbsp;
    <br><br><br>
    <hr>
  </div>

  <br><br>
  <form method="get" action="/backoffice/mainoffice/admin/export-report-gepot-pdf" accept-charset="UTF-8" align="center" class="f-thai">
    <table align="center" width="40%" bgcolor="#f0f0f0" cellpadding="0" cellspacing="0" border="1" style="margin: 0 auto;" class="f-thai">
      <tr height="20" valign="middle">
        <td width="8%" align="center"><input type="text" name="username" id="admin-gepot-pdf-username" placeholder="Username" autocomplete="username" required></td>
        <td width="3%" align="center"><input name="view_id" type="submit" value="Search" class="btn-set-relate"></td>
      </tr>
    </table>
  </form>

  <br>
  <form method="get" action="/backoffice/mainoffice/admin/export-report-gepot-pdf" accept-charset="UTF-8" align="center" class="f-thai">
    <table align="center" width="72%" bgcolor="#f0f0f0" cellpadding="0" cellspacing="0" border="1" style="margin: 0 auto;" class="f-thai">
      <tr height="50" valign="middle">
        <td align="center" width="11%"><font size="2" color="black"><b>From &nbsp; : &nbsp;</b></font></td>
        <td width="10%" align="center"><input type="text" name="start_username" id="admin-gepot-pdf-start-username" placeholder="Username" required></td>
        <td align="center" width="10%"><font size="2" color="black"><b>Until &nbsp; : &nbsp;</b></font></td>
        <td width="10%" align="center"><input type="text" name="end_username" id="admin-gepot-pdf-end-username" placeholder="Username" required></td>
        <td width="3%" align="center"><input name="view_from_util" type="submit" value="Search" class="btn-set-relate"></td>
      </tr>
    </table>
  </form>
  <br>

  <div id="admin-gepot-pdf-export-button" style="display:none;">
    <table align="center" width="14%" cellspacing="2" border="0" style="margin: 0 auto;" class="f-thai">
      <tr>
        <td width="7%">
          <form method="post" action="/api/backoffice/admin/export-report-gepot-pdf" accept-charset="UTF-8" align="center" target="_blank">
            <input type="hidden" name="member_id" data-export="pdf-member-id">
            <input type="hidden" name="start_username" data-export="pdf-start-username">
            <input type="hidden" name="end_username" data-export="pdf-end-username">
            <input type="submit" value="Export To PDF" class="btn-add">
          </form>
        </td>
      </tr>
    </table>
  </div>

  <div id="admin-gepot-pdf-not-found" align="center" class="f-thai" style="display:none;">
    <font size="4" color="red"><b> Not found. </b></font>
  </div>

  <div id="admin-gepot-pdf-report-list"></div>

  <template id="admin-gepot-pdf-card-template">
    <div>
      <table align="center" width="90%" cellpadding="5" cellspacing="0" border="0" bgcolor="#f7f7f7" style="margin: 0 auto;" class="f-thai">
        <tr height="25">
          <td width="2%" align="right"><font size="2" color="black"><b data-role="no"></b></font></td>
          <td width="20%" align="right"><font size="2" color="black"><b>ผู้ทำแบบทดสอบ &nbsp; : &nbsp; </b></font></td>
          <td width="70%" align="left" colspan="3"><font size="2" color="black"><b>&nbsp; <span data-role="full-name"></span> </b></font></td>
        </tr>
        <tr height="25">
          <td></td>
          <td align="right"><font size="2" color="black"><b>วันที่ทำการทดสอบ &nbsp; : &nbsp; </b></font></td>
          <td align="left"><font size="2" color="black"><b>&nbsp; <span data-role="date"></span> </b></font></td>
        </tr>
        <tr height="25">
          <td></td>
          <td align="right"><font size="2" color="black"><b>ประเภทการทดสอบ &nbsp; : &nbsp;</b></font></td>
          <td align="left"><font size="2" color="black"><b>&nbsp; <span data-role="test-type"></span></b></font></td>
        </tr>
        <tr height="25">
          <td></td>
          <td align="right"><font size="2" color="black"><b>คะแนนที่ได้ &nbsp; : &nbsp; </b></font></td>
          <td align="left">
            <font size="2" color="black"><b>
              &nbsp; ตอบถูก <span data-role="correct"></span> ข้อ &nbsp; &nbsp; ตอบผิด <span data-role="wrong"></span> ข้อ &nbsp; &nbsp; ไม่ได้ตอบ <span data-role="unanswered"></span> ข้อ &nbsp; &nbsp; คิดเป็น <span data-role="percent"></span> %
            </b></font>
          </td>
        </tr>
      </table>
      <table align="center" width="90%" cellpadding="5" cellspacing="2" border="0" style="margin: 0 auto;" class="f-thai">
        <tr height="25">
          <td align="center" width="20%" bgcolor="#aaaaaa"><font size="2" color="#ffffff"><b>ทักษะ ( Skill )</b></font></td>
          <td align="center" width="45%" bgcolor="#aaaaaa" colspan="3"><font size="2" color="#ffffff"><b>คะแนน ( Score )</b></font></td>
          <td align="center" bgcolor="#aaaaaa"><font size="2" color="#ffffff"><b>ระดับความสามารถ ( Level )</b></font></td>
          <td align="center" bgcolor="#aaaaaa"><font size="2" color="#ffffff"><b>CEFR</b></font></td>
        </tr>
        <tbody data-role="skills"></tbody>
      </table>
      <br>
    </div>
  </template>

  <template id="admin-gepot-pdf-skill-template">
    <tbody>
      <tr height="25">
        <td align="center" bgcolor="#e0e0e0" rowspan="2"><font size="2"><b data-role="skill-name"></b></font></td>
        <td align="center" bgcolor="#e0e0e0"><font size="2">ตอบถูก <span data-role="skill-correct"></span> ข้อ </font></td>
        <td align="center" bgcolor="#e0e0e0"><font size="2">ตอบผิด <span data-role="skill-wrong"></span> ข้อ </font></td>
        <td align="center" bgcolor="#e0e0e0"><font size="2">ไม่ได้ตอบ <span data-role="skill-unanswered"></span> ข้อ </font></td>
        <td align="center" bgcolor="#e0e0e0" rowspan="2"><font size="2" data-role="skill-level"></font></td>
        <td align="center" bgcolor="#e0e0e0" rowspan="2"><font size="2" data-role="skill-cefr"></font></td>
      </tr>
      <tr height="25">
        <td align="center" bgcolor="#e0e0e0" colspan="3"><font size="2"><b>คิดเป็น <span data-role="skill-score"></span> / <span data-role="skill-total"></span> คะแนน </b></font></td>
      </tr>
    </tbody>
  </template>
</div>

