  <div id="admin-analyze-list">
    <template id="admin-analyze-row-template">
      <table width="100%" class="f-thai text-center table table-sm">
        <tr height="25" class="align-middle">
          <td rowspan="2" width="10%" class="text-center bg-secondary text-white">
            <span class="text-white"><b data-role="no"></b></span>
          </td>
          <td rowspan="2" width="10%" class="text-center bg-light">
            <span class="text-primary">Quiz ID<br><br>[ <span data-role="question-id"></span> ]</span><br><br>
            <a data-role="detail-link" target="_blank"><button type="button" class="btn-set-relate">&nbsp;Details&nbsp;</button></a>
          </td>
          <td width="80%" data-role="summary-cell" class="text-start">&nbsp;<span class="text-warning">[Answer Correct ID : <span data-role="correct-answer-id"></span>] - [All Answer : <span data-role="total-answers"></span>]</span>
          </td>
        </tr>
        <tr data-role="answer-panel">
          <td>
            <div data-role="answers"></div>
            <table width="100%" class="text-center table table-sm">
              <tr>
                <td width="30%" class="text-start">&nbsp;&nbsp;<span class="text-success">Unanswered</span>
                </td>
                <td width="30%" class="text-start">&nbsp;&nbsp;<span class="text-success">Amount : <span data-role="unanswered-amount"></span></span>
                </td>
                <td width="40%" class="text-start">&nbsp;&nbsp;<span class="text-success">Percent : <span data-role="unanswered-percent"></span> %</span>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
      <br>
    </template>
    <template id="admin-analyze-answer-template">
      <table width="100%" class="text-center table table-sm">
        <tr>
          <td width="30%" class="text-start">&nbsp;&nbsp;<span></span>
          </td>
          <td width="30%" class="text-start">&nbsp;&nbsp;<span></span>
          </td>
          <td width="40%" class="text-start">&nbsp;&nbsp;<span></span>
          </td>
        </tr>
      </table>
    </template>
