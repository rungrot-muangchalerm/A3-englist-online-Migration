  <div id="admin-lessons-related-panel" style="display:none;">
    <div align="center" class="f-thai">
      <font color="green" size="4"><b id="admin-lessons-related-skill-name"></b></font><br>&nbsp;
    </div>

    <div id="admin-lessons-related-list">
      <template id="admin-lessons-related-template">
        <table align="center" width="100%" cellpadding="5" cellspacing="0" border="0" class="f-thai">
          <tr height="25" bgcolor="#f0f0f0">
            <td width="8%" align="center" rowspan="2">
              <font size="2"><b data-role="no"></b></font>
            </td>
            <td align="left" width="80%">
              <font size="2"><b> Reason Detail : [<span data-role="reason-id"></span>] <span data-role="reason-name"></span> </b></font>
            </td>
            <td align="center" width="12%" rowspan="2">
              <font size="2" color="red"><b> &laquo; Delete &raquo; </b></font>
            </td>
          </tr>
          <tr height="25" bgcolor="#f0f0f0">
            <td align="left">
              <font size="2"><b> Elearning Topic : [<span data-role="topic-id"></span>] <span data-role="topic-name"></span> </b></font>
            </td>
          </tr>
          <tr height="10" bgcolor="white">
            <td colspan="3"></td>
          </tr>
        </table>
      </template>
    </div>

    <div align="center" class="f-thai" id="admin-lessons-related-empty" style="display:none;">
      <br><br>
      <font size="3" color="red"><b>[ No Relate Reason with Elearning in this Skill ]</b></font><br><br>&nbsp;
    </div>

    <br>
    <form class="f-thai">
      <table align="center" width="60%" bgcolor="#f0f0f0" border="0" class="f-thai" style="margin: 0 auto; padding: 0 10px;">
        <tr height="70">
          <td width="15%" align="right">
            <font size="2"><b>Reason ID</b></font>
          </td>
          <td width="10%" align="center">
            <font size="2"><b> : </b></font>
          </td>
          <td width="15%" align="left"><input type="number" size="5" disabled></td>
          <td width="15%" align="right">
            <font size="2"><b>Topic ID</b></font>
          </td>
          <td width="10%" align="center">
            <font size="2"><b> : </b></font>
          </td>
          <td width="15%" align="left"><input type="number" size="5" disabled></td>
          <td width="20%" align="center"><input type="button" value=" Add Relation " class="btn-add" disabled></td>
        </tr>
      </table>
    </form><br>&nbsp;
  </div>
</div>