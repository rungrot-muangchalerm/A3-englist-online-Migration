<div class="main-academic" id="admin-lessons-related-app" data-skill-path="<%= typeof skillPath !== 'undefined' ? skillPath : '' %>">
  <br><br>
  <div class="f-thai text-center">
    <br><br>
    <a href="/backoffice/mainoffice/admin/check-question-amount">[Check Question Amount]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/check-reason-index-details">[Check Reason Index and Details]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/check-questions-list">[Check Questions List]</a>&nbsp;&nbsp;
    <br><br>
    <a href="/backoffice/mainoffice/admin/extra-test-system">[Extra Test System]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/analyze-quiz">[Analyze Quiz]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/quiz-comment">[Quiz Comment]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/lessons-related">[Lessons & Related]</a>&nbsp;&nbsp;
    <br><br>
    <a href="/backoffice/mainoffice/admin/monthly-report">[Monthly Report]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/export-report-gepot-excel">[Export Report GEPOT Excel]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/export-report-gepot-pdf">[Export Report GEPOT PDF]</a>&nbsp;&nbsp;
    <br><br><br>
    <hr>
  </div>

  <br>
  <div class="f-thai text-center">
    <a href="/backoffice/mainoffice/admin/lessons-related/reading">[ Reading ]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/lessons-related/listening">[ Listening ]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/lessons-related/semi-speaking">[ Semi-Speaking ]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/lessons-related/semi-writing">[ Semi-Writing ]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/lessons-related/grammatical">[ Grammatical ]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/lessons-related/integrated-skill">[ Integrated Skill ]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/lessons-related/vocabulary">[ Vocabulary ]</a>
  </div>
  <br><br>

  <div id="admin-lessons-related-panel">
    <div class="f-thai text-center">
      <span class="text-success"><b id="admin-lessons-related-skill-name"></b></span><br>&nbsp;
    </div>

    <div id="admin-lessons-related-list">
      <template id="admin-lessons-related-template">
        <table width="100%" class="f-thai text-center table table-sm">
          <tr height="25" class="bg-light align-middle">
            <td width="8%" rowspan="2" class="text-center">
              <span><b data-role="no"></b></span>
            </td>
            <td width="80%" class="text-start">
              <span><b> Reason Detail : [<span data-role="reason-id"></span>] <span data-role="reason-name"></span> </b></span>
            </td>
            <td width="12%" rowspan="2" class="text-center">
              <span class="text-danger"><b> &laquo; Delete &raquo; </b></span>
            </td>
          </tr>
          <tr height="25" class="bg-light align-middle">
            <td class="text-start">
              <span><b> Elearning Topic : [<span data-role="topic-id"></span>] <span data-role="topic-name"></span> </b></span>
            </td>
          </tr>
          <tr height="10" class="bg-light align-middle">
            <td colspan="3"></td>
          </tr>
        </table>
      </template>
    </div>

    <div class="f-thai text-center" id="admin-lessons-related-empty">
      <br><br>
      <span class="text-danger"><b>[ No Relate Reason with Elearning in this Skill ]</b></span><br><br>&nbsp;
    </div>

    <br>
    <form class="f-thai">
      <table width="60%" class="f-thai text-center bg-light table table-sm">
        <tr height="70" class="align-middle">
          <td width="15%" class="text-end">
            <span><b>Reason ID</b></span>
          </td>
          <td width="10%" class="text-center">
            <span><b> : </b></span>
          </td>
          <td width="15%" class="text-start"><input type="number" size="5" disabled></td>
          <td width="15%" class="text-end">
            <span><b>Topic ID</b></span>
          </td>
          <td width="10%" class="text-center">
            <span><b> : </b></span>
          </td>
          <td width="15%" class="text-start"><input type="number" size="5" disabled></td>
          <td width="20%" class="text-center"><input type="button" value=" Add Relation " class="btn-add" disabled></td>
        </tr>
      </table>
    </form><br>&nbsp;
  </div>
</div>
