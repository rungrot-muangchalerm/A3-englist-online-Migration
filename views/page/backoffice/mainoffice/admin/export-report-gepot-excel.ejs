<div class="main-academic" id="admin-gepot-excel-app">
  <br><br>
  <div class="f-thai text-center">
    <br><br>
    <a href="/backoffice/mainoffice/admin/check-question-amount">[Check Question Amount]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/check-reason-index-details">[Check Reason Index and Details]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/check-questions-list">[Check Questions List]</a>&nbsp;&nbsp;
    <br><br>
    <a href="/backoffice/mainoffice/admin/extra-test-system">[Extra Test System]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/analyze-quiz">[Analyze Quiz]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/quiz-comment">[Quiz Comment]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/lessons-related">[Lessons & Related]</a>&nbsp;&nbsp;
    <br><br>
    <a href="/backoffice/mainoffice/admin/monthly-report">[Monthly Report]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/export-report-gepot-excel">[Export Report GEPOT Excel]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/export-report-gepot-pdf">[Export Report GEPOT PDF]</a>&nbsp;&nbsp;
    <br><br><br>
    <hr>
  </div>

  <br><br>
  <form method="get" action="/backoffice/mainoffice/admin/export-report-gepot-excel" accept-charset="UTF-8" class="f-thai text-center">
    <table width="40%" class="f-thai text-center bg-light table table-sm">
      <tr height="20" class="align-middle">
        <td width="8%" class="text-center"><input type="text" name="username" id="admin-gepot-username" placeholder="Username" required></td>
        <td width="3%" class="text-center"><input name="view_id" type="submit" value="Search" class="btn-set-relate"></td>
      </tr>
    </table>
  </form>

  <br>
  <form method="get" action="/backoffice/mainoffice/admin/export-report-gepot-excel" accept-charset="UTF-8" class="f-thai text-center">
    <table width="72%" class="f-thai text-center bg-light table table-sm">
      <tr height="50" class="align-middle">
        <td width="13%" class="text-center">
          <span class="text-dark"><b>From &nbsp; : &nbsp;</b></span>
        </td>
        <td width="10%" class="text-center"><input type="text" name="start_username" id="admin-gepot-start-username" placeholder="Username" required></td>
        <td width="13%" class="text-center">
          <span class="text-dark"><b>Until &nbsp; : &nbsp;</b></span>
        </td>
        <td width="10%" class="text-center"><input type="text" name="end_username" id="admin-gepot-end-username" placeholder="Username" required></td>
        <td width="3%" class="text-center"><input name="view_from_util" type="submit" value="Search" class="btn-set-relate"></td>
      </tr>
    </table>
  </form>
  <br>

  <div id="admin-gepot-export-buttons">
    <table width="14%" class="f-thai text-center table table-sm">
      <tr>
        <td width="7%">
          <form method="post" action="/api/backoffice/admin/export-report-gepot-excel/full" accept-charset="UTF-8" class="text-center">
            <input type="hidden" name="member_id" data-export="full-member-id">
            <input type="hidden" name="start_username" data-export="full-start-username">
            <input type="hidden" name="end_username" data-export="full-end-username">
            <input type="submit" value="Full Export" class="btn-add">
          </form>
        </td>
        <td width="7%">
          <form method="post" action="/api/backoffice/admin/export-report-gepot-excel/summary" accept-charset="UTF-8" class="text-center">
            <input type="hidden" name="member_id" data-export="summary-member-id">
            <input type="hidden" name="start_username" data-export="summary-start-username">
            <input type="hidden" name="end_username" data-export="summary-end-username">
            <input type="submit" value="Summary Export" class="btn-add">
          </form>
        </td>
      </tr>
    </table>
  </div>

  <div id="admin-gepot-not-found" class="f-thai text-center">
    <span class="text-danger"><b> Not found. </b></span>
  </div>

  <div id="admin-gepot-report-list"></div>

  <template id="admin-gepot-card-template">
    <div>
      <center data-role="cover"><img src="/assets/images/image2/gepot/GEPOT-4.webp" alt="GEPOT"><br><br>
    </div>
    <table width="90%" class="f-thai text-center table-light table table-sm">
      <tr height="25" class="align-middle">
        <td width="2%" class="text-end">
          <span class="text-dark"><b data-role="no"></b></span>
        </td>
        <td width="20%" class="text-end">
          <span class="text-dark"><b>ผู้ทำแบบทดสอบ &nbsp; : &nbsp; </b></span>
        </td>
        <td width="70%" colspan="3" class="text-start">
          <span class="text-dark"><b>&nbsp; <span data-role="full-name"></span> </b></span>
        </td>
      </tr>
      <tr height="25" class="align-middle">
        <td data-role="no-spacer"></td>
        <td class="text-end">
          <span class="text-dark"><b>วันที่ทำการทดสอบ &nbsp; : &nbsp; </b></span>
        </td>
        <td class="text-start">
          <span class="text-dark"><b>&nbsp; <span data-role="date"></span> </b></span>
        </td>
      </tr>
      <tr height="25" class="align-middle">
        <td data-role="type-spacer"></td>
        <td class="text-end">
          <span class="text-dark"><b>ประเภทการทดสอบ &nbsp; : &nbsp;</b></span>
        </td>
        <td class="text-start">
          <span class="text-dark"><b>&nbsp; <span data-role="test-type"></span></b></span>
        </td>
      </tr>
      <tr height="25" class="align-middle">
        <td data-role="score-spacer"></td>
        <td class="text-end">
          <span class="text-dark"><b>คะแนนที่ได้ &nbsp; : &nbsp; </b></span>
        </td>
        <td class="text-start">
          <span class="text-dark"><b>
              &nbsp; ตอบถูก <span data-role="correct"></span> ข้อ &nbsp; &nbsp; ตอบผิด <span data-role="wrong"></span> ข้อ &nbsp; &nbsp; ไม่ได้ตอบ <span data-role="unanswered"></span> ข้อ &nbsp; &nbsp; คิดเป็น <span data-role="percent"></span> %
            </b></span>
        </td>
      </tr>
    </table>
    <table width="90%" class="f-thai text-center table table-sm">
      <tr height="25" class="align-middle">
        <td width="20%" class="text-center bg-secondary text-white">
          <span><b>ทักษะ ( Skill )</b></span>
        </td>
        <td width="45%" colspan="3" class="text-center bg-secondary text-white">
          <span><b>คะแนน ( Score )</b></span>
        </td>
        <td class="text-center bg-secondary text-white">
          <span><b>ระดับความสามารถ ( Level )</b></span>
        </td>
        <td class="text-center bg-secondary text-white">
          <span><b>CEFR</b></span>
        </td>
      </tr>
      <tbody data-role="skills"></tbody>
    </table>
    <br>
</div>
</template>

<template id="admin-gepot-skill-template">
  <tbody>
    <tr height="25" class="align-middle">
      <td rowspan="2" class="text-center bg-secondary-subtle">
        <span><b data-role="skill-name"></b></span>
      </td>
      <td class="text-center bg-secondary-subtle">
        <span>ตอบถูก <span data-role="skill-correct"></span> ข้อ </span>
      </td>
      <td class="text-center bg-secondary-subtle">
        <span>ตอบผิด <span data-role="skill-wrong"></span> ข้อ </span>
      </td>
      <td class="text-center bg-secondary-subtle">
        <span>ไม่ได้ตอบ <span data-role="skill-unanswered"></span> ข้อ </span>
      </td>
      <td rowspan="2" class="text-center bg-secondary-subtle">
        <span></span>
      </td>
      <td rowspan="2" class="text-center bg-secondary-subtle">
        <span></span>
      </td>
    </tr>
    <tr height="25" class="align-middle">
      <td colspan="3" class="text-center bg-secondary-subtle">
        <span><b>คิดเป็น <span data-role="skill-score"></span> / <span data-role="skill-total"></span> คะแนน </b></span>
      </td>
    </tr>
  </tbody>
</template>
</div>
