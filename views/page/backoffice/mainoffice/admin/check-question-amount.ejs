  <table width="100%" class="f-thai admin-question-table text-center table table-sm">
    <thead>
      <tr height="50" class="align-middle">
        <td colspan="7" class="text-center">
          <span><b>Academic Room</b></span>
        </td>
      </tr>
      <tr height="45" class="table-light align-middle">
        <td width="15%" class="text-center">
          <span><b>Skill</b></span>
        </td>
        <td width="14%" class="text-center">
          <span><b>Beginner</b></span>
        </td>
        <td width="14%" class="text-center">
          <span><b>Lower Inter.</b></span>
        </td>
        <td width="14%" class="text-center">
          <span><b>Intermediate</b></span>
        </td>
        <td width="14%" class="text-center">
          <span><b>Upper Inter.</b></span>
        </td>
        <td width="14%" class="text-center">
          <span><b>Advanced</b></span>
        </td>
        <td width="15%" class="text-center">
          <span class="text-danger"><b>Total</b></span>
        </td>
      </tr>
    </thead>
    <tbody id="admin-question-amount-list">
      <template id="admin-question-amount-template">
        <tr height="35" class="align-middle">
          <td class="text-center">
            <span><b data-role="skill-name"></b></span>
          </td>
          <td class="text-center">
            <span class="text-success"><b data-role="level-1-online"></b></span> + <span class="text-danger"><b data-role="level-1-offline"></b></span> = <span class="text-primary"><b data-role="level-1-total"></b></span>
          </td>
          <td class="text-center">
            <span class="text-success"><b data-role="level-2-online"></b></span> + <span class="text-danger"><b data-role="level-2-offline"></b></span> = <span class="text-primary"><b data-role="level-2-total"></b></span>
          </td>
          <td class="text-center">
            <span class="text-success"><b data-role="level-3-online"></b></span> + <span class="text-danger"><b data-role="level-3-offline"></b></span> = <span class="text-primary"><b data-role="level-3-total"></b></span>
          </td>
          <td class="text-center">
            <span class="text-success"><b data-role="level-4-online"></b></span> + <span class="text-danger"><b data-role="level-4-offline"></b></span> = <span class="text-primary"><b data-role="level-4-total"></b></span>
          </td>
          <td class="text-center">
            <span class="text-success"><b data-role="level-5-online"></b></span> + <span class="text-danger"><b data-role="level-5-offline"></b></span> = <span class="text-primary"><b data-role="level-5-total"></b></span>
          </td>
          <td class="text-center"><b>
              <span class="text-success"><b data-role="online-total"></b></span> + <span class="text-danger"><b data-role="offline-total"></b></span> = <span class="text-primary"><b data-role="total"></b></span>
            </b></td>
        </tr>
      </template>
    </tbody>
  </table>

  <br><br>
  <div class="f-thai text-center">
    <p>Description in Questions</p>
    <div id="admin-question-description-list">
      <template id="admin-question-description-template">
        <span>
          <span class="text-dark"><span data-role="skill-name"></span> : <span data-role="amount"></span></span>
          <span class="text-dark">&nbsp;||&nbsp;</span>
        </span>
      </template>
    </div>
  </div>
</div>
