<div class="main-academic" id="admin-quiz-comment-app" data-page-mode="<%= pageMode %>" data-quiz-id="<%= typeof quizId !== 'undefined' ? quizId : '' %>">
  <br><br>
  <div class="f-thai text-center">
    <br><br>
    <a href="/backoffice/mainoffice/admin/check-question-amount">[Check Question Amount]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/check-reason-index-details">[Check Reason Index and Details]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/check-questions-list">[Check Questions List]</a>&nbsp;&nbsp;
    <br><br>
    <a href="/backoffice/mainoffice/admin/extra-test-system">[Extra Test System]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/analyze-quiz">[Analyze Quiz]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/quiz-comment">[Quiz Comment]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/lessons-related">[Lessons & Related]</a>&nbsp;&nbsp;
    <br><br>
    <a href="/backoffice/mainoffice/admin/monthly-report">[Monthly Report]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/export-report-gepot-excel">[Export Report GEPOT Excel]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/export-report-gepot-pdf">[Export Report GEPOT PDF]</a>&nbsp;&nbsp;
    <br><br><br>
    <hr>
  </div>

  <div id="admin-quiz-comment-list-panel">
    <br><br>&nbsp;&nbsp; <span class="text-dark">Page : &nbsp;</span><span id="admin-quiz-comment-pages"></span>
    <br>
    <br><br>
    <div class="f-thai text-center">
      <span class="text-success"><b>Display quiz have comment [ <span id="admin-quiz-comment-total"></span> ]</b></span>
    </div><br><br>
    <table width="100%" class="f-thai text-center table table-sm">
      <tr height="55" class="bg-light align-middle">
        <td width="5%" class="text-center">
          <span><b>No.</b></span>
        </td>
        <td width="10%" class="text-center">
          <span><b>Quiz ID</b></span>
        </td>
        <td width="25%" class="text-center">
          <span><b>Skill</b></span>
        </td>
        <td width="25%" class="text-center">
          <span><b>Level</b></span>
        </td>
        <td width="25%" class="text-center">
          <span><b>[ Unanswered / Answered ]</b></span>
        </td>
        <td width="10%" class="text-center">
          <span><b>Status</b></span>
        </td>
      </tr>
    </table>
    <div id="admin-quiz-comment-list">
      <template id="admin-quiz-comment-row-template">
        <table width="100%" class="f-thai text-center table table-sm">
          <tr height="45" data-role="row" class="align-middle">
            <td width="5%" class="text-center">
              <span></span>
            </td>
            <td width="10%" class="text-center">
              <span class="text-primary"></span>
            </td>
            <td width="25%" class="text-center">
              <span class="text-warning"></span>
            </td>
            <td width="25%" class="text-center">
              <span></span>
            </td>
            <td width="25%" class="text-center">
              <span>[ <span data-role="unanswered"></span> / <span data-role="answered"></span> ]</span>
            </td>
            <td width="10%" class="text-center"><a data-role="detail-link"><b data-role="status"></b></a></td>
          </tr>
        </table>
      </template>
    </div>
    <br>
    <div class="f-thai text-center"><a href="#">
        <span class="text-primary">Go to Top</span>
      </a></div>
  </div>

  <div id="admin-quiz-comment-detail-panel">
    <br><br>
    <div class="f-thai text-center">
      <span class="text-success"><b>Quiz Comment List</b></span>
    </div><br><br>
    <table width="100%" class="f-thai text-center table table-sm">
      <tr class="text-center">
        <td colspan="2" class="text-start">
          <span class="text-warning">&nbsp;&nbsp;<span id="admin-quiz-comment-path"></span></span>
        </td>
      </tr>
      <tr>
        <td rowspan="3" width="10%" id="admin-quiz-comment-question-id" class="text-center"></td>
        <td width="90%" class="text-start">
          <span class="text-success">None Relate File or Passage</span>
        </td>
      </tr>
      <tr>
        <td width="100%" class="text-start bg-light">
          <span></span><br>&nbsp;
        </td>
      </tr>
      <tr>
        <td width="90%" class="text-start"><br>
          <div id="admin-quiz-comment-answer-list"></div>
        </td>
      </tr>
      <tr>
        <td colspan="2">
          <span><b>&nbsp;Description : <br></b></span>
          <span class="text-primary"></span>
          <div id="admin-quiz-comment-no-description" class="text-center">
            <span class="text-danger"><b> - None Description - </b></span>
          </div><br>
        </td>
      </tr>
    </table>
    <br><br>
    <template id="admin-quiz-comment-answer-template">
      <div>&nbsp;&nbsp; <span data-role="answer-id"></span> : <span data-role="correct"></span> : <span data-role="answer-text"></span></div>
    </template>
    <div id="admin-quiz-comment-detail-list">
      <template id="admin-quiz-comment-detail-template">
        <table width="100%" class="f-thai text-center table table-sm">
          <tr height="35" class="bg-light align-middle">
            <td width="35%" class="text-start">
              <span>By : <span data-role="name"></span></span>
            </td>
            <td width="35%" class="text-start">
              <span>Email : <span data-role="email"></span></span>
            </td>
            <td width="25%" class="text-start">
              <span>Date : <span data-role="date"></span></span>
            </td>
            <td width="5%" class="text-center"><span data-role="status"></span></td>
          </tr>
          <tr height="35" class="bg-light align-middle">
            <td width="100%" colspan="4">
              <span></span>
            </td>
          </tr>
          <tr height="10" class="bg-light align-middle">
            <td width="100%" colspan="4"></td>
          </tr>
          <tr height="15" class="align-middle">
            <td width="100%" colspan="4"></td>
          </tr>
        </table>
      </template>
    </div>
  </div>
</div>
