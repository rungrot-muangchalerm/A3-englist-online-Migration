<div class="main-academic" id="admin-extra-test-app" data-page-mode="<%= pageMode %>" data-test-id="<%= typeof testId !== 'undefined' ? testId : '' %>">
  <br><br>
  <div class="f-thai text-center">
    <br><br>
    <a href="/backoffice/mainoffice/admin/check-question-amount">[Check Question Amount]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/check-reason-index-details">[Check Reason Index and Details]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/check-questions-list">[Check Questions List]</a>&nbsp;&nbsp;
    <br><br>
    <a href="/backoffice/mainoffice/admin/extra-test-system">[Extra Test System]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/analyze-quiz">[Analyze Quiz]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/quiz-comment">[Quiz Comment]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/lessons-related">[Lessons & Related]</a>&nbsp;&nbsp;
    <br><br>
    <a href="/backoffice/mainoffice/admin/monthly-report">[Monthly Report]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/export-report-gepot-excel">[Export Report GEPOT Excel]</a>&nbsp;&nbsp;
    <a href="/backoffice/mainoffice/admin/export-report-gepot-pdf">[Export Report GEPOT PDF]</a>&nbsp;&nbsp;
    <br><br><br>
    <hr>
  </div>

  <div id="admin-extra-test-list-panel">
    <br><br>&nbsp;&nbsp; <span class="text-dark">Page : &nbsp;</span><span id="admin-extra-test-pages"></span><br>
    <br><br>
    <table width="100%" class="f-thai text-center bg-secondary text-white table table-sm">
      <tr height="65" class="align-middle">
        <td width="10%" class="text-center">
          <span class="text-white"><b>Extra ID</b></span>
        </td>
        <td width="30%" class="text-center">
          <span class="text-white"><b>Name</b></span>
        </td>
        <td width="10%" class="text-center">
          <span class="text-white"><b>Is Free</b></span>
        </td>
        <td width="10%" class="text-center">
          <span class="text-white"><b>Status</b></span>
        </td>
        <td width="10%" class="text-center">
          <span class="text-white"><b>Is EST</b></span>
        </td>
        <td width="10%" class="text-center">
          <span class="text-white"><b>Time(min)</b></span>
        </td>
        <td width="10%" class="text-center">
          <span class="text-white"><b>Quiz Amount</b></span>
        </td>
        <td width="10%" class="text-center">
          <span class="text-white"><b>&nbsp;</b></span>
        </td>
      </tr>
    </table>
    <div id="admin-extra-test-list">
      <template id="admin-extra-test-row-template">
        <table width="100%" class="f-thai text-center table-light table table-sm">
          <tr height="20" class="align-middle">
            <td width="10%" class="text-center">
              <span class="text-dark"></span>
            </td>
            <td width="30%" class="text-start"><a href="#" data-role="detail-link">
                <span class="text-primary"></span>
              </a></td>
            <td width="10%" class="text-center"><b data-role="free"></b></td>
            <td width="10%" class="text-center"><b data-role="active"></b></td>
            <td width="10%" class="text-center"><b data-role="est"></b></td>
            <td width="10%" class="text-center">
              <span class="text-dark"></span>
            </td>
            <td width="10%" class="text-center">
              <span class="text-dark"></span>
            </td>
            <td width="10%" class="text-center">
              <span class="text-danger"><b>Delete</b></span>
            </td>
          </tr>
        </table>
      </template>
    </div>
    <div id="admin-extra-test-empty" class="f-thai text-center"><br><br><br>
      <span class="text-danger"> - Can't Found Extra Test List - </span><br><br><br>
    </div>
    <br>
    <table width="50%" height="65" class="f-thai text-center bg-light table table-sm">
      <tr height="50" class="align-middle">
        <td class="text-end">
          <span><b>Name</b></span>
        </td>
        <td class="text-center">
          <span><b>&nbsp;:&nbsp;</b></span>
        </td>
        <td class="text-start"><input type="text" size="40" disabled></td>
        <td class="text-center"><input type="button" value="&nbsp;Add etest&nbsp;" class="btn-add" disabled></td>
      </tr>
    </table>
  </div>

  <div id="admin-extra-test-detail-panel">
    <br>
    <table width="100%" class="f-thai text-center bg-light table table-sm">
      <tr height="25" class="align-middle">
        <td class="text-start">&nbsp;&nbsp; <b><a href="/backoffice/mainoffice/admin/extra-test-system">
              <span>Extra Test List</span>
            </a>
            <span>&nbsp;&nbsp;&raquo;&nbsp;&nbsp;</span>
            <span></span>
          </b></td>
      </tr>
    </table>
    <br>
    <table width="100%" class="f-thai text-center bg-light table table-sm">
      <tr height="15" class="align-middle">
        <td></td>
      </tr>
      <tr height="25" class="align-middle">
        <td width="20%" class="text-end">
          <span><b> Extra Test ID </b></span>
        </td>
        <td class="text-center">
          <span><b> &nbsp;&nbsp;:&nbsp;&nbsp; </b></span>
        </td>
        <td width="20%" class="text-start">
          <span></span>
        </td>
        <td width="15%" class="text-end">
          <span><b> Name </b></span>
        </td>
        <td class="text-center">
          <span><b> &nbsp;&nbsp;:&nbsp;&nbsp; </b></span>
        </td>
        <td colspan="4" class="text-start"><input type="text" size="40" id="admin-extra-test-name-input" disabled></td>
      </tr>
      <tr height="25" class="align-middle">
        <td width="15%" class="text-end">
          <span><b> Time(Min) </b></span>
        </td>
        <td class="text-center">
          <span><b> &nbsp;&nbsp;:&nbsp;&nbsp; </b></span>
        </td>
        <td width="20%" class="text-start"><input type="number" size="4" id="admin-extra-test-time-input" disabled></td>
        <td width="15%" class="text-end">
          <span><b> Test Amount </b></span>
        </td>
        <td class="text-center">
          <span><b> &nbsp;&nbsp;:&nbsp;&nbsp; </b></span>
        </td>
        <td class="text-start"><input type="number" id="admin-extra-test-retest-input" size="4" disabled>
          <span> &nbsp; [100 = infinity & Open All Times] </span>
        </td>
        <td class="text-end">
          <span><b>Quiz Amount</b></span>
        </td>
        <td class="text-center">
          <span><b> : </b></span>
        </td>
        <td class="text-start">
          <span></span>
        </td>
      </tr>
      <tr height="25" class="align-middle">
        <td width="15%" class="text-end">
          <span><b> Start </b></span>
        </td>
        <td class="text-center">
          <span><b> &nbsp;&nbsp;:&nbsp;&nbsp; </b></span>
        </td>
        <td width="20%" class="text-start"><input type="datetime-local" size="20" id="admin-extra-test-start-input" disabled></td>
        <td width="15%" class="text-end">
          <span><b> Stop </b></span>
        </td>
        <td class="text-center">
          <span><b> &nbsp;&nbsp;:&nbsp;&nbsp; </b></span>
        </td>
        <td colspan="4" class="text-start"><input type="datetime-local" id="admin-extra-test-stop-input" size="20" disabled></td>
      </tr>
      <tr height="15" class="align-middle">
        <td></td>
      </tr>
    </table>
    <br>
    <div id="admin-extra-test-question-list">
      <template id="admin-extra-test-question-template">
        <table width="100%" class="f-thai text-center table table-sm">
          <tr>
            <td>
              <br>
              <table width="100%" class="f-thai text-center table table-sm">
                <tr class="text-center">
                  <td colspan="2" class="text-start">
                    <span class="text-warning">&nbsp;&nbsp;<span data-role="path"></span></span>
                  </td>
                </tr>
                <tr>
                  <td rowspan="3" width="11%" class="text-center">
                    <span data-role="question-id"></span>
                    <br><br><br>
                    <span class="text-danger"> [Cut Off] </span>
                    <br><br><b data-role="no"></b>
                  </td>
                  <td width="90%" class="text-start">
                    <span class="text-success">None Relate File or Passage</span>
                  </td>
                </tr>
                <tr>
                  <td width="100%" class="text-start bg-light">
                    <span></span>
                  </td>
                </tr>
                <tr>
                  <td width="90%" class="text-start"><br>
                    <div data-role="answers"></div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
        <br>
      </template>
      <template id="admin-extra-test-answer-template">
        <div>&nbsp;&nbsp; <span data-role="answer-id"></span> : <span data-role="correct"></span> : <span data-role="answer-text"></span></div>
      </template>
    </div>
  </div>
</div>
