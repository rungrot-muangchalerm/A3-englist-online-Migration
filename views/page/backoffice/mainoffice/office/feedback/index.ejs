<div class="main" data-list-url="<%= typeof listUrl !== 'undefined' ? listUrl : '/backoffice/mainoffice/office/activity-news/feedback' %>">
  <br><br>
  <a href="/backoffice/mainoffice/office/dashboard">
    <img src="/assets/2010/temp_images/temp/button/bt_to_main.png" title="Back to Main">
  </a>

  <table class="tb-feedback text-center table table-sm" width="90%">
    <tr height="50" class="align-middle">
      <td width="100%">
        <table class="menu-feedback text-end table table-sm">
          <tr height="25" class="align-middle">
            <td><a data-menu-link="1" href="<%= typeof listUrl !== 'undefined' ? listUrl : '/backoffice/mainoffice/office/activity-news/feedback' %>?menu=1&page=1">Organization List</a></td>
            <td>&nbsp;</td>
            <td><a data-menu-link="2" href="<%= typeof listUrl !== 'undefined' ? listUrl : '/backoffice/mainoffice/office/activity-news/feedback' %>?menu=2&page=1">Feedback List</a></td>
            <td>&nbsp;</td>
          </tr>
        </table>
      </td>
    </tr>
    <tr>
      <td>
        <table class="list-feedback text-center table table-sm" width="90%">
          <thead>
            <tr height="50" class="align-middle">
              <td width="15%" class="text-center">
                <span class="text-white"><b><span id="feedback-header-id"></span></b></span>
              </td>
              <td width="60%" class="text-center">
                <span class="text-white"><b><span id="feedback-header-text"></span></b></span>
              </td>
              <td width="25%" colspan="2" class="text-center">
                <span class="text-white"><b>Management</b></span>
              </td>
            </tr>
          </thead>
          <tbody id="feedback-list"></tbody>
        </table>
        <template id="feedback-row-template">
    <tr height="25" class="align-middle">
      <td width="14.7%" class="text-center">
        <span class="text-white"><b><span data-role="id"></span></b></span>
      </td>
      <td width="60%" class="topic-name text-start">
        <span><b>&nbsp;<span data-role="text"></span></b></span>
      </td>
      <td width="12.4%" class="text-center"><a href="#" data-role="toggle">
          <span><b><span data-role="active"></span></b></span>
        </a></td>
      <td width="12.4%" class="text-center"><a data-role="delete">
          <span class="text-danger"><b>Delete</b></span>
        </a></td>
    </tr>
    </template>
    <template id="feedback-empty-template">
      <tr height="25" class="align-middle">
        <td colspan="4" class="text-center">
          <span class="text-danger"><b> - Not Data - </b></span>
        </td>
      </tr>
    </template>
    <br>
    <table class="page-num text-center table table-sm" width="75%">
      <tr height="25" class="align-middle">
        <td class="text-start">
          <span class="text-white"><b>&nbsp;Page : &nbsp;<span id="feedback-pages"></span></b></span>
        </td>
      </tr>
    </table>
    </td>
    </tr>
    <tr>
      <td>
        <br>
        <form id="feedback-add-form">
          <table class="tb-add text-center table table-sm" width="90%">
            <tr>
              <td width="19%" class="text-end">
                <span class="text-white"><b><span id="feedback-field-label"></span></b></span>
              </td>
              <td class="text-center">
                <span class="text-white"><b>&nbsp;:&nbsp;</b></span>
              </td>
              <td width="62%" class="text-center"><textarea id="feedback-text" cols="50" rows="1" required></textarea></td>
              <td width="16%" class="text-start"><input class="btn-add" type="submit" id="feedback-add-button" value=""></td>
            </tr>
            <tr>
              <td colspan="4" class="text-center">
                <span class="text-danger"><b><span id="feedback-message"></span></b></span>
              </td>
            </tr>
          </table>
        </form>
      </td>
    </tr>
    <tr height="25" class="align-middle">
      <td width="100%"></td>
    </tr>
  </table>
</div>
