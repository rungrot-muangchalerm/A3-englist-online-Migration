<div class="main" data-type-id="<%= typeof typeId !== 'undefined' ? typeId : '' %>">
  <br><br>
  <table width="85%" class="text-start bg-light table table-sm">
    <tr height="30" class="align-middle">
      <td width="85%" class="text-start">
        &nbsp;<span><b>Welcome to Web Admin System :
            <span class="text-warning"><b><span id="office-admin-name"></span></b></span>
          </b></span>
      </td>
    </tr>
  </table>
  <br>

  <a href="/backoffice/mainoffice/office/dashboard">
    <img src="/assets/2010/temp_images/temp/button/bt_to_main.png" title="Back to Main">
  </a>

  <table class="list-topic text-center table table-sm" width="90%">
    <tr height="40" class="align-middle">
      <td class="text-center">
        <span><b><span id="office-topic-type-name"></span></b></span>
      </td>
    </tr>
  </table>

  <table class="list-page text-center table table-sm" width="90%">
    <tr height="40" class="align-middle">
      <td class="text-start">
        <span class="text-white"><b><br>&nbsp;&nbsp;Page : &nbsp;<span id="office-topic-pages">
              <template id="office-topic-page-template">
                <a data-role="page-link" href="#">
                  <span></span>
                </a>
              </template>
              <template id="office-topic-page-break-template">
                <br>
              </template>
            </span><br>&nbsp;</b></span>
      </td>
    </tr>
  </table>

  <table class="list-topic row-topic text-center table table-sm" width="90%">
    <thead id="office-topic-head"></thead>
    <tbody id="office-topic-list">
      <template id="office-topic-head-template">
        <tr height="25" class="align-middle">
          <td data-role="topic-id-head" width="10%" rowspan="2" class="text-center">
            <span><b> Topic ID </b></span>
          </td>
          <td data-role="topic-name-head" rowspan="2" class="text-center">
            <span><b> Topic Name </b></span>
          </td>
          <td data-role="management-head" class="text-center">
            <span><b> Management </b></span>
          </td>
        </tr>
        <tr height="25" class="align-middle">
          <td width="13.3%" class="text-center">
            <span class="text-white"><b>Display</b></span>
          </td>
          <td width="13.3%" class="text-center">
            <span class="text-white"><b>Edit</b></span>
          </td>
          <td data-role="delete-head" width="13.3%" class="text-center">
            <span class="text-white"><b>Delete</b></span>
          </td>
        </tr>
      </template>
      <template id="office-topic-row-template">
        <tr height="25" class="align-middle">
          <td width="10%" class="text-center"><b>
              <span class="text-white"><span data-role="topic-id"></span></span>
            </b></td>
          <td width="50%" class="text-start">
            <a class="topic-name" data-role="detail-link" href="#">
              <b>
                <span>&nbsp;[<span data-role="admin-name"></span>] &nbsp; <span data-role="topic-name"></span></span>
              </b>
            </a>
          </td>
          <td width="10%" class="text-center">
            <a href="#" data-role="toggle-link"><b>
                <span></span>
              </b></a>
          </td>
          <td width="10%" class="text-center">
            <a href="#" data-role="edit-link"><b>
                <span>Edit</span>
              </b></a>
          </td>
          <td data-role="delete-cell" width="10%" class="text-center">
            <a data-role="delete-link">
              <span class="text-danger"><b>Delete</b></span>
            </a>
          </td>
        </tr>
      </template>
      <template id="office-topic-empty-template">
        <tr height="25" class="align-middle">
          <td data-role="empty-cell" class="text-center">
            <span class="text-white"><b> - Didn't Find Data List - </b></span>
          </td>
        </tr>
      </template>
    </tbody>
  </table>

  <br>
  <table class="add-new-topic text-center table table-sm" width="90%">
    <tr height="25" class="align-middle">
      <td width="100%" class="text-center">
        <a id="office-topic-add-link" href="#">
          <span><b> Add New Topic </b></span>
        </a>
      </td>
    </tr>
  </table>
</div>