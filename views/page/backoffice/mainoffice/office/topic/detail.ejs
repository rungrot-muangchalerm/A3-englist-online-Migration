<div class="main" data-type-id="<%= typeof typeId !== 'undefined' ? typeId : '' %>" data-topic-id="<%= typeof topicId !== 'undefined' ? topicId : '' %>">
  <br><br>
  <table width="85%" class="text-start bg-light table table-sm">
    <tr height="30" class="align-middle">
      <td width="85%" class="text-start">
        &nbsp;<span><b>Welcome to Web Admin System :
            <span class="text-warning"><b><span id="office-admin-name"></span></b></span>
          </b></span>
      </td>
    </tr>
  </table>
  <br>

  <a id="office-topic-back-link" href="#">
    <img src="/assets/2010/temp_images/temp/button/bt_to_list.png" title="Back to List">
  </a>

  <table class="view_detail text-center table table-sm" width="90%">
    <tr height="30" class="align-middle">
      <td width="15%" class="text-center">&nbsp;<span class="text-warning"><b>Topic ID : <span id="office-topic-id"></span></b></span>
      </td>
      <td width="45%" class="text-start">&nbsp;<span class="text-warning"><b>Topic Name : <span id="office-topic-name"></span></b></span>
      </td>
      <td width="15%" class="text-center">&nbsp;<span class="text-warning"><b>Date : <span id="office-topic-date"></span></b></span>
      </td>
    </tr>
    <tr id="office-topic-headline-row" height="30" class="align-middle">
      <td width="15%" class="text-center">&nbsp;<span class="text-warning"><b>Headline : </b></span>
      </td>
      <td width="45%" colspan="2" class="text-start">&nbsp;<span class="text-warning"><b><span id="office-topic-headline"></span></b></span>
      </td>
    </tr>
    <tr height="30" class="align-middle">
      <td width="75%" colspan="3" class="text-center">&nbsp;<span class="text-warning"><b>Detail </b></span>
      </td>
    </tr>
    <tr height="30" class="align-middle">
      <td width="75%" colspan="3" class="text-start">&nbsp;<div id="office-topic-detail"></div>
      </td>
    </tr>
  </table>
</div>