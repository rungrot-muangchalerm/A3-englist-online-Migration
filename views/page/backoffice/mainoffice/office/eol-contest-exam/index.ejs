<div class="main" id="contest-exam-app" data-api-url="/api/backoffice/office/eol-contest-exams">
  <a href="/backoffice/mainoffice/office/dashboard">
    <img src="/assets/2010/temp_images/temp/button/bt_to_main.png" title="Back to Main">
  </a>

  <div id="contest-exam-wrap">
    <div>
      <a href="/backoffice/mainoffice/office/eol-contest-exam/exam?action=create_customize">
        <button id="add-custom-exam" class="bnt-etest setright"> + สร้างชุดข้อสอบแบบกำหนดเอง </button>
      </a>
      <a href="/backoffice/mainoffice/office/eol-contest-exam/exam?action=create">
        <button id="add-system-exam" class="bnt-etest setright"> + สร้างชุดข้อสอบจากระบบ</button>
      </a>
    </div>

    <div>
      <table class="exam table table-sm">
        <tr>
          <th width="48%">รายละเอียดชุดข้อสอบ</th>
          <th width="26%">ชื่อผู้สร้าง</th>
          <th width="13.5%">จำนวนข้อ</th>
          <th width="13%" class="text-start">เวลาสอบ</th>
          <th width="20%" class="text-start">สถานะการใช้งาน</th>
        </tr>
      </table>
    </div>

    <div id="examlist" class="nano">
      <div class="content">
        <table class="exam table table-sm">
          <tbody id="contest-exam-list"></tbody>
        </table>
      </div>
    </div>

    <div id="contest-exam-detail"></div>
    <div></div>
    <div class="text-center">
      <ul class="pagination" id="contest-exam-pages"></ul>
    </div>
    <div></div>
  </div>

  <template id="contest-exam-row-template">
    <tr>
      <td><a href="#" data-role="select"></a></td>
      <td data-role="creator"></td>
      <td><a href="#" title="View" data-role="amount"></a></td>
      <td data-role="time"></td>
      <td><b data-role="active"></b></td>
    </tr>
  </template>

  <template id="contest-exam-detail-template">
    <div id="detailexam">
      <form id="contest-exam-form">
        <table class="detailform table table-sm">
          <input type="hidden" name="exam_id" data-role="exam-id">
          <tr>
            <td>ชุดข้อสอบ </td>
            <td><input type="text" name="exam_name" data-role="exam-name" class="txtdetail"></td>
          </tr>
          <tr>
            <td>วันที่ </td>
            <td data-role="create-date"></td>
          </tr>
          <tr>
            <td>จำนวนข้อ </td>
            <td data-role="amount"></td>
          </tr>
          <tr>
            <td>เวลาสอบ </td>
            <td><input type="text" name="testtime" data-role="testtime" class="txtdetail" maxlength="3"> นาที</td>
          </tr>
          <tr>
            <td>รูปแบบการทดสอบ </td>
            <td>
              <input type="radio" name="test_type" value="1"> สอบเก็บคะแนน<br>
              <input type="radio" name="test_type" value="2"> การแข่งขัน
            </td>
          </tr>
          <tr>
            <td>เปิดใช้งาน </td>
            <td>
              <button type="button" class="legacy-toggle" data-role="active-toggle" aria-pressed="false">
                <span data-role="active-toggle-label">OFF</span>
              </button>
              <input type="checkbox" name="active" id="opt1" value="1" class="toggleswitch" data-role="active">
            </td>
          </tr>
        </table>
        เลือกกลุ่มที่สอบ
        <div id="listgroup_name" class="nano">
          <div class="content" data-role="groups"></div>
        </div>
        <input type="submit" name="save" id="save" class="bnt-etest setright" value="บันทึก">
      </form>
      <button id="edit-custom-exam" class="btn-edit setright">แก้ไขข้อสอบ</button>
      <button id="delete-contest-exam" class="bnt-delete setright" data-role="delete"> ลบชุดข้อสอบ</button>
      <div id="alert-error">
        <span class="text-danger"></span>
      </div>
    </div>
  </template>

  <template id="contest-empty-template">
    <tr>
      <td colspan="5">- Didn't Find Data List -</td>
    </tr>
  </template>
</div>
