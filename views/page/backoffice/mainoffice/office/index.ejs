  <% menuGroups.forEach(function(group) { %>
    <div class="card mb-4 shadow-sm" id="group-<%- group.id %>">
      <div class="card-header bg-dark text-white">
        <strong><%- group.title %></strong>
      </div>
      <div class="card-body">
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3">
          <% group.items.forEach(function(item) { %>
            <div class="col" id="menu-<%- item.id %>">
              <a href="<%- item.url %>" class="text-decoration-none">
                <div class="card h-100 border p-2 d-flex flex-column align-items-center justify-content-center text-center">
                  <img src="<%- item.icon %>" alt="<%- item.label %>" height="48" class="mb-2">
                  <span class="small fw-bold text-dark"><%- item.label %></span>
                </div>
              </a>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  <% }); %>
