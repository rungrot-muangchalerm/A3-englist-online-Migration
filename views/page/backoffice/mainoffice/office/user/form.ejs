<div class="main" data-mode="<%= mode %>" data-user-id="<%= userId || '' %>">
  <br><br>
  <table width="90%" class="text-center table table-sm">
    <tr height="50" class="align-middle">
      <td colspan="3" class="text-center">
        <span class="text-warning"><b><span id="office-user-form-title"></span></b></span>
      </td>
    </tr>
    <tr>
      <td>
        <form name="userForm" id="office-user-form" onsubmit="event.preventDefault();">
          <table width="90%" class="text-center table table-sm">
            <tr height="25" class="align-middle">
              <td width="20%" class="text-end">
                <span class="text-secondary"><b>Admin ID</b></span>
              </td>
              <td width="5%" class="text-center">
                <span class="text-secondary"><b>:</b></span>
              </td>
              <td width="80%" class="text-start">
                <span class="text-secondary"><b><span id="office-user-admin-id"></span></b></span>
              </td>
            </tr>
            <tr height="25" class="align-middle">
              <td class="text-end">
                <span class="text-secondary"><b>Prefix</b></span>
              </td>
              <td class="text-center">
                <span class="text-secondary"><b>:</b></span>
              </td>
              <td class="text-start"><input type="text" size="10" name="prefix" required></td>
            </tr>
            <tr height="25" class="align-middle">
              <td class="text-end">
                <span class="text-secondary"><b>Firstname</b></span>
              </td>
              <td class="text-center">
                <span class="text-secondary"><b>:</b></span>
              </td>
              <td class="text-start"><input type="text" size="20" name="fname" required></td>
            </tr>
            <tr height="25" class="align-middle">
              <td class="text-end">
                <span class="text-secondary"><b>Lastname</b></span>
              </td>
              <td class="text-center">
                <span class="text-secondary"><b>:</b></span>
              </td>
              <td class="text-start"><input type="text" size="20" name="lname" required></td>
            </tr>
            <tr height="25" class="align-middle">
              <td class="text-end">
                <span class="text-secondary"><b>Email</b></span>
              </td>
              <td class="text-center">
                <span class="text-secondary"><b>:</b></span>
              </td>
              <td class="text-start"><input type="text" size="30" name="email" required></td>
            </tr>
            <tr height="25" class="align-middle">
              <td class="text-end">
                <span class="text-secondary"><b>Nickname</b></span>
              </td>
              <td class="text-center">
                <span class="text-secondary"><b>:</b></span>
              </td>
              <td class="text-start"><input type="text" size="20" name="nickname" required></td>
            </tr>
            <tr height="25" class="align-middle">
              <td class="text-end">
                <span class="text-secondary"><b>Username</b></span>
              </td>
              <td class="text-center">
                <span class="text-secondary"><b>:</b></span>
              </td>
              <td id="office-user-username-cell" class="text-start"></td>
            </tr>
            <tr height="25" class="align-middle">
              <td class="text-end">
                <span class="text-secondary"><b>Password</b></span>
              </td>
              <td class="text-center">
                <span class="text-secondary"><b>:</b></span>
              </td>
              <td class="text-start"><input type="password" size="20" name="pass" required></td>
            </tr>
            <tr height="25" class="align-middle">
              <td class="text-end">
                <span class="text-secondary"><b>Active</b></span>
              </td>
              <td class="text-center">
                <span class="text-secondary"><b>:</b></span>
              </td>
              <td class="text-start"><input type="checkbox" name="is_active" value="1"> Active</td>
            </tr>
            <tr height="15" class="align-middle"></tr>
            <tr height="25" class="align-middle">
              <td width="80%" colspan="3" class="text-center"><br>
                <span class="text-dark"> >> List Permission << </span>
              </td>
            </tr>
            <tr>
              <td width="100%" colspan="3" class="text-start">
                <table class="list-permission text-center table table-sm" width="100%">
                  <tbody id="office-user-permissions"></tbody>
                </table>
              </td>
            </tr>
            <tr>
              <td colspan="3" class="text-center">
                <br><br>
                <div class="text-center">
                  <span><b>After Set New Permission Some Effect Is Activate After Next Login</b></span>
                </div><br><br>
                <div class="text-center"><input class="edit-personal" type="submit" id="office-user-submit" value=""></div>
                <div class="text-center">
                  <span class="text-danger"><b><span id="office-user-message"></span></b></span>
                </div>
              </td>
            </tr>
          </table>
        </form>
      </td>
    </tr>
  </table>

  <br>
  <div class="text-center">
    <a href="/backoffice/mainoffice/office/user">
      <span><b>&lt;&lt; Back to User List</b></span>
    </a>
  </div>
  <br><br>
</div>