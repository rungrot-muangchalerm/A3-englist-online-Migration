<div class="main" data-mode="<%= mode %>" data-user-id="<%= userId || '' %>">
  <br><br>
  <table align="center" width="90%" cellpadding="0" cellspacing="0" border="1" bordercolor="white">
    <tr height="50">
      <td align="center" colspan="3">
        <font size="3" face="tahoma" color="#ffff77"><b><span id="office-user-form-title"></span></b></font>
      </td>
    </tr>
    <tr>
      <td>
        <form name="userForm" id="office-user-form" onsubmit="event.preventDefault();" style="width:90%;">
          <table align="center" width="90%" cellpadding="0" cellspacing="0" border="0">
            <tr height="25">
              <td width="20%" align="right"><font size="2" face="tahoma" color="#cccccc"><b>Admin ID</b></font></td>
              <td width="5%" align="center"><font size="2" face="tahoma" color="#cccccc"><b>:</b></font></td>
              <td width="80%" align="left"><font size="2" face="tahoma" color="#cccccc"><b><span id="office-user-admin-id"></span></b></font></td>
            </tr>
            <tr height="25">
              <td align="right"><font size="2" face="tahoma" color="#cccccc"><b>Prefix</b></font></td>
              <td align="center"><font size="2" face="tahoma" color="#cccccc"><b>:</b></font></td>
              <td align="left"><input type="text" size="10" name="prefix" autocomplete="honorific-prefix" required></td>
            </tr>
            <tr height="25">
              <td align="right"><font size="2" face="tahoma" color="#cccccc"><b>Firstname</b></font></td>
              <td align="center"><font size="2" face="tahoma" color="#cccccc"><b>:</b></font></td>
              <td align="left"><input type="text" size="20" name="fname" autocomplete="given-name" required></td>
            </tr>
            <tr height="25">
              <td align="right"><font size="2" face="tahoma" color="#cccccc"><b>Lastname</b></font></td>
              <td align="center"><font size="2" face="tahoma" color="#cccccc"><b>:</b></font></td>
              <td align="left"><input type="text" size="20" name="lname" autocomplete="family-name" required></td>
            </tr>
            <tr height="25">
              <td align="right"><font size="2" face="tahoma" color="#cccccc"><b>Email</b></font></td>
              <td align="center"><font size="2" face="tahoma" color="#cccccc"><b>:</b></font></td>
              <td align="left"><input type="text" size="30" name="email" autocomplete="email" required></td>
            </tr>
            <tr height="25">
              <td align="right"><font size="2" face="tahoma" color="#cccccc"><b>Nickname</b></font></td>
              <td align="center"><font size="2" face="tahoma" color="#cccccc"><b>:</b></font></td>
              <td align="left"><input type="text" size="20" name="nickname" autocomplete="nickname" required></td>
            </tr>
            <tr height="25">
              <td align="right"><font size="2" face="tahoma" color="#cccccc"><b>Username</b></font></td>
              <td align="center"><font size="2" face="tahoma" color="#cccccc"><b>:</b></font></td>
              <td align="left" id="office-user-username-cell"></td>
            </tr>
            <tr height="25">
              <td align="right"><font size="2" face="tahoma" color="#cccccc"><b>Password</b></font></td>
              <td align="center"><font size="2" face="tahoma" color="#cccccc"><b>:</b></font></td>
              <td align="left"><input type="password" size="20" name="pass" autocomplete="new-password" required></td>
            </tr>
            <tr height="25">
              <td align="right"><font size="2" face="tahoma" color="#cccccc"><b>Active</b></font></td>
              <td align="center"><font size="2" face="tahoma" color="#cccccc"><b>:</b></font></td>
              <td align="left"><input type="checkbox" name="is_active" value="1"> Active</td>
            </tr>
            <tr height="15"></tr>
            <tr height="25">
              <td width="80%" align="center" colspan="3"><br>
                <font size="5" color="black"> >> List Permission << </font>
              </td>
            </tr>
            <tr>
              <td width="100%" align="left" colspan="3">
                <table class="list-permission" align="center" cellpadding="0" cellspacing="0" border="0" width="100%">
                  <tbody id="office-user-permissions"></tbody>
                </table>
              </td>
            </tr>
            <tr>
              <td align="center" colspan="3">
                <br><br>
                <div align="center"><font size="2" color="#77ff77" face="tahoma"><b>After Set New Permission Some Effect Is Activate After Next Login</b></font></div><br><br>
                <div align="center"><input class="edit-personal" type="submit" id="office-user-submit" value=""></div>
                <div align="center"><font size="2" color="red" face="tahoma"><b><span id="office-user-message"></span></b></font></div>
              </td>
            </tr>
          </table>
        </form>
      </td>
    </tr>
  </table>

  <br>
  <div align="center">
    <a href="/backoffice/mainoffice/office/user"><font size="2" face="tahoma"><b>&lt;&lt; Back to User List</b></font></a>
  </div>
  <br><br>
</div>
