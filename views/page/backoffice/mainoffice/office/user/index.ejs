<div class="main">
  <br><br>
  <table width="85%" class="text-start bg-light table table-sm">
    <tr height="30" class="align-middle">
      <td width="85%" class="text-start">
        &nbsp;<span><b>Welcome to Web Admin System :
            <span class="text-warning"><b><span id="office-user-current-admin"></span></b></span>
          </b></span>
      </td>
    </tr>
  </table>
  <br>

  <a href="/backoffice/mainoffice/office/dashboard">
    <img src="/assets/2010/temp_images/temp/button/bt_to_main.png" title="Back to Main">
  </a>

  <table class="head-list text-center bg-light table table-sm" width="90%">
    <tr height="25" class="align-middle">
      <td width="10%" rowspan="2" class="text-center">
        <span class="text-dark"><b>Admin ID</b></span>
      </td>
      <td width="60%" rowspan="2" class="text-center">
        <span class="text-dark"><b>Admin Name</b></span>
      </td>
      <td width="30%" colspan="3" class="text-center">
        <span class="text-dark"><b>Management</b></span>
      </td>
    </tr>
    <tr height="25" class="align-middle">
      <td width="10%" class="text-center">
        <span class="text-success"><b>Active</b></span>
      </td>
      <td width="10%" class="text-center">
        <span class="text-info"><b>Edit</b></span>
      </td>
      <td width="10%" class="text-center">
        <span class="text-danger"><b>Delete</b></span>
      </td>
    </tr>
  </table>

  <div id="office-user-list"></div>

  <template id="office-user-row-template">
    <table class="listuser office-user-list-table text-center table table-sm" width="90%">
      <tr height="25" class="align-middle">
        <td width="10%" class="text-center">
          <span class="text-dark"><b data-role="admin-id"></b></span>
        </td>
        <td width="60%" class="text-center">
          <table width="100%" class="text-center table table-sm">
            <tr>
              <td width="40%" class="text-start">
                <span class="text-dark"><b>&nbsp; <span data-role="name-left"></span></b></span>
              </td>
              <td width="35%" class="text-start">
                <span class="text-dark"><b>&nbsp; <span data-role="name-middle"></span></b></span>
              </td>
              <td width="25%" class="text-start">
                <span class="text-dark"><b><span data-role="nickname"></span> &nbsp;</b></span>
              </td>
            </tr>
          </table>
        </td>
        <td width="10%" data-role="active-cell" class="text-center"></td>
        <td width="10%" data-role="edit-cell" class="text-center"></td>
        <td width="10%" data-role="delete-cell" class="text-center"></td>
      </tr>
    </table>
  </template>

  <table class="tb-add-new-user text-center table table-sm" width="90%">
    <tr height="30" class="align-middle">
      <td colspan="5" class="text-center">
        <a href="/backoffice/mainoffice/office/user/add">
          <span><b>&nbsp; - Add New User - </b></span>
        </a>
      </td>
    </tr>
  </table>
