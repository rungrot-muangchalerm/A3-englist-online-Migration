<div class="container py-4">
  <div class="alert alert-light border mb-3">
    <span class="fw-bold">Welcome to Web Admin System :</span>
    <span class="text-warning fw-bold" id="office-user-current-admin"></span>
  </div>

  <div class="mb-3">
    <a href="/backoffice/mainoffice/office/dashboard" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left"></i> Back to Main
    </a>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
      <strong>Manage User</strong>
      <a href="/backoffice/mainoffice/office/user/add" class="btn btn-success btn-sm">
        <i class="bi bi-plus-lg"></i> Add New User
      </a>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-striped table-sm table-hover mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th class="text-center">Admin ID</th>
              <th class="text-center">Admin Name</th>
              <th class="text-center">Active</th>
              <th class="text-center">Edit</th>
              <th class="text-center">Delete</th>
            </tr>
          </thead>
          <tbody id="office-user-list"></tbody>
        </table>
      </div>
    </div>
  </div>

  <template id="office-user-row-template">
    <tr>
      <td class="text-center"><b data-role="admin-id"></b></td>
      <td>
        <div class="row g-0 text-center">
          <div class="col-4 text-start text-truncate"><span data-role="name-left"></span></div>
          <div class="col-4 text-start text-truncate"><span data-role="name-middle"></span></div>
          <div class="col-4 text-start text-truncate"><span data-role="nickname"></span></div>
        </div>
      </td>
      <td data-role="active-cell" class="text-center"></td>
      <td data-role="edit-cell" class="text-center"></td>
      <td data-role="delete-cell" class="text-center"></td>
    </tr>
  </template>
</div>
