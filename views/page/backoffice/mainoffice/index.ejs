<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h3 class="card-title h4 mb-1">Administrator Login Form</h3>
              <p class="text-muted mb-0">Enter your username and password to log on:</p>
              <p id="loginMsg" class="mb-0"></p>
            </div>
            <i class="bi bi-key fs-2 text-warning"></i>
          </div>
        </div>
        <div class="card-body">
          <form id="loginForm" onsubmit="event.preventDefault();">
            <div class="mb-3">
              <label class="visually-hidden" for="username">Username</label>
              <input type="text" id="username" name="username" placeholder="Username..." class="form-control" required>
            </div>
            <div class="mb-3">
              <label class="visually-hidden" for="password">Password</label>
              <input type="password" id="password" name="password" placeholder="Password..." class="form-control" required>
            </div>
            <div class="d-grid">
              <button type="button" class="btn btn-primary" id="office-login-btn">LOGIN</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>