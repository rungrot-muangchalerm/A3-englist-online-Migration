<style>
    .thumbnail_icon {
        display: inline-block;
        border: 0px solid orange;
        width: 110px;
        text-align: center;
        font-family: Kanit;
        height: 135px;
    }

    .modified_text {
        min-width: 100px;
        display: inline-block;
    }

    .icon_circle {
        border-radius: 50%;
        width: 64px;
        height: 64px;
        background: #565656;
    }

    .icon_circle.active {
        background: #f7941d;
    }

    .icon_circle:hover {
        transform: translateY(-2px);
        box-shadow: 3px 10px 20px rgba(0, 0, 0, .3);
    }

    .title_english_room {
        font-size: 13px;
        padding-top: 10px;
        color: black !important;
    }

    .title_english_room.active {
        color: #f7941d !important;
    }

    .title_english_room:hover {
        color: #f7941d !important;
    }

    .img_hover:hover {
        transform: translateY(-10px);
        box-shadow: 3px 10px 20px rgba(0, 0, 0, .3);
    }

    .img_hover {
        border-radius: 230px;
    }

    .over_a.alink:hover {
        color: black;
        font-weight: bold;
        font-size: 16px;
    }

    .over_b:hover {
        color: black;
    }

    .headline:hover {
        color: black;
        font-weight: bold;
        font-size: 15px;
    }

    .forum-pagination a {
        color: #9F3ED5;
        font-weight: bold;
        margin: 0 3px;
    }

    .forum-pagination b {
        margin: 0 3px;
    }
</style>

