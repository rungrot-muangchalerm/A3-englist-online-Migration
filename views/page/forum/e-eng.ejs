<template id="forum-empty-template">
  <tr>
    <td colspan="2" class="text-center">ไม่พบข้อมูล</td>
  </tr>
</template>

<template id="forum-topic-template">
  <tr>
    <td rowspan="3" class="text-center" style="width: 100px;">
      <div class="imgborder">
        <a class="topic-image-link" href="#" target="_blank">
          <img class="img_hover topic-image img-fluid" src="" alt="" style="max-width: 84px; max-height: 84px; object-fit: cover;" onerror="this.src='/assets/images/image2/logo/logo-02.ico'" />
        </a>
      </div>
    </td>
    <td class="text-center">
      <div class="alink1 text-start">
        <span><b>
            <a class="text-decoration-none alink topic-name-link" href="#" target="_blank">
              <span class="topic-name"></span>
            </a>
            <span class="new-badge"></span>
          </b>
        </span>
      </div>
    </td>
  </tr>
  <tr>
    <td class="text-center">
      <div class="alink text-start">
        <span class="text-dark"><b>
            <a class="over_b headline topic-headline-link" href="#" target="_blank">
              <span class="topic-headline"></span>
            </a>
          </b>
        </span>
      </div>
    </td>
  </tr>
  <tr>
    <td class="text-center">
      <div class="text-start">
        <span class="text-dark"><b>
            <div class="text-secondary">
              <div class="modified_text">
                <i class="bi bi-calendar-check"></i>&nbsp;<span class="topic-date"></span>
              </div>
              <div class="modified_text">
                <i class="bi bi-person-circle"></i>&nbsp;<span class="topic-author"></span>
              </div>
              <div class="modified_text">
                <i class="bi bi-eye"></i>&nbsp;View&nbsp;<span class="topic-view"></span>
              </div>
            </div>
          </b>
        </span>
      </div>
    </td>
  </tr>
  <tr>
    <td colspan="2" class="text-center">
      <hr class="my-2">
    </td>
  </tr>
</template>
