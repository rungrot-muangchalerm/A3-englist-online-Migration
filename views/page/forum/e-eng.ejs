<template id="forum-empty-template">
    <tr valign="top">
        <td align="center" colspan="2">ไม่พบข้อมูล</td>
    </tr>
</template>

<template id="forum-topic-template">
    <tr valign="top">
        <td width="15%" rowspan="3" align="center">
            <div class="imgborder">
                <a class="topic-image-link" href="#" target="_blank">
                    <img class="img_hover topic-image" src="" width="84" height="84" onerror="this.src='/assets/images/image2/logo/logo-02.ico'" />
                </a>
            </div>
        </td>
        <td width="85%" align="center">
            <div align="left" class="alink1">
                <font size="2" face="tahoma"><b>
                        <a class="over_a alink topic-name-link" href="#" target="_blank">
                            <span class="topic-name"></span>
                        </a>
                        <span class="new-badge"></span>
                    </b>
                </font>
            </div>
        </td>
    </tr>
    <tr valign="top">
        <td align="center" style="padding-right:5px;">
            <div align="left" class="alink">
                <font size="2" color="#3333" face="tahoma"><b>
                        <a class="over_b headline topic-headline-link" href="#" target="_blank">
                            <span class="topic-headline"></span>
                        </a>
                    </b>
                </font>
            </div>
        </td>
    </tr>
    <tr valign="top">
        <td align="center">
            <div align="left">
                <font size="2" color="#0000" face="tahoma"><b>
                        <div class="text-grey" style="font-size:14px !important;border:0px solid blue;margin:0px;">
                            <div class="modified_text" style="font-size:12px !important;margin:0px;">
                                <i class="fa fa-calendar-check-o"></i>&nbsp;<span class="topic-date"></span>
                            </div>
                            <div class="modified_text" style="font-size:12px !important;margin:0px;">
                                <i class="fa fa-user-circle-o"></i>&nbsp;<span class="topic-author"></span>
                            </div>
                            <div class="modified_text" style="font-size:12px !important;margin:0px;">
                                <i class="fa fa-eye"></i>&nbsp;View&nbsp;<span class="topic-view"></span>
                            </div>
                        </div>
                    </b>
                </font>
            </div>
        </td>
    </tr>
    <tr valign="top">
        <td height="1" colspan="2" align="center">
            <hr width="1000" align="right" style="margin-right:20px;color:black;" />
        </td>
    </tr>
</template>