<!-- School Category Template -->
<template id="school-category-template">
  <table align="center" class="tb-school" width="90%" cellpadding="0" cellspacing="0" border="0">
    <tr height="55">
      <td width="5%"></td>
      <td colspan="4"><font size="5" face="tahoma" color="black"><b class="school-category-title"></b></font></td>
    </tr>
    <tbody class="school-category-body"></tbody>
    <tr><td colspan="4">&nbsp;</td></tr>
  </table>
  <br>
</template>

<!-- School Row Template (2 items per row) -->
<template id="school-row-template">
  <tr height="35" align="middle" class="school-data-row">
    <td width="5%"></td>
    <td width="35%" align="left" class="school-name-1" style="white-space:pre-line;"></td>
    <td width="5%"></td>
    <td width="35%" align="left" class="school-name-2" style="white-space:pre-line;"></td>
  </tr>
  <tr valign="middle" height="10" class="school-spacer-row"><td></td></tr>
</template>

<!-- Feedback Row Template -->
<template id="feedback-row-template">
  <tr height="50" align="left" class="sub-tb-feedback">
    <td width="82%" class="feedback-detail" style="white-space:pre-line;"></td>
  </tr>
</template>

