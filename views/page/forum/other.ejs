<!-- School Category Template -->
<template id="school-category-template">
  <div class="table-responsive">
    <table class="tb-school text-center table table-sm align-middle">
      <thead>
        <tr class="align-middle">
          <th></th>
          <th colspan="4">
            <span class="text-dark"><b class="school-category-title"></b></span>
          </th>
        </tr>
      </thead>
      <tbody class="school-category-body"></tbody>
    </table>
  </div>
  <br>
</template>

<!-- School Row Template (2 items per row) -->
<template id="school-row-template">
  <tr class="school-data-row align-middle">
    <td style="width: 5%;"></td>
    <td class="school-name-1 text-start" style="width: 42.5%;"></td>
    <td style="width: 5%;"></td>
    <td class="school-name-2 text-start" style="width: 42.5%;"></td>
  </tr>
  <tr class="school-spacer-row align-middle">
    <td colspan="4">&nbsp;</td>
  </tr>
</template>

<!-- Feedback Row Template -->
<template id="feedback-row-template">
  <tr class="sub-tb-feedback align-middle">
    <td class="feedback-detail text-start"></td>
  </tr>
</template>

