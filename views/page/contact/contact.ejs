          <div class="card-body">
            <form id="contact-form" method="post" action="/api/contact/send" name="contact" enctype="multipart/form-data">
              <div class="row g-3 mb-3 align-items-center">
                <label class="col-12 col-md-4 col-form-label text-md-end" for="contact-name"><b>Name :</b></label>
                <div class="col-12 col-md-8">
                  <input class="form-control" type="text" name="name" id="contact-name" required>
                </div>
              </div>
