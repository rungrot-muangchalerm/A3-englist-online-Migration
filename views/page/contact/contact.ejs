                </div>
              </div>
              <div class="row g-3 mb-3 align-items-center">
                <label class="col-12 col-md-4 col-form-label text-md-end" for="contact-telephone"><b>Telephone :</b></label>
                <div class="col-12 col-md-8">
                  <input class="form-control" type="tel" name="telephone" id="contact-telephone" pattern="[0-9]{10}" required>
                </div>
              </div>
              <div class="row g-3 mb-3 align-items-start">
                <label class="col-12 col-md-4 col-form-label text-md-end" for="contact-detail"><b>Detail :</b></label>
                <div class="col-12 col-md-8">
                  <textarea class="form-control" name="detail" id="contact-detail" rows="4"></textarea>
