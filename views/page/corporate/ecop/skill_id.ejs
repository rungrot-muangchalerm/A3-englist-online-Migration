        </tr>
      </thead>
      <tbody id="eol-lessons-list-body">
        <tr>
          <td>
            <font size="2" face="tahoma" color="gray">Loading...</font>
          </td>
        </tr>
      </tbody>
    </table>
    <div class="back-wrap">
      <a href="/corporate/ecop">
        <img src="/assets/images/image2/eol system/ecop/btn_backsite.png">
      </a>
    </div>
  </div>

  <div id="eol-lessons-detail" class="lesson-list-wrap" style="display:none;">
