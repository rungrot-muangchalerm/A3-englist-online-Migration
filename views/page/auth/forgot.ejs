<div class="container shadow">
  <div class="row">
    <div class="col-12">
      <div class="text-center">
        <div class="">
          <h2><strong>ลืมรหัสผ่าน</strong></h2>
          <span>กรุณากรอก email address ที่ใช้สมัครสมาชิก</span>
          <hr />
        </div>
      </div>

      <div class="row">
        <div class="col-12" id="form-forgot">
          <form id="forgot-form" method="post" action="/api/auth/forgot">
            <div class="row">
              <div class="col-6 offset-3">
                <div class="row">
                  <div class="col-4">E-mail<b class="text-danger"> *</b></div>
                  <div class="col-8">
                    <input type="email" name="email" id="email" class="form-control" placeholder="email@example.com" required>
                  </div>
                </div>
              </div>
            </div>
            <div class="row">
              <div class="col-12 text-center">
                <div class="g-recaptcha" data-sitekey="<%= siteKey %>"></div>
              </div>
            </div>
            <div class="row">
              <div class="col-12 text-center">
                <br>
                <button type="submit" id="btn-forgot" class="btn btn-lg btn-info">Submit Email</button>
                <br><br>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://www.google.com/recaptcha/api.js" async defer></script>
